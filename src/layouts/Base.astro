---
import '../styles/app.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ALT_LANGS, homePath, t } from '../i18n/index.js';

// lang: page language. i18nPath: the EN-relative path this page is translated
// under (e.g. '/'), which switches on hreflang alternates + localized picker
// targets. Pages without i18nPath are EN-only — the picker then offers the
// localized home pages.
const { title, description = '', active = '', schema = null, lang = 'en', i18nPath = null } = Astro.props;
const site = Astro.site ?? 'https://ai-betting-tips.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const langHref = (l) => (i18nPath
  ? new URL(l === 'en' ? i18nPath : `/${l}${i18nPath}`, site).href
  : new URL(homePath(l), site).href);
const alternates = i18nPath ? ['en', ...ALT_LANGS].map((l) => ({ l, href: langHref(l) })) : [];

// sitewide BreadcrumbList derived from the URL (rendered as its own JSON-LD)
const segs = Astro.url.pathname.split('/').filter(Boolean);
const prettySeg = (s) => decodeURIComponent(s).replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const crumbSchema = segs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: String(site) },
        ...segs.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: prettySeg(s),
          item: new URL('/' + segs.slice(0, i + 1).join('/') + '/', site).href,
        })),
      ],
    }
  : null;
const favicon = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%2334d17a'/><stop offset='1' stop-color='%2318a95c'/></linearGradient></defs><rect width='32' height='32' rx='9' fill='url(%23g)'/><circle cx='16' cy='16' r='10' fill='white'/><path d='M16 11.9l3.2 2.3-1.2 3.7h-4l-1.2-3.7z' fill='%23092b18'/><g stroke='%23092b18' stroke-width='1.5' stroke-linecap='round'><path d='M16 11.9V8.2M19.2 14.2l3.5-1.2M18 17.9l2.2 3M14 17.9l-2.2 3M12.8 14.2l-3.5-1.2'/></g><circle cx='16' cy='16' r='10' stroke='%23092b18' stroke-width='1.6' fill='none'/></svg>";
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={langHref('en')} />}
  <!-- social preview -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href={favicon} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="AI Betting Tips" href="/rss.xml" />
  <script is:inline>
    // text-size preference: apply before paint (default "l" = slightly larger)
    try { document.documentElement.setAttribute('data-fz', localStorage.getItem('abt-fz') || 'l'); }
    catch (e) { document.documentElement.setAttribute('data-fz', 'l'); }
  </script>
  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6BCWRLQQ2Y"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6BCWRLQQ2Y');
    // affiliate outbound clicks (Get bonus / Claim): one delegated listener sitewide
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[rel~="sponsored"]');
      if (!a || typeof gtag !== 'function') return;
      gtag('event', 'affiliate_click', {
        link_url: a.getAttribute('href') || '',
        link_text: (a.textContent || '').trim().slice(0, 60),
        page_path: location.pathname
      });
    });
  </script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {crumbSchema && <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />}
</head>
<body>
  <div class="ai-note" role="note">{t(lang, 'top.aiNote')}</div>
  <Header active={active} lang={lang} i18nPath={i18nPath} />
  <slot />
  <Footer lang={lang} />

  <div class="mn-back" id="mnBack"></div>
  <nav class="mobile-nav" id="mobileNav">
    <div class="mn-top"><span class="logo"><span class="name">AI <em>Betting</em> Tips</span></span><span class="mn-close" id="mnClose">✕</span></div>
    <a href="/screener">🔍 AI Screener</a>
    <a href="/predictions">⚽ Predictions</a>
    <a href="/predictions/today">🏆 Today's Tips</a>
    <a href="/tools">🧮 Tools</a>
    <a href="/guides">📗 Guides</a>
    <a href="/bookmakers">🏛️ Betting Sites</a>
    <a href="/bonuses">🎁 Bonuses</a>
    <a href="/casinos">🎰 Casinos</a>
    <a href="/tipsters">📈 Results</a>
    <a href="/news">📰 News</a>
  </nav>

  <script src="/app.js" is:inline></script>
</body>
</html>
