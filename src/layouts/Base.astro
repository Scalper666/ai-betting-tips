---
import '../styles/app.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langsFor, homePath, t } from '../i18n/index.js';
import { SHOW_OPERATORS } from '../lib/operators.js';

// lang: page language. i18nPath: the EN-relative path this page is translated
// under (e.g. '/'), which switches on hreflang alternates + localized picker
// targets. Pages without i18nPath are EN-only — the picker then offers the
// localized home pages.
// `updated`: ISO date this page's content last changed. Data-driven pages pass
// the build time (odds refresh twice daily); editor-written pages pass the date
// their source file changed. It feeds dateModified in Article-type schema.
// `langs` overrides langsFor when a page family's language set depends on data
// rather than on the path alone (h2h: localized per league — see lib/h2h.js).
const { title, description = '', active = '', schema = null, lang = 'en', i18nPath = null, updated = null, langs = null } = Astro.props;
const site = Astro.site ?? 'https://ai-betting-tips.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const langHref = (l) => (i18nPath
  ? new URL(l === 'en' ? i18nPath : `/${l}${i18nPath}`, site).href
  : new URL(homePath(l), site).href);
// langsFor: match pages exist only in the full-parity languages — hreflang
// must never advertise a compact-language variant that would 404
const alternates = i18nPath ? (langs ?? langsFor(i18nPath)).map((l) => ({ l, href: langHref(l) })) : [];

// sitewide BreadcrumbList derived from the URL (rendered as its own JSON-LD)
const segs = Astro.url.pathname.split('/').filter(Boolean);
const prettySeg = (s) => decodeURIComponent(s).replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const crumbSchema = segs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: String(site) },
        ...segs.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: prettySeg(s),
          item: new URL('/' + segs.slice(0, i + 1).join('/') + '/', site).href,
        })),
      ],
    }
  : null;
// Stamp dateModified onto Article-family nodes that didn't set one themselves.
// Search engines surface these dates, and our data pages genuinely do change.
function withDates(node) {
  if (!node || typeof node !== 'object' || !updated) return node;
  if (Array.isArray(node)) return node.map(withDates);
  const ARTICLE = ['Article', 'NewsArticle', 'BlogPosting', 'TechArticle'];
  const out = { ...node };
  if (Array.isArray(out['@graph'])) out['@graph'] = out['@graph'].map(withDates);
  if (ARTICLE.includes(out['@type'])) {
    out.dateModified = out.dateModified ?? updated;
    out.datePublished = out.datePublished ?? updated;
  }
  return out;
}
const pageSchema = schema ? withDates(schema) : null;

// Publisher identity — emitted on home pages only, where brand queries land.
// No sameAs (we run no social profiles yet) and no SearchAction (no site
// search): claiming either would be a false signal.
const isHome = Astro.url.pathname.replace(/\/+$/, '') === '' ||
  langsFor('/').some((l) => Astro.url.pathname.replace(/\/+$/, '') === `/${l}`);
const orgSchema = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${site}#organization`,
          name: 'AI Betting Tips',
          url: String(site),
          logo: { '@type': 'ImageObject', url: new URL('/og.png', site).href, width: 1200, height: 630 },
          description: 'Football predictions from a published statistical model, with every settled pick and its closing line value on record.',
          knowsAbout: ['Football betting', 'Sports prediction models', 'Betting odds comparison'],
        },
        {
          '@type': 'WebSite',
          '@id': `${site}#website`,
          url: String(site),
          name: 'AI Betting Tips',
          inLanguage: lang,
          publisher: { '@id': `${site}#organization` },
        },
      ],
    }
  : null;
const favicon = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%2334d17a'/><stop offset='1' stop-color='%2318a95c'/></linearGradient></defs><rect width='32' height='32' rx='9' fill='url(%23g)'/><circle cx='16' cy='16' r='10' fill='white'/><path d='M16 11.9l3.2 2.3-1.2 3.7h-4l-1.2-3.7z' fill='%23092b18'/><g stroke='%23092b18' stroke-width='1.5' stroke-linecap='round'><path d='M16 11.9V8.2M19.2 14.2l3.5-1.2M18 17.9l2.2 3M14 17.9l-2.2 3M12.8 14.2l-3.5-1.2'/></g><circle cx='16' cy='16' r='10' stroke='%23092b18' stroke-width='1.6' fill='none'/></svg>";
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={langHref('en')} />}
  <!-- social preview -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href={favicon} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="AI Betting Tips" href="/rss.xml" />
  <script is:inline>
    // text-size preference: apply before paint (default "l" = slightly larger)
    try { document.documentElement.setAttribute('data-fz', localStorage.getItem('abt-fz') || 'l'); }
    catch (e) { document.documentElement.setAttribute('data-fz', 'l'); }
    // colour scheme too: app.js re-applies this later, but it loads after
    // paint — fine while every skin was dark, a white flashbang now that Day
    // exists. Same guard, same key as app.js.
    try {
      var s = localStorage.getItem('sharptips-skin');
      if (s && s !== 'azure') document.documentElement.setAttribute('data-skin', s);
    } catch (e) {}
    // disclaimer bar dismissed this session → hide before paint, no flash
    try {
      if (sessionStorage.getItem('abt-ainote') === 'off')
        document.documentElement.setAttribute('data-ainote', 'off');
    } catch (e) {}
  </script>
  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6BCWRLQQ2Y"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6BCWRLQQ2Y');
    // affiliate outbound clicks (Get bonus / Claim): one delegated listener sitewide
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[rel~="sponsored"]');
      if (!a || typeof gtag !== 'function') return;
      gtag('event', 'affiliate_click', {
        link_url: a.getAttribute('href') || '',
        link_text: (a.textContent || '').trim().slice(0, 60),
        page_path: location.pathname
      });
    });
  </script>
  {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
  {crumbSchema && <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />}
  {orgSchema && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
</head>
<body>
  <Header active={active} lang={lang} i18nPath={i18nPath} langs={langs} />
  <slot />
  <Footer lang={lang} />

  <!-- Legal note, pinned to the bottom edge and dismissible. Dismissal is
       session-scoped on purpose: one click hides it for the whole visit, a
       fresh visit shows it again — a warning that can be switched off forever
       stops being a warning. The permanent copy stays in the footer. -->
  <div class="ai-bar" id="aiBar" role="note">
    <span class="ai-bar-txt">{t(lang, 'top.aiNote')}</span>
    <button class="ai-bar-x" id="aiBarX" aria-label={t(lang, 'top.aiNoteClose')}>✕</button>
  </div>
  <script is:inline>
    (function () {
      var bar = document.getElementById('aiBar');
      if (!bar) return;
      document.getElementById('aiBarX').addEventListener('click', function () {
        try { sessionStorage.setItem('abt-ainote', 'off'); } catch (e) {}
        bar.remove();
      });
    })();
  </script>

  <div class="mn-back" id="mnBack"></div>
  <nav class="mobile-nav" id="mobileNav">
    <div class="mn-top"><span class="logo"><span class="name">AI <em>Betting</em> Tips</span></span><span class="mn-close" id="mnClose">✕</span></div>
    <a href="/screener">🔍 AI Screener</a>
    <a href="/predictions">⚽ Predictions</a>
    <a href="/predictions/today">🏆 Today's Tips</a>
    <a href="/tools">🧮 Tools</a>
    <a href="/guides">📗 Guides</a>
    {SHOW_OPERATORS && <a href="/bookmakers">🏛️ Betting Sites</a>}
    {SHOW_OPERATORS && <a href="/bonuses">🎁 Bonuses</a>}
    {SHOW_OPERATORS && <a href="/casinos">🎰 Casinos</a>}
    {!SHOW_OPERATORS && <a href="/countries">🌍 By Country</a>}
    <a href="/tipsters">📈 Results</a>
    <a href="/news">📰 News</a>
  </nav>

  <script src="/app.js" is:inline></script>
</body>
</html>
