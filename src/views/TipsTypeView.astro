---
import Base from '../layouts/Base.astro';
import Ox from '../components/Ox.astro';
import ToolsBox from '../components/ToolsBox.astro';
import PredCard from '../components/PredCard.astro';
import content from '../data/content.json';
import { slugify, faqSchema, signed, kickoffLabel, BUILD_ISO, fmtDate } from '../lib/utils.js';
import { t, lhref, localizeMarket } from '../i18n/index.js';
import { BET_TYPES } from '../lib/betTypes.js';
import { picksForType, recordForType, bttsRates, commonScores, outcomeSplit, accaLegs, bttsForecasts, scorelineForecasts } from '../lib/tipTypes.js';
import { BRACKETS } from '../lib/oddsAccas.js';
import { hasLeaguePage, hasComboPage } from '../lib/links.js';
import historyData from '../data/history.json';
import predictions from '../data/predictions.json';

// One page per bet type. Each shows what is genuinely true for its market: the
// model's live picks where it makes them, our settled record in that market,
// and base rates from the results dataset for markets we do NOT price (BTTS,
// correct score, double chance). Previously every type rendered the same six
// fixtures, which made these pages near-duplicates of each other.
const { type, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const F = (k, vars) => Object.entries(vars).reduce((str, [kk, v]) => str.split(`{${kk}}`).join(String(v)), T(k));
const tname = T(`btype.${type.slug}.name`);
const tlong = T(`btype.${type.slug}.long`);
const ai = (content.entries ?? {})[lang === 'en' ? `tips:${type.slug}` : `${lang}:tips:${type.slug}`];
const schema = ai?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(ai.faq) } : null;

// "ai accumulator tips" / "ai acca builder" are our top-clicked queries and the
// SERP is held by small dedicated landings — the EN accumulator page targets
// the exact phrase instead of the generic template title.
const enAcca = lang === 'en' && type.slug === 'accumulator';
const pageTitle = enAcca
  ? 'AI Accumulator Tips — Today’s Model Acca & Free Builder'
  : F('tt.title', { name: tname });
const pageDesc = enAcca
  ? 'Free AI accumulator tips: a daily acca built by our Poisson model from its highest-confidence picks, plus an AI acca builder, honest variance maths and our fully settled record.'
  : F('tt.desc', { name: tname.toLowerCase() });

const picks = picksForType(type.slug);
const record = recordForType(type.slug);
const legs = type.slug === 'accumulator' ? accaLegs(3) : [];
const accaOdds = legs.reduce((p, x) => p * (Number(x.recommendation?.price) || 1), 1);
const btts = type.slug === 'btts' ? bttsRates() : [];
const scores = type.slug === 'correct-score' ? commonScores() : null;
const split = type.slug === 'double-chance' ? outcomeSplit() : null;
// model estimates for markets we do not issue official picks in
const bttsFx = type.slug === 'btts' ? bttsForecasts() : [];
const scoreFx = type.slug === 'correct-score' ? scorelineForecasts() : [];

// per-league combo pages for this market (/tips/{type}/{league}): the type hub
// is their strongest natural parent, and until now it never linked them
const comboLeagues = [...new Set([
  ...(predictions.tips ?? []).map((x) => x.league),
  ...Object.values(historyData.tips ?? {}).map((x) => x.league),
])].filter((lg) => lg && hasComboPage(type.slug, lg)).sort();

// league chips: only leagues actually represented in what this page shows
const shown = picks.length ? picks : legs;
const leagues = [...new Set(shown.map((x) => x.league))].filter((lg) => hasLeaguePage(lg));
---
<Base lang={lang} i18nPath={`/tips/${type.slug}`}
  title={pageTitle}
  description={pageDesc}
  schema={schema}
  updated={BUILD_ISO}
  active="predictions">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href={L('/')}>{T('crumb.home')}</a><span>/</span><a href={L('/predictions')}>{T('nav.predictions')}</a><span>/</span>{tname}</div>
      <h1>{type.emoji} {enAcca ? 'AI Accumulator Tips' : tname}</h1>
      <p class="lead">{F('tt.lead', { name: tname.toLowerCase(), long: tlong })}</p>
      <p class="upd-line">{T('common.oddsUpdated')} {fmtDate(BUILD_ISO, lang)} · <a href="/editorial-policy">{T('common.howWeWrite')}</a></p>
      {comboLeagues.length > 0 && (
        <div class="chips" style="margin-top:10px">
          <span class="chip active">{F('tt.comboByLeague', { name: tname })}</span>
          {comboLeagues.map((lg) => (
            <a class="chip" href={L(`/tips/${type.slug}/${slugify(lg)}`)}>{lg}</a>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        {picks.length > 0 && (
          <section>
            {leagues.length > 0 && (
              <div class="chips">
                <span class="chip active">{T('tt.allLeagues')}</span>
                {leagues.map((lg) => <a class="chip" href={L(`/league/${slugify(lg)}`)}>🏆 {lg}</a>)}
              </div>
            )}
            <div class="pred-grid">
              {picks.map((tip) => <PredCard tip={tip} lang={lang} />)}
            </div>
          </section>
        )}

        {type.slug === 'accumulator' && legs.length >= 2 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">{T('tt.accaTitle')} <b>×<Ox v={accaOdds} /></b></h2>
              <a href="/tools/acca-builder" class="more-link">{T('tt.accaCta')} →</a>
            </div>
            <div class="acca">
              {legs.map((r) => (
                <div class="acca-leg">
                  <span class="acca-ic">{r.icon ?? '⚽'}</span>
                  <div class="acca-m">
                    <b>{r.home} — {r.away}</b>
                    <span>{r.league} · {kickoffLabel(r.kickoff, lang)}</span>
                  </div>
                  <span class="acca-pick">{localizeMarket(lang, r.recommendation?.text)}</span>
                  <span class="acca-odds"><Ox v={r.recommendation?.price} /></span>
                </div>
              ))}
              <div class="acca-foot">
                <span>{T('tt.accaNote')}</span>
                <a href="/tools/acca-builder" class="btn btn-mint btn-sm">{T('tt.accaCta')}</a>
              </div>
            </div>
            <p class="res-note">{T('tt.accaRisk')}</p>
            {enAcca && (
              <section class="seo" style="margin-top:18px">
                <div class="chips" style="margin-bottom:14px">
                  <span class="chip active">Daily slips by price</span>
                  {BRACKETS.map((b) => <a class="chip" href={`/tips/${b.slug}`}>{b.emoji} {b.name} daily</a>)}
                </div>
                <h2>How to use AI accumulator tips</h2>
                <ul>
                  <li><b>Keep the slip short — 2–4 legs.</b> Every leg multiplies the bookmaker's margin as well as the odds: three legs at a typical 5% margin already cost ~14% of fair value before kick-off.</li>
                  <li><b>Only combine positive-value legs.</b> An acca of coin-flips is entertainment; an acca where each leg beats its fair price is the only version with a positive expected value. Our builder starts from the model's highest-confidence picks, not the longest odds.</li>
                  <li><b>Avoid correlated legs.</b> Two picks from the same match — or a favourite plus "their striker scores" — are not independent, and books price that correlation against you.</li>
                  <li><b>Treat it as high variance by design.</b> Even a good 4-leg acca lands well under half the time; stake flat and small, and judge results over dozens of slips, not one weekend.</li>
                  <li><b>Check every price before placing.</b> Odds move twice a day here — a leg that drifted past the model's fair value no longer belongs on the slip.</li>
                </ul>
                <p>The daily acca above is built automatically from the model's picks and re-priced twice a day; the <a href="/tools/acca-builder">AI acca builder</a> lets you assemble your own from the full screener, with the honest hit-rate maths shown as you add legs. Every combined slip we publish settles publicly in <a href="/tipsters">our record</a> — losses included.</p>
              </section>
            )}
          </section>
        )}


        {bttsFx.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{T('tt.bttsFxTitle')}</h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">{T('mp.thMatch')}</th><th>xG</th><th>{T('tt.thBtts')}</th><th>{T('tt.thFair')}</th></tr></thead>
                <tbody>
                  {bttsFx.map((f) => (
                    <tr>
                      <td class="o-match" style="font-weight:700">
                        <a href={L(`/predictions/${f.slug}`)} style="color:inherit">{f.home} v {f.away}</a>
                        <span style="display:block;font-size:11px;color:var(--text-mute)">{f.league} · {kickoffLabel(f.kickoff, lang)}</span>
                      </td>
                      <td class="o-cell"><span>{f.xg}</span></td>
                      <td class="o-cell hot"><span class="cb">{f.pct}%</span></td>
                      <td class="o-cell"><span><Ox v={f.fair} /></span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">{T('tt.bttsFxNote')}</p>
          </section>
        )}

        {scoreFx.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{T('tt.scoreFxTitle')}</h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">{T('mp.thMatch')}</th><th>1</th><th>2</th><th>3</th></tr></thead>
                <tbody>
                  {scoreFx.map((f) => (
                    <tr>
                      <td class="o-match" style="font-weight:700">
                        <a href={L(`/predictions/${f.slug}`)} style="color:inherit">{f.home} v {f.away}</a>
                        <span style="display:block;font-size:11px;color:var(--text-mute)">{f.league} · {kickoffLabel(f.kickoff, lang)}</span>
                      </td>
                      {f.top.map((x, i) => (
                        <td class={`o-cell${i === 0 ? ' hot' : ''}`}>
                          <span class="cb">{x.score}</span>
                          <span style="display:block;font-size:10.5px;color:var(--text-mute)">{x.pct}% · {x.fair.toFixed(1)}</span>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">{T('tt.scoreFxNote')}</p>
          </section>
        )}

        {btts.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{T('tt.bttsTitle')}</h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">{T('tt.thLeague')}</th><th>{T('tt.thGames')}</th><th>{T('tt.thBtts')}</th></tr></thead>
                <tbody>
                  {btts.map((b) => (
                    <tr>
                      <td class="o-match" style="font-weight:700">
                        {hasLeaguePage(b.league)
                          ? <a href={L(`/league/${slugify(b.league)}`)} style="color:inherit">{b.league}</a>
                          : b.league}
                      </td>
                      <td class="o-cell"><span>{b.n}</span></td>
                      <td class="o-cell hot"><span class="cb">{b.pct}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">{T('tt.bttsNote')}</p>
          </section>
        )}

        {scores && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{T('tt.scoresTitle')}</h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th>{T('tt.thScore')}</th><th>{T('tt.thGames')}</th><th>{T('tt.thShare')}</th><th>{T('tt.thFair')}</th></tr></thead>
                <tbody>
                  {scores.rows.map((s) => (
                    <tr>
                      <td class="o-cell" style="font-weight:700"><span>{s.score}</span></td>
                      <td class="o-cell"><span>{s.n}</span></td>
                      <td class="o-cell"><span>{s.pct}%</span></td>
                      <td class="o-cell hot"><span class="cb"><Ox v={s.fair} /></span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">{F('tt.scoresNote', { n: scores.total })}</p>
          </section>
        )}

        {split && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{T('tt.dcTitle')}</h2></div>
            <div class="res-sum">
              <div class="res-chip win"><b>{split.home}%</b><span>{T('tt.dcHome')}</span></div>
              <div class="res-chip"><b>{split.draw}%</b><span>{T('tt.dcDraw')}</span></div>
              <div class="res-chip lose"><b>{split.away}%</b><span>{T('tt.dcAway')}</span></div>
            </div>
            <div class="res-sum" style="margin-top:10px">
              <div class="res-chip"><b>{split.homeOrDraw}%</b><span>1X</span></div>
              <div class="res-chip"><b>{split.homeOrAway}%</b><span>12</span></div>
              <div class="res-chip"><b>{split.awayOrDraw}%</b><span>X2</span></div>
            </div>
            <p class="res-note">{F('tt.dcNote', { n: split.n })}</p>
          </section>
        )}

        {record && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">{F('tt.recordTitle', { name: tname })}</h2>
              <a href={L('/tipsters')} class="more-link">{T('home.res.stats')}</a>
            </div>
            <div class="res-sum">
              <div class="res-chip"><b>{record.n}</b><span>{T('home.res.settled')}</span></div>
              <div class="res-chip win"><b>{record.won}</b><span>{T('home.res.won')}</span></div>
              <div class="res-chip lose"><b>{record.lost}</b><span>{T('home.res.lost')}</span></div>
              {record.winRate !== null && <div class="res-chip"><b>{record.winRate}%</b><span>{T('tt.winRate')}</span></div>}
              <div class={`res-chip ${record.profit >= 0 ? 'win' : 'lose'}`}><b>{signed(record.profit)}u</b><span>{T('home.res.profit')}</span></div>
              {record.roi !== null && <div class={`res-chip ${record.roi >= 0 ? 'win' : 'lose'}`}><b>{signed(record.roi)}%</b><span>ROI</span></div>}
            </div>
            <p class="res-note">{T('tt.recordNote')}{record.early ? ` ${T('tt.earlySample')}` : ''}</p>
          </section>
        )}

        {picks.length === 0 && legs.length === 0 && (
          <section>
            <div class="box"><div class="box-pad dim">{F('tt.noPicks', { name: tname.toLowerCase() })}</div></div>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">{tname} <b>FAQ</b></h2></div>
          <div class="faq">
            <div class="faq-item open">
              <div class="faq-q">{F('tt.q1', { name: tname.toLowerCase() })}<span class="pm">+</span></div>
              <div class="faq-a"><p>{F('tt.a1', { long: tlong })}</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">{T('tt.q2')}<span class="pm">+</span></div>
              <div class="faq-a"><p>{T('tt.a2')}</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">{T('tt.q3')}<span class="pm">+</span></div>
              <div class="faq-a"><p>{T('tt.a3')}</p></div>
            </div>
            {(ai?.faq ?? []).map((f) => (
              <div class="faq-item">
                <div class="faq-q">{f.q}<span class="pm">+</span></div>
                <div class="faq-a"><p>{f.a}</p></div>
              </div>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>{F('tt.explained', { name: tname })}</h2>
          <div class="clamp" id="seoClamp">
            {ai ? (
              <>
                <p>{ai.intro}</p>
                <h3 style="margin:18px 0 8px">{T('tt.how')}</h3>
                <p>{ai.how_it_works}</p>
                <h3 style="margin:18px 0 8px">{T('tt.strategy')}</h3>
                <p>{ai.strategy}</p>
              </>
            ) : (
              <>
                <p>{F('tt.fb1', { name: tname.toLowerCase() })}</p>
                <p>{T('tt.fb2')}</p>
              </>
            )}
          </div>
          <span class="read-more" data-clamp-toggle="seoClamp">{T('home.seo.more')}</span>
        </section>
      </main>

      <aside class="sidebar">
        {type.slug === 'accumulator' ? (
          <div class="promo">
            <h4>🤖 {T('tt.accaCta')}</h4>
            <p>{T('tt.accaPromo')}</p>
            <a href="/tools/acca-builder" class="btn btn-mint btn-block">{T('gd.open')}</a>
          </div>
        ) : (
          <div class="promo">
            <h4>🔍 {T('nav.screener')}</h4>
            <p>{T('tt.promoP')}</p>
            <a href={L('/screener')} class="btn btn-mint btn-block">{T('tt.openScr')}</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> {T('tt.moreTypes')}</div>
          {BET_TYPES.filter((bt) => bt.slug !== type.slug).map((bt) => (
            <a class="tm" href={L(`/tips/${bt.slug}`)}><span class="dot"></span>{bt.emoji} {T(`btype.${bt.slug}.name`)}</a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">📗</span> {T('gd.putToWork')}</div>
          <a class="tm" href={L('/guides')}><span class="dot"></span>{T('ft.guides')}</a>
          <a class="tm" href={L('/glossary')}><span class="dot"></span>{T('gd.lnkGlossary')}</a>
          <a class="tm" href="/model"><span class="dot"></span>{T('ft.ourModel')}</a>
          <a class="tm" href={L('/tipsters')}><span class="dot"></span>{T('nav.performance')}</a>
        </div>
        <ToolsBox lang={lang} />
      </aside>
    </div>
  </div>
</Base>
