---
// Also generated from bookmakers.json — the `app` field on each operator.
import Base from '../layouts/Base.astro';
import { t, localizeMarket, trLabel } from '../i18n/index.js';
import content from '../data/content.json';
import AiFaq from '../components/AiFaq.astro';
import data from '../data/bookmakers.json';
import { avgScore, faqSchema } from '../lib/utils.js';

const { lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);

const apps = (data.bookmakers ?? [])
  .filter((bk) => bk.app && (bk.app.android || bk.app.ios))
  .sort((a, b) => (b.app.rating ?? 0) - (a.app.rating ?? 0));
const year = new Date().getFullYear();

const aiPage = (content.entries ?? {})['page:betting-apps'];
const pageSchema = aiPage?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(aiPage.faq) } : null;
---
<Base schema={pageSchema} lang={lang} i18nPath="/betting-apps"
  title={T('app.title').replace('{year}', String(year))}
  description={T('app.desc')}
  active="bookmakers">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">{T('crumb.home')}</a><span>/</span><a href="/bookmakers">{T('nav.sites')}</a><span>/</span>{T('app.crumb')}</div>
      <h1>{T('app.h1pre')} <em>{T('app.h1em')}</em></h1>
      <p class="lead">{T('app.lead')}</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <thead><tr>
                <th style="text-align:left">{T('app.thApp')}</th><th>{T('app.thPlatforms')}</th><th>{T('app.thSize')}</th>
                <th>{T('app.thStreaming')}</th><th>{T('app.thScore')}</th><th>{T('app.thGet')}</th>
              </tr></thead>
              <tbody>
                {apps.map((bk) => (
                  <tr>
                    <td class="o-match" style="font-weight:700">
                      <a href={`/bookmakers/${bk.slug}`} style="color:inherit">{bk.name}</a>
                      {bk.placeholder && <span class="tc" style="display:block;color:var(--danger)">{T('app.demoEntry')}</span>}
                    </td>
                    <td class="o-cell"><span class="cb">{[bk.app.android && '🤖 Android', bk.app.ios && '🍏 iOS'].filter(Boolean).join(' · ')}</span></td>
                    <td class="o-cell"><span class="cb">{bk.app.size_mb} MB</span></td>
                    <td class="o-cell"><span class="cb">{bk.app.streaming ? T('app.yes') : '—'}</span></td>
                    <td class="o-cell hot"><span class="cb">{bk.app.rating}</span></td>
                    <td><a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">{T('app.download')}</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div></div>
        </section>

        <section class="seo">
          <h2>{T('app.vsH')}</h2>
          <p>{T('app.vsP')}</p>
        </section>
        {lang === 'en' && aiPage?.intro && (
          <section class="seo">
            <h2>About betting apps</h2>
            <p>{aiPage.intro}</p>
          </section>
        )}
        {lang === 'en' && <AiFaq faqs={aiPage?.faq ?? []} title="Betting apps FAQ" />}
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📱</span> {T('app.reviews')}</div>
          {apps.map((bk) => (
            <a class="tm" href={`/bookmakers/${bk.slug}`}><span class="dot"></span>{T('app.review').replace('{name}', bk.name)}</a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>
