---
import Base from '../layouts/Base.astro';
import PredCard from '../components/PredCard.astro';
import predictions from '../data/predictions.json';
import content from '../data/content.json';
import { slugify, faqSchema } from '../lib/utils.js';
import { t, lhref } from '../i18n/index.js';
import AiFaq from '../components/AiFaq.astro';

const { league, tips, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const F = (k, vars) => Object.entries(vars).reduce((str, [kk, v]) => str.split(`{${kk}}`).join(String(v)), T(k));
const trx = lang === 'en' ? null : ((content.entries ?? {})[`${lang}:league:${slugify(league)}`] ?? null);
const ai = trx ?? (content.entries ?? {})[`league:${slugify(league)}`];
const schema = ai?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(ai.faq) } : null;
const title = F('lg.title', { league });
const description = F('lg.desc', { league });
---
<Base lang={lang} i18nPath={`/league/${slugify(league)}`} title={title} description={description} schema={schema} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href={L('/')}>{T('crumb.home')}</a><span>/</span><a href={L('/predictions')}>{T('nav.predictions')}</a><span>/</span>{league}
      </div>
      <h1>{league} <em>{T('lg.predEm')}</em></h1>
      <p class="lead">{F('lg.lead', { n: tips.length })}</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="pred-grid">
            {tips.map((tip) => <PredCard tip={tip} lang={lang} />)}
          </div>
        </section>

        <section class="seo">
          <h2>{F('lg.tipsH', { league })}</h2>
          {ai ? (
            <>
              <p>{ai.intro}</p>
              <h3 style="margin:18px 0 8px">{F('lg.howH', { league })}</h3>
              <p>{ai.betting_guide}</p>
            </>
          ) : (
            <p>{F('lg.fallback', { league })}</p>
          )}
        </section>
        <AiFaq faqs={ai?.faq ?? []} title={`${league} FAQ`} />
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> {T('lg.allFixtures')}</div>
          {tips.map((t) => (
            <a class="tm" href={`/predictions/${slugify(`${t.home}-vs-${t.away}`)}`}>
              <span class="dot"></span>{t.home} v {t.away}
            </a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🎯</span> {F('lg.markets', { league })}</div>
          <a class="tm" href={L(`/tips/match-result/${slugify(league)}`)}><span class="dot"></span>{T('lg.mrTips')}</a>
          <a class="tm" href={L(`/tips/over-under/${slugify(league)}`)}><span class="dot"></span>{T('lg.ouTips')}</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
