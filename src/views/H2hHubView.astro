---
import Base from '../layouts/Base.astro';
import ToolsBox from '../components/ToolsBox.astro';
import { buildH2hPairs } from '../lib/h2h.js';
import { slugify, BUILD_ISO, fmtDate } from '../lib/utils.js';
import { t, lhref } from '../i18n/index.js';

// H2H directory: competitions + a few headline fixtures each (full lists live
// on /h2h/league/{slug}). Localized wave 2 (hh.* keys).
const { lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const F = (k, vars) => Object.entries(vars).reduce((str, [kk, v]) => str.split(`{${kk}}`).join(String(v)), T(k));

const pairs = buildH2hPairs();
const byLeague = {};
for (const p of pairs) (byLeague[p.league] ??= []).push(p);

const leagues = Object.entries(byLeague)
  .map(([name, list]) => ({
    name,
    n: list.length,
    meetings: list.reduce((a, p) => a + p.stats.n, 0),
    top: [...list].sort((a, b) => b.stats.n - a.stats.n).slice(0, 5),
  }))
  .sort((a, b) => b.n - a.n);

const totalMeetings = pairs.reduce((a, p) => a + p.stats.n, 0);

const title = T('hh.hubTitle');
const description = F('hh.hubDesc', { pairs: pairs.length, leagues: leagues.length });

const urlPrefix = lang === 'en' ? '' : '/' + lang;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Head-to-head records by league',
  numberOfItems: leagues.length,
  itemListElement: leagues.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${l.name} head-to-head records`,
    url: `https://ai-betting-tips.com${urlPrefix}/h2h/league/${slugify(l.name)}/`,
  })),
};
---
<Base lang={lang} i18nPath="/h2h" title={title} description={description} schema={schema} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href={L('/')}>{T('crumb.home')}</a><span>/</span>{T('hh.crumb')}</div>
      <h1>{T('hh.hubH1pre')} <em>{T('hh.hubH1em')}</em></h1>
      <p class="lead">{F('hh.hubLead', { pairs: pairs.length, leagues: leagues.length, meetings: totalMeetings })}</p>
      <p class="upd-line">{T('hh.refreshed')} {fmtDate(BUILD_ISO, lang)} · <a href="/editorial-policy">{T('common.howWeWrite')}</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">{T('hh.browsePre')} <b>{T('hh.browseBold')}</b></h2>
            <a href={L('/predictions')} class="more-link">{T('hh.todayTips')} →</a>
          </div>
          <div class="bt-grid">
            {leagues.map((l) => (
              <a href={L(`/h2h/league/${slugify(l.name)}`)} class="bt-tile">
                <div class="ic">⚔️</div>
                <div>
                  <h4>{l.name}</h4>
                  <p>{F('hh.pairingsMeta', { n: l.n, m: l.meetings })}</p>
                </div>
                <span class="arr">→</span>
              </a>
            ))}
          </div>
        </section>

        {leagues.slice(0, 6).map((l) => (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">{l.name} <b>{T('hh.mpBold')}</b></h2>
              <a href={L(`/h2h/league/${slugify(l.name)}`)} class="more-link">{F('hh.allN', { n: l.n })}</a>
            </div>
            <div class="team-grid">
              {l.top.map((p) => (
                <a class="tm" href={L(`/h2h/${p.slug}`)}>
                  <span class="dot"></span>{p.teamA} v {p.teamB}
                  <span class="cnt">{p.stats.n}</span>
                </a>
              ))}
            </div>
          </section>
        ))}

        <section class="seo">
          <h2>{T('hh.whatForH')}</h2>
          <p>{T('hh.whatFor1')}</p>
          <p>{T('hh.whatFor2')}</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">⚔️</span> {T('hh.byLeague')}</div>
          {leagues.map((l) => (
            <a class="tm" href={L(`/h2h/league/${slugify(l.name)}`)}>
              <span class="dot"></span>{l.name}<span class="cnt">{l.n}</span>
            </a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> {T('hh.livePages')}</div>
          <a class="tm" href={L('/screener')}><span class="dot"></span>{T('nav.screener')}</a>
          <a class="tm" href={L('/table')}><span class="dot"></span>{T('ft.tables')}</a>
          <a class="tm" href={L('/teams')}><span class="dot"></span>{T('ft.teamsAZ')}</a>
          <a class="tm" href={L('/seasons')}><span class="dot"></span>{T('ft.seasons')}</a>
        </div>
        <ToolsBox lang={lang} />
      </aside>
    </div>
  </div>
</Base>
