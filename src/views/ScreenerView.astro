---
import Base from '../layouts/Base.astro';
import { t, localizeMarket, trLabel } from '../i18n/index.js';
import content from '../data/content.json';
import AiFaq from '../components/AiFaq.astro';
import screener from '../data/screener.json';
import { kickoffLabel, faqSchema } from '../lib/utils.js';

const { lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);

const rows = [...(screener.rows ?? [])].sort((a, b) => b.score - a.score);
const sports = [...new Set(rows.map((r) => r.sport))].sort();
const leagues = [...new Set(rows.map((r) => r.league))].sort();
// score >= 45 means the pick has a positive edge (see pipeline ai_score) — green zone
const scoreCls = (s) => (s >= 45 ? 's-hi' : s >= 30 ? 's-md' : 's-lo');
const steamHtml = { up: ['scr-steam up', 'scr.steamUp'], down: ['scr-steam down', 'scr.steamDown'], flat: ['scr-steam flat', 'scr.steamFlat'] };

const aiPage = (content.entries ?? {})[lang === 'en' ? 'page:screener' : `${lang}:page:screener`];
const pageSchema = aiPage?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(aiPage.faq) } : null;
---
<Base schema={pageSchema} lang={lang} i18nPath="/screener"
  title={T('scr.title')}
  description={T('scr.desc')}
  active="predictions">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">{T('crumb.home')}</a><span>/</span><a href="/predictions">{T('nav.predictions')}</a><span>/</span>{T('nav.screener')}</div>
      <h1>{T('scr.h1pre')} <em>{T('scr.h1em')}</em></h1>
      <p class="lead">{T('scr.lead')}</p>
    </div>
  </div>

  <div class="container" style="padding-bottom:60px">

    <div class="scr-head">
      <div class="scr-meta">
        <span class="live"><span class="dot"></span>{T('scr.live')}</span>
        <span>{T('scr.updated')} <b id="scrUpdated" data-updated={screener.updated_at}>—</b></span>
        <span class="scr-count"><b id="scrCount">{rows.length}</b> {T('scr.valueBets')}</span>
      </div>
      <a href="/predictions" class="more-link">{T('scr.detailed')}</a>
    </div>

    <div class="scr-filters" id="scrFilters">
      <select id="fSport"><option value="">{T('scr.allSports')}</option>{sports.map((s) => <option>{s}</option>)}</select>
      <select id="fLeague"><option value="">{T('scr.allLeagues')}</option>{leagues.map((l) => <option>{l}</option>)}</select>
      <select id="fType">
        <option value="">{T('scr.allMarkets')}</option>
        <option value="Match result">{T('scr.mMatch')}</option><option value="Totals">{T('scr.mTotals')}</option><option value="BTTS">BTTS</option><option value="Handicap">{T('scr.mHandicap')}</option><option value="Other">{T('scr.mOther')}</option>
      </select>
      <label class="scr-rng">Edge ≥ <input type="range" id="fEdge" min="0" max="12" step="0.5" value="0" /><output id="fEdgeV">0%</output></label>
      <label class="scr-rng">Conf ≥ <input type="range" id="fConf" min="0" max="90" step="5" value="0" /><output id="fConfV">0%</output></label>
      <input type="search" id="fSearch" placeholder={T('scr.search')} />
      <span class="scr-reset" id="fReset">{T('scr.reset')}</span>
    </div>

    <div class="scr-table-wrap">
      <div class="scr-scroll">
        <table class="scr-table">
          <thead><tr>
            <th class="num sort sorted" data-key="score">{T('scr.thScore')} <span class="ar">▾</span></th>
            <th class="sort" data-key="match">{T('home.scr.match')} <span class="ar">▾</span></th>
            <th>{T('card.ourTip')}</th>
            <th class="num sort" data-key="odds">{T('card.odds')} <span class="ar">▾</span></th>
            <th class="num sort" data-key="edge">{T('home.scr.edge')} <span class="ar">▾</span></th>
            <th class="num sort" data-key="conf">{T('scr.thConf')} <span class="ar">▾</span></th>
            <th>{T('scr.thSignal')}</th>
            <th class="sort" data-key="kickoff">{T('scr.thKickoff')} <span class="ar">▾</span></th>
            <th></th>
          </tr></thead>
          <tbody id="scrBody">
            {rows.map((r) => (
              <tr
                data-sport={r.sport} data-league={r.league} data-type={r.type}
                data-score={r.score} data-odds={r.odds} data-edge={r.edge} data-conf={r.confidence}
                data-kickoff={r.kickoff ?? ''} data-search={`${r.home} ${r.away} ${r.league}`.toLowerCase()}>
                <td class="num"><span class={`score-badge ${scoreCls(r.score)}`}>{r.score}</span></td>
                <td><div class="scr-match"><span class="ic">{r.icon}</span><div class="mt"><b>{r.home} v {r.away}</b><span class="lg">{r.league}</span></div></div></td>
                <td class="scr-tip">{localizeMarket(lang, r.market)}</td>
                <td class="num scr-odds">{Number(r.odds).toFixed(2)}</td>
                <td class={`num edge ${r.edge > 0 ? 'pos' : 'neg'}`}>{r.edge > 0 ? '+' : ''}{r.edge}%</td>
                <td class="num">{r.confidence}%</td>
                <td><span class={(steamHtml[r.steam] ?? steamHtml.flat)[0]}>{T((steamHtml[r.steam] ?? steamHtml.flat)[1])}</span></td>
                <td class="scr-when">{kickoffLabel(r.kickoff, lang)}</td>
                <td><a href="#" class="btn btn-mint btn-sm">{T('scr.bet')}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="scr-empty" id="scrEmpty" style="display:none">{T('scr.empty')}</div>

    <section class="seo" style="margin-top:34px">
      <h2>{T('scr.seoH')}</h2>
      <div class="clamp" id="seoClamp">
        <p>{T('scr.seoP1')}</p>
        <p>{T('scr.seoP2')}</p>
      </div>
      <span class="read-more" data-clamp-toggle="seoClamp">{T('home.seo.more')}</span>
    </section>
    <AiFaq faqs={aiPage?.faq ?? []} title={T('scr.faqTitle')} />

  </div>

  <script is:inline define:vars={{ SCR_STR: { justNow: T('scr.justNow'), mAgo: T('scr.mAgo'), hAgo: T('scr.hAgo') } }}>
    (function () {
      'use strict';
      var tbody = document.getElementById('scrBody');
      if (!tbody) return;
      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      var state = { sport: '', league: '', type: '', edge: 0, conf: 0, q: '', key: 'score', dir: -1 };

      function apply() {
        var visible = 0;
        rows.forEach(function (tr) {
          var d = tr.dataset, ok = true;
          if (state.sport && d.sport !== state.sport) ok = false;
          if (ok && state.league && d.league !== state.league) ok = false;
          if (ok && state.type && d.type !== state.type) ok = false;
          if (ok && +d.edge < state.edge) ok = false;
          if (ok && +d.conf < state.conf) ok = false;
          if (ok && state.q && d.search.indexOf(state.q.toLowerCase()) === -1) ok = false;
          tr.style.display = ok ? '' : 'none';
          if (ok) visible++;
        });
        var k = state.key, dir = state.dir;
        rows.slice().sort(function (a, b) {
          var va, vb;
          if (k === 'match') { va = a.dataset.search; vb = b.dataset.search; }
          else if (k === 'kickoff') { va = a.dataset.kickoff; vb = b.dataset.kickoff; }
          else { va = +a.dataset[k]; vb = +b.dataset[k]; }
          return va < vb ? -dir : va > vb ? dir : 0;
        }).forEach(function (tr) { tbody.appendChild(tr); });
        document.getElementById('scrCount').textContent = visible;
        document.getElementById('scrEmpty').style.display = visible ? 'none' : '';
      }

      function markSort() {
        document.querySelectorAll('.scr-table th.sort').forEach(function (th) {
          var on = th.getAttribute('data-key') === state.key;
          th.classList.toggle('sorted', on);
          var ar = th.querySelector('.ar');
          if (ar) ar.textContent = on ? (state.dir === 1 ? '▴' : '▾') : '▾';
        });
      }

      document.getElementById('fSport').addEventListener('change', function (e) { state.sport = e.target.value; apply(); });
      document.getElementById('fLeague').addEventListener('change', function (e) { state.league = e.target.value; apply(); });
      document.getElementById('fType').addEventListener('change', function (e) { state.type = e.target.value; apply(); });
      document.getElementById('fEdge').addEventListener('input', function (e) { state.edge = +e.target.value; document.getElementById('fEdgeV').textContent = e.target.value + '%'; apply(); });
      document.getElementById('fConf').addEventListener('input', function (e) { state.conf = +e.target.value; document.getElementById('fConfV').textContent = e.target.value + '%'; apply(); });
      document.getElementById('fSearch').addEventListener('input', function (e) { state.q = e.target.value; apply(); });
      document.getElementById('fReset').addEventListener('click', function () {
        state = { sport: '', league: '', type: '', edge: 0, conf: 0, q: '', key: 'score', dir: -1 };
        document.querySelectorAll('#scrFilters select').forEach(function (s) { s.value = ''; });
        document.getElementById('fEdge').value = 0; document.getElementById('fEdgeV').textContent = '0%';
        document.getElementById('fConf').value = 0; document.getElementById('fConfV').textContent = '0%';
        document.getElementById('fSearch').value = '';
        markSort(); apply();
      });
      document.querySelectorAll('.scr-table th.sort').forEach(function (th) {
        th.addEventListener('click', function () {
          var k = th.getAttribute('data-key');
          if (state.key === k) state.dir = -state.dir;
          else { state.key = k; state.dir = (k === 'match' || k === 'kickoff') ? 1 : -1; }
          markSort(); apply();
        });
      });

      var upd = document.getElementById('scrUpdated');
      if (upd && upd.dataset.updated) {
        var mins = Math.max(0, Math.round((Date.now() - new Date(upd.dataset.updated).getTime()) / 60000));
        upd.textContent = mins < 1 ? SCR_STR.justNow : mins < 60 ? SCR_STR.mAgo.split('{n}').join(mins) : SCR_STR.hAgo.split('{n}').join(Math.round(mins / 60));
      }
    })();
  </script>
</Base>
