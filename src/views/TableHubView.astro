---
import Base from '../layouts/Base.astro';
import ToolsBox from '../components/ToolsBox.astro';
import fdData from '../data/football-data.json';
import { slugify, BUILD_ISO, fmtDate } from '../lib/utils.js';
import { leagueName } from '../lib/leagues.js';
import { t, lhref } from '../i18n/index.js';
import { buildSeasonTables } from '../lib/seasonTables.js';

// completed-season archives; plain EN hrefs on purpose — the archive pages
// are EN-only, same convention as the footer's /seasons and /table links
const archives = buildSeasonTables().map((s) => ({
  name: s.league, slug: s.slug, season: s.season,
}));

const { lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const F = (k, vars) => Object.entries(vars).reduce((str, [kk, v]) => str.split(`{${kk}}`).join(String(v)), T(k));

const tables = Object.entries(fdData.leagues ?? {})
  .filter(([, lg]) => (lg.standings ?? []).some((r) => (r.p ?? 0) > 0))
  .map(([sk, lg]) => ({
    sk,
    name: leagueName(sk, lg.name),
    leader: lg.standings[0],
    clubs: lg.standings.length,
  }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Football league tables',
  itemListElement: tables.map((x, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${x.name} table`,
    url: `https://ai-betting-tips.com${L(`/table/${slugify(x.name)}`)}/`,
  })),
};
---
<Base lang={lang} i18nPath="/table" title={T('tb.hubTitle')} description={T('tb.hubDesc')}
      schema={schema} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href={L('/')}>{T('crumb.home')}</a><span>/</span>{T('tb.crumb')}</div>
      <h1>{T('tb.hubH1a')} <em>{T('tb.hubH1b')}</em></h1>
      <p class="lead">{T('tb.hubLead')}</p>
      <p class="upd-line">{T('tb.snapshot')} {fmtDate(BUILD_ISO, lang)} · <a href="/editorial-policy">{T('common.howWeWrite')}</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">{T('tb.hubSec')}</h2>
            <a href={L('/predictions')} class="more-link">{T('nav.allTips')} →</a>
          </div>
          <div class="bt-grid">
            {tables.map((x) => (
              <a href={L(`/table/${slugify(x.name)}`)} class="bt-tile">
                <div class="ic">📊</div>
                <div>
                  <h4>{x.name}</h4>
                  <p>{F('tb.hubClubs', { n: x.clubs, team: x.leader.team, pts: x.leader.pts })}</p>
                </div>
                <span class="arr">→</span>
              </a>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>{T('tb.hubSeoH')}</h2>
          <p>{T('tb.hubSeoP')}</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📊</span> {T('tb.allTables')}</div>
          {tables.map((x) => (
            <a class="tm" href={L(`/table/${slugify(x.name)}`)}><span class="dot"></span>{x.name}</a>
          ))}
        </div>
        {archives.length > 0 && (
          <div class="box">
            <div class="box-h"><span class="hi">🗄️</span> {T('tb.archives')}</div>
            {archives.map((a) => (
              <a class="tm" href={`/table/${a.slug}/${a.season}`}>
                <span class="dot"></span>{a.name} {a.season.replace('-', '/')}
              </a>
            ))}
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> {T('tb.livePages')}</div>
          <a class="tm" href={L('/results')}><span class="dot"></span>{T('ft.leagueResults')}</a>
          <a class="tm" href={L('/predictions/today')}><span class="dot"></span>{T('gd.lnkPreds')}</a>
          <a class="tm" href={L('/screener')}><span class="dot"></span>{T('gd.lnkScreener')}</a>
          <a class="tm" href={L('/guides')}><span class="dot"></span>{T('ft.guides')}</a>
        </div>
        <ToolsBox lang={lang} />
      </aside>
    </div>
  </div>
</Base>
