---
import Base from '../layouts/Base.astro';
import data from '../data/casinos.json';
import content from '../data/content.json';
import countryData from '../data/countries.json';
import { avgScore, CASINO_SCORE_LABELS } from '../lib/utils.js';
import { t, trLabel, lhref } from '../i18n/index.js';

const { casino: c, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const F = (k, vars) => Object.entries(vars).reduce((str, [kk, v]) => str.split(`{${kk}}`).join(String(v)), T(k));
const trx = lang === 'en' ? null : ((content.entries ?? {})[`${lang}:casino:${c.slug}`] ?? null);
const ai = trx ?? (content.entries ?? {})[`casino:${c.slug}`];
const pros = trx?.pros ?? c.pros;
const cons = trx?.cons ?? c.cons;
const shortVerdict = trx?.short_verdict ?? c.verdict;
const avg = avgScore(c.scores);
const markets = (countryData.countries ?? []).filter((x) => (c.countries ?? []).includes(x.slug));
const others = (data.casinos ?? []).filter((x) => x.slug !== c.slug).slice(0, 4);
const updated = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();

const title = F('rv.casTitle', { name: c.name, year });
const description = F('rv.casDesc', { name: c.name, avg, bonus: c.bonus.headline, wag: c.bonus.wagering });

const faq = [
  { q: F('rv.qSafeCas', { name: c.name }), a: F('rv.aSafeCas', { name: c.name, lic: c.licences.join(' + ') }) },
  { q: F('rv.qOffer', { name: c.name }), a: F('rv.aOfferCas', { bonus: c.bonus.headline, wag: c.bonus.wagering,
      depPart: c.bonus.min_deposit ? F('rv.depPart', { dep: c.bonus.min_deposit }) : '',
      codePart: c.bonus.code ? F('rv.codePart', { code: c.bonus.code }) : '' }) },
  { q: F('rv.qWithdraw', { name: c.name }), a: F('rv.aWithdraw', { time: c.payout_time }) },
];
if (ai?.faq?.length) faq.push(...ai.faq);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Review',
      name: title,
      datePublished: updated,
      itemReviewed: { '@type': 'Organization', name: c.name, foundingDate: String(c.founded) },
      reviewRating: { '@type': 'Rating', ratingValue: avg, bestRating: 10, worstRating: 0 },
      author: { '@type': 'Organization', name: 'AI Betting Tips' },
      reviewBody: shortVerdict,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base lang={lang} i18nPath={`/casinos/${c.slug}`} title={title} description={description} schema={schema} active="casinos">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href={L('/')}>{T('crumb.home')}</a><span>/</span><a href={L('/casinos')}>{T('nav.casinos')}</a><span>/</span>{c.name}</div>
      <h1>{c.name} <em>{T('rv.casReviewEm')}</em></h1>
      <p class="lead">{description}</p>
      <p class="tc" style="margin-top:6px">{F('rv.lastUpdated', { date: updated })}</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        {c.placeholder && (
          <div class="box"><div class="box-pad" style="color:var(--danger);font-weight:700">
            {T('rv.demoWarn')}
          </div></div>
        )}

        <section>
          <div class="bk-list">
            <article class="bk featured">
              <div class="bk-rank">★</div>
              <div class="bk-brand">
                <div class="bk-logo" style={`background:${c.logo.bg};color:${c.logo.fg}`}>{c.logo.line1}<br />{c.logo.line2}</div>
                <div>
                  <h4>{c.name}</h4>
                  <div class="bk-meta"><span class="rate">★ <b>{c.rating}</b></span><span class="tc">{T('rv.founded')} {c.founded} · {c.licences.join(', ')}</span></div>
                </div>
              </div>
              <div class="bk-bonus">
                <div class="blbl">{c.bonus.type === 'no-deposit' ? T('row.noDeposit') : T('row.welcomePkg')}</div>
                <div class="amt">{c.bonus.headline}</div>
                <div class="tc" style="margin-top:4px">{c.bonus.wagering} {T('row.wagering')}{c.bonus.min_deposit ? ` · ${T('row.minDep')} €${c.bonus.min_deposit}` : ''}{c.bonus.code ? ` · ${T('bon.code')} ${c.bonus.code}` : ''}</div>
              </div>
              <div class="bk-score">
                <div class="ring" data-val={Math.round(avg * 10)}><b>{avg}</b></div>
                <div class="sl">{T('bk.ourScore')}</div>
              </div>
              <div class="bk-actions">
                <a href={c.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">{T('bk.getBonus')}</a>
                <span class="review" style="text-decoration:none">{T('bk.tc')} <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline">GambleAware.org</a></span>
              </div>
            </article>
          </div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">{F('rv.scoresPre', { name: c.name })} <b>{F('rv.scoresBold', { name: c.name })}</b></h2></div>
          <div class="box"><div class="box-pad">
            <div class="rate-rows">
              {Object.entries(c.scores).map(([k, v]) => (
                <div class="rate-row">
                  <span class="rl">{trLabel(lang, CASINO_SCORE_LABELS[k] ?? k)}</span>
                  <div class="bar" data-val={Math.round(v * 10)}><i></i></div>
                  <span class="rv">{v}</span>
                </div>
              ))}
            </div>
          </div></div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">{T('rv.prosPre')} <b>{T('rv.prosBold')}</b></h2></div>
          <div class="feat-grid" style="grid-template-columns:1fr 1fr">
            <div class="feat">
              <div class="fi">✅</div><h4>{T('rv.liked')}</h4>
              <ul style="margin:0;padding-left:18px;color:var(--text-dim);font-size:13.5px">
                {pros.map((p) => <li style="margin-bottom:6px">{p}</li>)}
              </ul>
            </div>
            <div class="feat v">
              <div class="fi">⚠️</div><h4>{T('rv.watch')}</h4>
              <ul style="margin:0;padding-left:18px;color:var(--text-dim);font-size:13.5px">
                {cons.map((x) => <li style="margin-bottom:6px">{x}</li>)}
              </ul>
            </div>
          </div>
        </section>

        {ai && (
          <section class="seo">
            <h2>{F('rv.verdictOn', { name: c.name })}</h2>
            <p>{ai.verdict}</p>
            <h3 style="margin:18px 0 8px">{F('rv.whoFor', { name: c.name })}</h3>
            <p>{ai.who_for}</p>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">{T('rv.keyPre')} <b>{T('rv.keyBold')}</b></h2></div>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <tbody>
                <tr><td class="o-match" style="font-weight:700">{T('rv.licences')}</td><td class="o-cell"><span class="cb">{c.licences.join(', ')}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">{T('rv.payoutSpeed')}</td><td class="o-cell hot"><span class="cb">{c.payout_time}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">{T('rv.payments')}</td><td class="o-cell"><span class="cb">{c.payments.join(', ')}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">{T('rv.gameProviders')}</td><td class="o-cell"><span class="cb">{c.providers.join(', ')}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">{T('rv.bonusWagering')}</td><td class="o-cell"><span class="cb">{c.bonus.wagering}{c.bonus.expires_days ? F('rv.expires', { n: c.bonus.expires_days }) : ''}</span></td></tr>
              </tbody>
            </table>
          </div></div>
        </section>

        <section class="seo">
          <h2>{F('rv.verdictH', { name: c.name })}</h2>
          <p>{shortVerdict}</p>
          <p class="dim" style="font-size:13px">{T('rv.aiNote')}</p>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">{c.name} <b>FAQ</b></h2></div>
          <div class="faq">
            {faq.map((f, i) => (
              <div class={`faq-item${i === 0 ? ' open' : ''}`}>
                <div class="faq-q">{f.q}<span class="pm">+</span></div>
                <div class="faq-a"><p>{f.a}</p></div>
              </div>
            ))}
          </div>
        </section>

      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🎰 {c.name}</h4>
          <p>{c.bonus.headline}</p>
          <a href={c.affiliate_url} class="btn btn-mint btn-block" rel="nofollow sponsored" target="_blank">{T('rv.claimOffer')}</a>
          <span class="tc-line">{T('bk.tc')} <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank">GambleAware.org</a></span>
        </div>
        {markets.length > 0 && (
          <div class="box">
            <div class="box-h"><span class="hi">🌍</span> {T('rv.availableIn')}</div>
            {markets.map((x) => (
              <a class="tm" href={L(`/countries/${x.slug}`)}><img class="fl-ic" src={`/flags/${x.slug === 'uk' ? 'gb' : x.slug}.svg`} alt="" width="18" height="13" /> {x.name}</a>
            ))}
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">🎰</span> {T('rv.moreCasinos')}</div>
          {others.map((x) => (
            <a class="tm" href={L(`/casinos/${x.slug}`)}><span class="dot"></span>{F('rv.casReviewLink', { name: x.name })}</a>
          ))}
          <a class="tm" href={L('/casinos')}><span class="dot"></span>{T('rv.allCasinos')}</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
