---
// Tipster cards built from REAL settled results (data/stats.json).
import stats from '../data/stats.json';
import { AVATAR_STYLES, signed } from '../lib/utils.js';

const { limit = 6 } = Astro.props;
const tipsters = (stats.tipsters ?? []).slice(0, limit);
---
{tipsters.length === 0 ? (
  <div class="box"><div class="box-pad dim">No settled tips yet — stats appear once results come in.</div></div>
) : (
  <div class="tip-grid">
    {tipsters.map((t, i) => (
      <article class={`tipster${i === 0 ? ' top' : ''}`}>
        <span class="rank">{i + 1}</span><span class="verified">✔</span>
        <div class="ava" style={AVATAR_STYLES[i % AVATAR_STYLES.length]}>{t.initials}</div>
        <h4>{t.name}</h4>
        <div class="role">{t.top_league} · verified</div>
        <div class="stats">
          <div><div class="n win">{t.win_rate}%</div><div class="l">Win rate</div></div>
          <div><div class={t.roi >= 0 ? 'n roi' : 'n'} style={t.roi < 0 ? 'color:var(--lose)' : ''}>{signed(t.roi)}%</div><div class="l">ROI</div></div>
          <div><div class="n">{t.settled}</div><div class="l">Settled</div></div>
        </div>
        <a href="/tipsters" class={`btn ${i === 0 ? 'btn-mint' : 'btn-outline'} btn-sm btn-block`}>Follow</a>
      </article>
    ))}
  </div>
)}
