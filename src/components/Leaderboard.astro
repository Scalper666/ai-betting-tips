---
// Leaderboard from REAL settled results (data/stats.json).
import stats from '../data/stats.json';
import { AVATAR_STYLES, signed } from '../lib/utils.js';

const rows = stats.tipsters ?? [];
const medals = ['gold', 'silver', 'bronze'];
---
<div class="lead">
  <div class="lead-row head">
    <div>#</div><div>Tipster</div><div class="col-sm">Bets</div>
    <div>Win rate</div><div class="col-hide">Profit</div><div>ROI</div>
  </div>
  {rows.length === 0 ? (
    <div class="lead-row"><div class="lead-cell" style="grid-column:1/-1">No settled tips yet.</div></div>
  ) : rows.map((t, i) => (
    <div class="lead-row">
      <div class={`lead-rank${i < 3 ? ' ' + medals[i] : ''}`}>{i + 1}</div>
      <div class="lead-who">
        <div class="lead-ava" style={AVATAR_STYLES[i % AVATAR_STYLES.length]}>{t.initials}</div>
        <div><h4>{t.name} ✔</h4><div class="sp">{t.top_league}</div></div>
      </div>
      <div class="lead-cell col-sm"><b>{t.settled}</b><span>Bets</span></div>
      <div class="lead-cell win"><b>{t.win_rate}%</b><span>Win</span></div>
      <div class="lead-cell col-hide"><b style={t.profit < 0 ? 'color:var(--lose)' : ''}>{signed(t.profit)}u</b><span>Profit</span></div>
      <div class="lead-cell roi"><b style={t.roi < 0 ? 'color:var(--lose)' : ''}>{signed(t.roi)}%</b><span>ROI</span></div>
    </div>
  ))}
</div>
