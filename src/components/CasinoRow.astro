---
import { avgScore } from '../lib/utils.js';
import { t, lhref } from '../i18n/index.js';

const { casino: c, rank, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const avg = avgScore(c.scores);
const featured = rank === 1;
const bonusLabel = c.bonus.type === 'no-deposit' ? T('row.noDeposit') : T('row.welcomePkg');
---
<article class={`bk${featured ? ' featured' : ''}`}>
  {featured && <span class="bk-ribbon">{T('bk.topPick')}</span>}
  {c.placeholder && <span class="demo-flag" title="Demo entry — replace with a real partner">demo</span>}
  <div class="bk-rank">{rank}</div>

  <div class="bk-brand">
    <div class="bk-logo" style={`background:${c.logo.bg};color:${c.logo.fg}`}>
      {c.logo.line1}<br />{c.logo.line2}
    </div>
    <div>
      <h4>{c.name}</h4>
      <div class="bk-meta">
        <span class="rate">★ <b>{c.rating}</b></span>
        <span class="tc">{T('bk.tc')} <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline">GambleAware.org</a></span>
      </div>
    </div>
  </div>

  <div class="bk-bonus">
    <div class="blbl">{bonusLabel}</div>
    <div class="amt">{c.bonus.headline}</div>
    <div class="tc" style="margin-top:4px">{c.bonus.wagering} {T('row.wagering')}{c.bonus.min_deposit ? ` · ${T('row.minDep')} €${c.bonus.min_deposit}` : ''}</div>
  </div>

  <div class="bk-score">
    <div class="ring" data-val={Math.round(avg * 10)}><b>{avg}</b></div>
    <div class="sl">{T('bk.ourScore')}</div>
  </div>

  <div class="bk-actions">
    <a href={c.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">{T('bk.getBonus')}</a>
    <a href={L(`/casinos/${c.slug}`)} class="review">{T('bk.readReview')}</a>
  </div>
</article>
