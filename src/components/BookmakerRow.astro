---
import { avgScore } from '../lib/utils.js';

const { bk, rank } = Astro.props;
const avg = avgScore(bk.scores);
const featured = rank === 1;
---
<article class={`bk${featured ? ' featured' : ''}`}>
  {featured && <span class="bk-ribbon">Top pick</span>}
  {bk.placeholder && <span class="demo-flag" title="Demo entry — replace with a real partner">demo</span>}
  <div class="bk-rank">{rank}</div>

  <div class="bk-brand">
    <div class="bk-logo" style={`background:${bk.logo.bg};color:${bk.logo.fg}`}>
      {bk.logo.line1}<br />{bk.logo.line2}
    </div>
    <div>
      <h4>{bk.name}</h4>
      <div class="bk-meta">
        <span class="rate">★ <b>{bk.rating}</b></span>
        <span class="tc">18+ · T&amp;C apply · <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline">GambleAware.org</a></span>
      </div>
    </div>
  </div>

  <div class="bk-bonus">
    <div class="blbl">{bk.bonus.type === 'free-bet' ? 'Free bet offer' : 'Welcome bonus'}</div>
    <div class="amt">{bk.bonus.headline}</div>
    <div class="tc" style="margin-top:4px">{bk.bonus.wagering} wagering · min odds {bk.bonus.min_odds}</div>
  </div>

  <div class="bk-score">
    <div class="ring" data-val={Math.round(avg * 10)}><b>{avg}</b></div>
    <div class="sl">Our score</div>
  </div>

  <div class="bk-actions">
    <a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">Get bonus</a>
    <a href={`/bookmakers/${bk.slug}`} class="review">Read review</a>
  </div>
</article>
