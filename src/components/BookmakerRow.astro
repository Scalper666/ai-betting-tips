---
import { avgScore } from '../lib/utils.js';
import { t } from '../i18n/index.js';

const { bk, rank, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const avg = avgScore(bk.scores);
const featured = rank === 1;
---
<article class={`bk${featured ? ' featured' : ''}`}>
  {featured && <span class="bk-ribbon">{T('bk.topPick')}</span>}
  {bk.placeholder && <span class="demo-flag" title="Demo entry — replace with a real partner">demo</span>}
  <div class="bk-rank">{rank}</div>

  <div class="bk-brand">
    <div class="bk-logo" style={`background:${bk.logo.bg};color:${bk.logo.fg}`}>
      {bk.logo.line1}<br />{bk.logo.line2}
    </div>
    <div>
      <h4>{bk.name}</h4>
      <div class="bk-meta">
        <span class="rate">★ <b>{bk.rating}</b></span>
        <span class="tc">{T('bk.tc')} <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline">GambleAware.org</a></span>
      </div>
    </div>
  </div>

  <div class="bk-bonus">
    <div class="blbl">{bk.bonus.type === 'free-bet' ? T('row.freeBet') : T('row.welcome')}</div>
    <div class="amt">{bk.bonus.headline}</div>
    <div class="tc" style="margin-top:4px">{bk.bonus.wagering} {T('row.wagering')} · {T('row.minOdds')} {bk.bonus.min_odds}</div>
  </div>

  <div class="bk-score">
    <div class="ring" data-val={Math.round(avg * 10)}><b>{avg}</b></div>
    <div class="sl">{T('bk.ourScore')}</div>
  </div>

  <div class="bk-actions">
    <a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">{T('bk.getBonus')}</a>
    <a href={`/bookmakers/${bk.slug}`} class="review">{T('bk.readReview')}</a>
  </div>
</article>
