---
import { abbr, badgeColor, confidenceLabel, kickoffLabel, matchSlug, slugify, topScoreline } from '../lib/utils.js';
import { t, localizeMarket, lhref } from '../i18n/index.js';

const { tip, lang = 'en' } = Astro.props;
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
const rec = tip.recommendation ?? {};
const conf = Number(rec.confidence ?? 60);
const { label, cls } = confidenceLabel(conf);
const href = lhref(lang, `/predictions/${matchSlug(tip)}`);
const score = topScoreline(tip);
---
<article class="pred" data-cat={slugify(tip.league)} data-kickoff={tip.kickoff ?? ''}>
  <div class="pred-top">
    <span class="pred-league"><span class="lg-logo">{tip.sport_icon ?? '🏆'}</span> {tip.league}</span>
    <span class="pred-when">🕒 {kickoffLabel(tip.kickoff, lang)}</span>
  </div>
  <div class="pred-body">
    <div class="match">
      <div class="team">
        <div class="badge" style={`background:${badgeColor(tip.home)}`}>{abbr(tip.home)}</div>
        <div class="nm">{tip.home}</div>
      </div>
      {score
        ? <div class="vs vs-pred"><span class="vs-lbl">{T('card.modelScore')}</span><span class="vs-sc">{score}</span></div>
        : <div class="vs">VS</div>}
      <div class="team">
        <div class="badge" style={`background:${badgeColor(tip.away)}`}>{abbr(tip.away)}</div>
        <div class="nm">{tip.away}</div>
      </div>
    </div>
    <div class="pred-tip">
      <div><div class="lbl">{T('card.ourTip')}</div><div class="val">{localizeMarket(lang, rec.text)}</div></div>
      <div class="odd-box"><div class="ot">{T('card.odds')}</div><div class="ov">{Number(rec.price ?? 0).toFixed(2)}</div></div>
    </div>
    <div class="confidence">
      <div class="cf-top"><span>{T('card.confidence')}</span><span class="pc">{T(`conf.${label}`)} · {conf}%</span></div>
      <div class={`bar ${cls}`.trim()} data-val={conf}><i></i></div>
    </div>
  </div>
  <div class="pred-foot">
    <div class="by"><span class="ava">AI</span> {T('card.model')}</div>
    <a href={href} class="btn btn-ghost btn-sm">{T('card.analysis')}</a>
  </div>
</article>
