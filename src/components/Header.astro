---
import { LOCALES, langsFor, homePath, t, lhref } from '../i18n/index.js';
import predictions from '../data/predictions.json';
import { slugify } from '../lib/utils.js';
import { SHOW_OPERATORS } from '../lib/operators.js';

const { active = '', lang = 'en', i18nPath = null, langs: langsProp = null } = Astro.props;
// top live leagues for the nav — hardcoded links 404 when a league leaves the feed
const _counts = {};
for (const tp of (predictions.tips ?? [])) _counts[tp.league] = (_counts[tp.league] ?? 0) + 1;
const navLeagues = Object.entries(_counts).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([name]) => name);
const is = (k) => (active === k ? ' active' : '');
const T = (k) => t(lang, k);
const L = (pth) => lhref(lang, pth);
// picker target: same page in the other language when translated, else its home
const langHref = (l) => (i18nPath ? (l === 'en' ? i18nPath : `/${l}${i18nPath}`) : homePath(l));
// on match pages the picker offers only the languages that page exists in
// langsProp: families whose language set depends on data, not the path (h2h)
const langs = langsProp ?? (i18nPath ? langsFor(i18nPath) : ['en', ...langsFor('/').slice(1)]);
---
<header class="hdr">
  <div class="container hdr-bar">
    <a href={homePath(lang)} class="logo">
      <span class="mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9.5" fill="#fff"/><path d="M12 8.1l3 2.2-1.15 3.5h-3.7L9 10.3z" fill="#0b0e11"/><g stroke="#0b0e11" stroke-width="1.5" stroke-linecap="round"><path d="M12 8.1V4.6M15 10.3l3.3-1.1M13.85 13.8l2.05 2.85M10.15 13.8L8.1 16.65M9 10.3L5.7 9.2"/></g><circle cx="12" cy="12" r="9.5" stroke="#0b0e11" stroke-width="1.6"/></svg></span>
      <span class="name">AI <em>Betting</em> Tips</span>
    </a>
    <nav class="nav">
      <div class={`nav-item${is('predictions')}`}><button>{T('nav.predictions')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href={L('/bet-of-the-day')}><span class="ic">📌</span>{T('botd.eyebrow')}</a>
          <a href={L('/screener')}><span class="ic">🔍</span>{T('nav.screener')}</a>
          <a href={L('/predictions')}><span class="ic">⚽</span>{T('nav.allTips')}</a>
          {navLeagues.map((lg) => (
            <a href={L(`/league/${slugify(lg)}`)}><span class="ic">🏆</span>{lg}</a>
          ))}
          <a href={L('/tips/accumulator')}><span class="ic">🎯</span>{T('nav.accaTips')}</a>
          <a href={L('/tips/btts')}><span class="ic">⚽</span>{T('nav.bttsTips')}</a>
          {!SHOW_OPERATORS && <a href={L('/countries/uk')}><span class="ic">🌍</span>{T('nav.byCountry')}</a>}
        </div>
      </div>
      {SHOW_OPERATORS && (<>
      <div class={`nav-item${is('bookmakers')}`}><button>{T('nav.sites')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href={L('/bookmakers')}><span class="ic">🏆</span>{T('nav.topSites')}</a>
          <a href={L('/betting-apps')}><span class="ic">📱</span>{T('nav.apps')}</a>
          <a href={L('/countries/uk')}><span class="ic">🌍</span>{T('nav.byCountry')}</a>
        </div>
      </div>
      <div class={`nav-item${is('bonuses')}`}><button>{T('nav.bonuses')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href={L('/bonuses')}><span class="ic">🎁</span>{T('nav.allOffers')}</a>
          <a href={L('/bonuses')}><span class="ic">💸</span>{T('nav.freeBets')}</a>
        </div>
      </div>
      <div class={`nav-item${is('casinos')}`}><button>{T('nav.casinos')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href={L('/casinos')}><span class="ic">🎰</span>{T('nav.topCasinos')}</a><a href={L('/casinos')}><span class="ic">🎥</span>{T('nav.liveCasino')}</a><a href={L('/casinos')}><span class="ic">🆕</span>{T('nav.newCasinos')}</a></div>
      </div>
      </>)}
      <div class={`nav-item${is('tipsters')}`}><button>{T('nav.results')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href={L('/tipsters')}><span class="ic">📈</span>{T('nav.performance')}</a><a href={L('/news/recap')}><span class="ic">🗓</span>{T('nav.weeklyRecaps')}</a><a href={L('/predictions/daily')}><span class="ic">📅</span>{T('nav.resultsByDate')}</a></div>
      </div>
      <div class="nav-item"><button>{T('nav.tools')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href="/tools/acca-builder"><span class="ic">🤖</span>{T('ft.accaBuilder')}</a>
          <a href={L('/tools/odds-converter')}><span class="ic">🔁</span>{T('ft.oddsConverter')}</a>
          <a href={L('/tools/accumulator-calculator')}><span class="ic">🎯</span>{T('ft.accaCalc')}</a>
          <a href={L('/tools/margin-calculator')}><span class="ic">📊</span>{T('ft.marginCalc')}</a>
          <a href={L('/dropping-odds')}><span class="ic">📉</span>{T('ft.droppingOdds')}</a>
        </div>
      </div>
      <div class={`nav-item${is('news')}`}><button>{T('nav.news')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href={L('/news')}><span class="ic">📰</span>{T('nav.latestNews')}</a><a href={L('/news')}><span class="ic">📊</span>{T('nav.matchAnalysis')}</a></div>
      </div>
    </nav>
    <div class="hdr-actions">
      {/* auth actions hidden until accounts exist (user request) */}
      <div class="fz-ctl" title="Text size">
        <button data-fz-step="-1" aria-label="Smaller text">A−</button>
        <button data-fz-step="1" aria-label="Larger text">A+</button>
      </div>
      <div class="theme-switch">
        <button class="theme-btn" aria-label="Colour scheme">🎨</button>
        <div class="theme-menu">
          <div class="tm-h">{T('nav.colourScheme')}</div>
          <button data-skin-set="amber"><span class="sw" style="background:linear-gradient(135deg,#fcd535,#f0b90b)"></span> Amber <span class="chk">✓</span></button>
          <button data-skin-set="azure"><span class="sw" style="background:linear-gradient(135deg,#40a7f0,#2b7de0)"></span> Azure <span class="chk">✓</span></button>
          <button data-skin-set="day"><span class="sw" style="background:linear-gradient(135deg,#ffffff 45%,#c9d6e4)"></span> Day <span class="chk">✓</span></button>
          <button data-skin-set="midnight"><span class="sw" style="background:linear-gradient(135deg,#5aa0e6,#4384c9)"></span> Midnight <span class="chk">✓</span></button>
          <button data-skin-set="copper"><span class="sw" style="background:linear-gradient(135deg,#ffa658,#ec7c28)"></span> Copper <span class="chk">✓</span></button>
        </div>
      </div>
      <div class="odds-switch theme-switch">
        <button class="theme-btn odds-btn" aria-label={T('nav.oddsFmt')} data-odds-btn>1.50</button>
        <div class="theme-menu">
          <div class="tm-h">{T('nav.oddsFmt')}</div>
          <button data-odds-set="dec">1.50 <span class="chk">✓</span></button>
          <button data-odds-set="us">+150 <span class="chk">✓</span></button>
          <button data-odds-set="frac">1/2 <span class="chk">✓</span></button>
        </div>
      </div>
      <div class="lang-switch">
        <button class="lang-btn" aria-label={T('nav.language')}><img class="fl-ic" src={`/flags/${LOCALES[lang].cc}.svg`} alt={LOCALES[lang].name} width="18" height="13" /> <span class="cc">{lang.toUpperCase()}</span> ▾</button>
        <div class="theme-menu lang-menu">
          <div class="tm-h">{T('nav.language')}</div>
          {langs.map((l) => (
            <a href={langHref(l)} class={l === lang ? 'active' : ''} rel="alternate" hreflang={l}>
              <img class="fl-ic" src={`/flags/${LOCALES[l].cc}.svg`} alt="" width="18" height="13" /> {LOCALES[l].name} <span class="chk">✓</span>
            </a>
          ))}
        </div>
      </div>
      <button class="burger" id="burger" aria-label="Menu">☰</button>
    </div>
  </div>
</header>
