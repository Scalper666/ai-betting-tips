---
import { LOCALES, ALT_LANGS, homePath, t } from '../i18n/index.js';
const { active = '', lang = 'en', i18nPath = null } = Astro.props;
const is = (k) => (active === k ? ' active' : '');
const T = (k) => t(lang, k);
// picker target: same page in the other language when translated, else its home
const langHref = (l) => (i18nPath ? (l === 'en' ? i18nPath : `/${l}${i18nPath}`) : homePath(l));
const langs = ['en', ...ALT_LANGS];
---
<header class="hdr">
  <div class="container hdr-bar">
    <a href={homePath(lang)} class="logo">
      <span class="mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9.5" fill="#fff"/><path d="M12 8.1l3 2.2-1.15 3.5h-3.7L9 10.3z" fill="#0b0e11"/><g stroke="#0b0e11" stroke-width="1.5" stroke-linecap="round"><path d="M12 8.1V4.6M15 10.3l3.3-1.1M13.85 13.8l2.05 2.85M10.15 13.8L8.1 16.65M9 10.3L5.7 9.2"/></g><circle cx="12" cy="12" r="9.5" stroke="#0b0e11" stroke-width="1.6"/></svg></span>
      <span class="name">AI <em>Betting</em> Tips</span>
    </a>
    <nav class="nav">
      <div class={`nav-item${is('predictions')}`}><button>{T('nav.predictions')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href="/screener"><span class="ic">🔍</span>{T('nav.screener')}</a>
          <a href="/predictions"><span class="ic">⚽</span>{T('nav.allTips')}</a>
          <a href="/league/champions-league"><span class="ic">🏆</span>{T('nav.champions')}</a>
          <a href="/league/premier-league"><span class="ic">🦁</span>{T('nav.premier')}</a>
          <a href="/league/serie-a"><span class="ic">🇮🇹</span>{T('nav.serieA')}</a>
          <a href="/tips/accumulator"><span class="ic">🎯</span>{T('nav.accaTips')}</a>
          <a href="/tips/btts"><span class="ic">⚽</span>{T('nav.bttsTips')}</a>
        </div>
      </div>
      <div class={`nav-item${is('bookmakers')}`}><button>{T('nav.sites')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href="/bookmakers"><span class="ic">🏆</span>{T('nav.topSites')}</a>
          <a href="/betting-apps"><span class="ic">📱</span>{T('nav.apps')}</a>
          <a href="/countries/uk"><span class="ic">🌍</span>{T('nav.byCountry')}</a>
        </div>
      </div>
      <div class={`nav-item${is('bonuses')}`}><button>{T('nav.bonuses')} <span class="caret">▼</span></button>
        <div class="dropdown">
          <a href="/bonuses"><span class="ic">🎁</span>{T('nav.allOffers')}</a>
          <a href="/bonuses"><span class="ic">💸</span>{T('nav.freeBets')}</a>
        </div>
      </div>
      <div class={`nav-item${is('casinos')}`}><button>{T('nav.casinos')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href="/casinos"><span class="ic">🎰</span>{T('nav.topCasinos')}</a><a href="/casinos"><span class="ic">🎥</span>{T('nav.liveCasino')}</a><a href="/casinos"><span class="ic">🆕</span>{T('nav.newCasinos')}</a></div>
      </div>
      <div class={`nav-item${is('tipsters')}`}><button>{T('nav.results')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href="/tipsters"><span class="ic">📈</span>{T('nav.performance')}</a><a href="/news/recap"><span class="ic">🗓</span>{T('nav.weeklyRecaps')}</a><a href="/predictions/daily"><span class="ic">📅</span>{T('nav.resultsByDate')}</a></div>
      </div>
      <div class={`nav-item${is('news')}`}><button>{T('nav.news')} <span class="caret">▼</span></button>
        <div class="dropdown"><a href="/news"><span class="ic">📰</span>{T('nav.latestNews')}</a><a href="/news"><span class="ic">📊</span>{T('nav.matchAnalysis')}</a></div>
      </div>
    </nav>
    <div class="hdr-actions">
      {/* auth actions hidden until accounts exist (user request) */}
      <div class="fz-ctl" title="Text size">
        <button data-fz-step="-1" aria-label="Smaller text">A−</button>
        <button data-fz-step="1" aria-label="Larger text">A+</button>
      </div>
      <div class="theme-switch">
        <button class="theme-btn" aria-label="Colour scheme">🎨</button>
        <div class="theme-menu">
          <div class="tm-h">{T('nav.colourScheme')}</div>
          <button data-skin-set="amber"><span class="sw" style="background:linear-gradient(135deg,#fcd535,#f0b90b)"></span> Amber <span class="chk">✓</span></button>
          <button data-skin-set="azure"><span class="sw" style="background:linear-gradient(135deg,#40a7f0,#2b7de0)"></span> Azure <span class="chk">✓</span></button>
          <button data-skin-set="midnight"><span class="sw" style="background:linear-gradient(135deg,#5aa0e6,#4384c9)"></span> Midnight <span class="chk">✓</span></button>
          <button data-skin-set="copper"><span class="sw" style="background:linear-gradient(135deg,#ffa658,#ec7c28)"></span> Copper <span class="chk">✓</span></button>
        </div>
      </div>
      <div class="lang-switch">
        <button class="lang-btn" aria-label={T('nav.language')}><img class="fl-ic" src={`/flags/${LOCALES[lang].cc}.svg`} alt={LOCALES[lang].name} width="18" height="13" /> <span class="cc">{lang.toUpperCase()}</span> ▾</button>
        <div class="theme-menu lang-menu">
          <div class="tm-h">{T('nav.language')}</div>
          {langs.map((l) => (
            <a href={langHref(l)} class={l === lang ? 'active' : ''} rel="alternate" hreflang={l}>
              <img class="fl-ic" src={`/flags/${LOCALES[l].cc}.svg`} alt="" width="18" height="13" /> {LOCALES[l].name} <span class="chk">✓</span>
            </a>
          ))}
        </div>
      </div>
      <button class="burger" id="burger" aria-label="Menu">☰</button>
    </div>
  </div>
</header>
