---
import Base from '../../layouts/Base.astro';
import seasonsData from '../../data/seasons.json';
import predictions from '../../data/predictions.json';
import historyData from '../../data/history.json';
import { slugify } from '../../lib/utils.js';

// ── Season hub index: every tracked league season, with live fixture counts.
const seasons = seasonsData.seasons ?? [];
const tips = predictions.tips ?? [];
const counts = {};
for (const t of tips) counts[t.sport_key] = (counts[t.sport_key] ?? 0) + 1;

const settledAll = Object.values(historyData.tips ?? {})
  .filter((t) => ['won', 'lost'].includes(t.status)).length;

const title = 'Football Season Predictions 2026/27 — Every League We Track';
const description = 'Season hubs for the Premier League, La Liga, Serie A, Bundesliga, Ligue 1, Championship, Eredivisie, Primeira Liga and Brasileirão: fixtures, model probabilities, live tables and our full settled record.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Football season predictions',
  itemListElement: seasons.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${s.league} ${s.season} predictions`,
    url: `https://ai-betting-tips.com/seasons/${s.slug}/`,
  })),
};
---
<Base title={title} description={description} schema={schema} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Seasons</div>
      <h1>Season <em>predictions</em></h1>
      <p class="lead">One evergreen hub per league season: every priced fixture with our model's probabilities, the live table, and the settled record of our own picks in that competition — wins and losses alike. Rebuilt twice a day from the same pipeline that grades every tip.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">Tracked <b>league seasons</b></h2>
            <a href="/predictions" class="more-link">All predictions →</a>
          </div>
          <div class="bt-grid">
            {seasons.map((s) => (
              <a href={`/seasons/${s.slug}`} class="bt-tile">
                <div class="ic">📅</div>
                <div>
                  <h4>{s.league} {s.season}</h4>
                  <p>{s.window} · {counts[s.sport_key] ?? 0} fixtures priced now</p>
                </div>
                <span class="arr">→</span>
              </a>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>What a season hub actually gives you</h2>
          <p>Most "season predictions" pages are written once in August and never touched again. These are the opposite: the fixture list, the league table and our record all come straight from the pipeline that prices matches twice a day, so a page you open in March shows March's data. Each hub carries the season's structural quirks — goal averages, draw rates, format details — because those shape prices more reliably than preseason narratives do.</p>
          <p>Our own picks in every competition are archived the moment they publish and graded automatically once matches finish, which is why the record blocks on these pages include losing runs ({settledAll} decided picks and counting across all leagues). Nothing is curated. Betting involves risk and nothing here is financial advice; 18+, please gamble responsibly.</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📅</span> All seasons</div>
          {seasons.map((s) => (
            <a class="tm" href={`/seasons/${s.slug}`}><span class="dot"></span>{s.league} {s.season}</a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> Live pages</div>
          <a class="tm" href="/predictions/today"><span class="dot"></span>Today's predictions</a>
          <a class="tm" href="/screener"><span class="dot"></span>AI value screener</a>
          <a class="tm" href="/tipsters"><span class="dot"></span>Model track record</a>
          <a class="tm" href="/guides"><span class="dot"></span>Betting guides</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
