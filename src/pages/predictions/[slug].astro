---
import Base from '../../layouts/Base.astro';
import predictions from '../../data/predictions.json';
import historyData from '../../data/history.json';
import screener from '../../data/screener.json';
import content from '../../data/content.json';
import { matchSlug, abbr, badgeColor, kickoffLabel, confidenceLabel, slugify, faqSchema } from '../../lib/utils.js';
import { teamForm, h2hBetween, leagueTable, resolveTeam } from '../../lib/form.js';

// ── Programmatic SEO, compounding edition:
//    pages are built from the CURRENT feed ∪ the SETTLEMENT ARCHIVE, so a match
//    page never dies — after full time it becomes a permanent result page
//    ("our tip was X @ 5.2 — won, 2-1"), and the archive grows daily.
export function getStaticPaths() {
  const tips = predictions.tips ?? [];
  const live = new Map(tips.map((t) => [matchSlug(t), t]));

  // real (non-mock) archived tips, grouped by page slug
  const bySlug = {};
  for (const h of Object.values(historyData.tips ?? {})) {
    if (h.score === 'simulated' || String(h.event_id ?? '').startsWith('mock')) continue;
    if (!h.home || !h.away) continue;
    const slug = slugify(`${h.home}-vs-${h.away}`);
    (bySlug[slug] ??= []).push(h);
  }

  const slugs = new Set([...live.keys(), ...Object.keys(bySlug)]);
  return [...slugs].map((slug) => ({
    params: { slug },
    props: {
      tip: live.get(slug) ?? null,
      archive: (bySlug[slug] ?? []).sort((a, b) => String(b.kickoff ?? '').localeCompare(String(a.kickoff ?? ''))),
    },
  }));
}

const { tip, archive } = Astro.props;
const isLive = !!tip;
const latest = archive[0] ?? null;

// unified view-model (live tip shape wins; archive entries carry our published bet)
const home = tip?.home ?? latest?.home;
const away = tip?.away ?? latest?.away;
const league = tip?.league ?? latest?.league ?? 'Football';
const kickoffIso = tip?.kickoff ?? latest?.kickoff;
const rec = tip?.recommendation ?? {
  text: latest?.market, price: latest?.odds, bookmaker: latest?.bookmaker,
  confidence: latest?.confidence, edge_pct: latest?.edge_pct,
};
const conf = Number(rec.confidence ?? 60);
const { label, cls } = confidenceLabel(conf);
const kickoff = kickoffLabel(kickoffIso);
const kickedDate = kickoffIso
  ? new Date(kickoffIso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : '';

// settlement state (archive mode)
const settledStates = ['won', 'lost', 'void'];
const settled = !isLive && latest && settledStates.includes(latest.status);
// a fixture can leave the feed BEFORE it is played (league rotation) — don't say "kicked off"
const played = kickoffIso ? new Date(kickoffIso).getTime() < Date.now() : true;
const resultScore = settled && latest.score && latest.score !== 'simulated' ? latest.score : null;
const resWord = { won: 'Won', lost: 'Lost', void: 'Void' }[latest?.status] ?? 'Pending';
const resCls = { won: 'w', lost: 'l', void: 'v' }[latest?.status] ?? 'v';
const profit = Number(latest?.profit ?? 0);

// our full settled record on this fixture (shown in both modes)
const record = archive.filter((h) => settledStates.includes(h.status) && (isLive || h !== latest));

// league pages exist only for leagues in the current feed — don't emit dead links
const liveLeagues = new Set((predictions.tips ?? []).map((t) => slugify(t.league)));
const leagueHref = liveLeagues.has(slugify(league)) ? `/league/${slugify(league)}` : '/predictions';

const ai = (content.entries ?? {})[`match:${matchSlug({ home, away })}`];

const title = isLive
  ? `${home} vs ${away} Prediction, Odds & Betting Tip`
  : `${home} vs ${away} Prediction & Result${resultScore ? ` (${resultScore})` : ''}`;
const description = isLive
  ? `${home} vs ${away} (${league}) prediction: our tip is ${rec.text} at odds ${Number(rec.price ?? 0).toFixed(2)}. Best available odds compared across bookmakers.`
  : `${home} vs ${away} (${league}): our published tip was ${rec.text} at ${Number(rec.price ?? 0).toFixed(2)} — result: ${resWord.toLowerCase()}${resultScore ? `, final score ${resultScore}` : ''}. Every tip is archived and settled openly.`;

const bestOdds = Object.entries(tip?.best_h2h ?? {});

// additional model-scored markets for this fixture (from the screener feed)
const extraPicks = isLive
  ? (screener.rows ?? []).filter((r) => r.home === home && r.away === away && r.market !== rec.text)
      .sort((a, b) => (b.score ?? 0) - (a.score ?? 0))
  : [];

// form / H2H / standings from football-data.org + our own results archive
const sportKey = tip?.sport_key ?? latest?.sport_key ?? '';
const formHome = teamForm(sportKey, home);
const formAway = teamForm(sportKey, away);
const h2h = h2hBetween(sportKey, home, away);
const table = leagueTable(sportKey);
const hlNames = new Set([resolveTeam(sportKey, home), resolveTeam(sportKey, away)].filter(Boolean));
const shortDate = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: '2-digit', timeZone: 'UTC' });
const resCls2 = { W: 'w', L: 'l', D: 'v' };

// other fixtures from the live feed in the same league (mightytips-style widget)
const upcoming = (predictions.tips ?? [])
  .filter((t2) => t2.league === league && matchSlug(t2) !== slugify(`${home}-vs-${away}`))
  .sort((a, b) => String(a.kickoff).localeCompare(String(b.kickoff)))
  .slice(0, 8);
const upLabel = (iso) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) + ' ' + new Date(iso).toISOString().slice(11, 16) : '');
const px = (t2, k) => { const p = t2.best_h2h?.[k]?.price; return p ? Number(p).toFixed(2) : '—'; };

const eventSchema = {
  '@type': 'SportsEvent',
  name: `${home} vs ${away}`,
  startDate: kickoffIso,
  sport: 'Football',
  eventStatus: isLive ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventCompleted',
  competitor: [
    { '@type': 'SportsTeam', name: home },
    { '@type': 'SportsTeam', name: away },
  ],
  superEvent: { '@type': 'SportsOrganization', name: league },
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [eventSchema, ...(ai?.faq?.length ? [faqSchema(ai.faq)] : [])],
};
---
<Base title={title} description={description} schema={schema} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span>
        <a href="/predictions">Predictions</a><span>/</span>
        <a href={leagueHref}>{league}</a><span>/</span>
        {home} vs {away}
      </div>
      <h1>{home} vs {away} <em>{settled ? 'result' : 'prediction'}</em></h1>
      <p class="lead">
        {isLive
          ? `${league} · ${kickoff} — our model's pick, the best available price and how the market is priced.`
          : settled
            ? `${league} · kicked off ${kickedDate} — the tip we published before the match and how it settled.`
            : played
              ? `${league} · kicked off ${kickedDate} — our published tip, awaiting settlement against the final score.`
              : `${league} · kick-off ${kickedDate} — the tip we published ahead of this fixture.`}
      </p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <!-- Match + our tip -->
        <section>
          <div class="sec-head"><h2 class="sec-title">Our <b>{isLive ? 'prediction' : 'published tip'}</b></h2></div>
          <article class="pred">
            <div class="pred-top">
              <span class="pred-league"><span class="lg-logo">{tip?.sport_icon ?? '⚽'}</span> {league}</span>
              <span class="pred-when">🕒 {isLive ? kickoff : (played ? kickedDate : `kick-off ${kickedDate}`)}</span>
            </div>
            <div class="pred-body">
              <div class="match">
                <a class="team" href={`/team/${slugify(home)}`}>
                  <div class="badge" style={`background:${badgeColor(home)}`}>{abbr(home)}</div>
                  <div class="nm">{home}</div>
                </a>
                <div class="vs">{resultScore ?? 'VS'}</div>
                <a class="team" href={`/team/${slugify(away)}`}>
                  <div class="badge" style={`background:${badgeColor(away)}`}>{abbr(away)}</div>
                  <div class="nm">{away}</div>
                </a>
              </div>
              <div class="pred-tip">
                <div><div class="lbl">Our tip</div><div class="val">{rec.text}</div></div>
                <div class="odd-box"><div class="ot">Odds</div><div class="ov">{Number(rec.price ?? 0).toFixed(2)}</div></div>
              </div>
              {isLive ? (
                <div class="confidence">
                  <div class="cf-top"><span>Confidence</span><span class="pc">{label} · {conf}%</span></div>
                  <div class={`bar ${cls}`.trim()} data-val={conf}><i></i></div>
                </div>
              ) : (
                <div class="res-sum" style="margin:14px 0 0">
                  <div class={`res-chip ${latest?.status === 'won' ? 'win' : latest?.status === 'lost' ? 'lose' : ''}`}>
                    <b>{resWord}</b><span>Result</span>
                  </div>
                  {resultScore && <div class="res-chip"><b>{resultScore}</b><span>Final score</span></div>}
                  {settled && (
                    <div class={`res-chip ${profit > 0 ? 'win' : profit < 0 ? 'lose' : ''}`}>
                      <b>{profit > 0 ? '+' : ''}{profit.toFixed(2)}u</b><span>Profit</span>
                    </div>
                  )}
                  <div class="res-chip"><b>{conf}%</b><span>Pre-match conf.</span></div>
                </div>
              )}
            </div>
            <div class="pred-foot">
              <div class="by"><span class="ava">AI</span>
                {isLive
                  ? `Value edge ${rec.edge_pct ?? 0}% · best price at ${rec.bookmaker ?? '—'}`
                  : settled
                    ? `Settled against the final score — published pre-match at ${rec.bookmaker ?? '—'}`
                    : played
                      ? 'Awaiting settlement — graded automatically once the final score lands'
                      : 'Published ahead of the fixture — graded automatically after full time'}
              </div>
              {isLive
                ? <a href="#" class="btn btn-mint btn-sm">Bet at {rec.bookmaker ?? 'bookmaker'}</a>
                : <a href="/predictions" class="btn btn-outline btn-sm">Today's predictions →</a>}
            </div>
          </article>
        </section>

        <!-- Key factors behind the tip (AI, market-grounded) -->
        {ai?.key_factors?.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Key factors behind <b>our tip</b></h2></div>
            <div class="rsn-grid">
              {ai.key_factors.map((f, i) => (
                <div class="rsn"><div class="rn">{String(i + 1).padStart(2, '0')}</div><p>{f}</p></div>
              ))}
            </div>
          </section>
        )}

        <!-- Additional model-scored markets for this fixture -->
        {extraPicks.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Additional <b>predictions</b></h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">Market</th><th>Odds</th><th>Value edge</th><th>Confidence</th><th>AI score</th></tr></thead>
                <tbody>
                  {extraPicks.map((r) => (
                    <tr>
                      <td class="o-match" style="font-weight:700">{r.market}</td>
                      <td class="o-cell hot"><span class="cb">{Number(r.odds ?? 0).toFixed(2)}</span></td>
                      <td class="o-cell"><span class="cb">{(r.edge ?? 0) > 0 ? '+' : ''}{Number(r.edge ?? 0).toFixed(1)}%</span></td>
                      <td class="o-cell"><span class="cb">{r.confidence}%</span></td>
                      <td class="o-cell"><span class="cb">{r.score}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">Model-scored alternatives to the main tip — every market is ranked by value edge and win probability, not by potential payout.</p>
          </section>
        )}

        <!-- Team form: last 5 completed games per side -->
        {(formHome.length > 0 || formAway.length > 0) && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Team <b>form</b></h2></div>
            <div class="form-grid">
              {[{ name: home, list: formHome }, { name: away, list: formAway }].map((side) => (
                <div class="box">
                  <div class="box-h">
                    <span class="hi" style={`background:${badgeColor(side.name)};color:#fff;font-size:10px;font-weight:800`}>{abbr(side.name)}</span>
                    {side.name}
                    <span class="fm-letters">
                      {side.list.map((g) => <i class={`fm-l ${resCls2[g.res]}`}>{g.res}</i>)}
                    </span>
                  </div>
                  {side.list.length ? side.list.map((g) => (
                    <div class="fm-row">
                      <span class="fm-d">{shortDate(g.d)}</span>
                      <span class="fm-o">{g.ha === 'H' ? 'vs' : '@'} {g.opp}</span>
                      <span class={`fm-s ${resCls2[g.res]}`}>{g.score}</span>
                    </div>
                  )) : (
                    <div class="box-pad dim" style="font-size:12.5px">No completed games in our results dataset yet.</div>
                  )}
                </div>
              ))}
            </div>
            {formHome.length + formAway.length > 0 && formHome.length < 5 && formAway.length < 5 && (
              <p class="res-note">Form builds from completed fixtures in our dataset and fills out as the season progresses.</p>
            )}
          </section>
        )}

        <!-- Head-to-head from the results dataset -->
        {h2h.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Head-to-head: <b>{home} v {away}</b></h2></div>
            <div class="res-list">
              {h2h.map((g) => (
                <div class="res-row">
                  <span class={`res-mark ${resCls2[g.res]}`}>{g.res}</span>
                  <span class="res-date">{shortDate(g.d)}</span>
                  <div class="res-match"><b>{g.home} {g.score} {g.away}</b><span>{league}</span></div>
                  <span class="res-odds" style="visibility:hidden"></span>
                  <span class="res-profit zero"></span>
                </div>
              ))}
            </div>
            <p class="res-note">W/D/L shown from {home}'s perspective. Meetings from the seasons in our results dataset.</p>
          </section>
        )}

        <!-- Odds comparison (live fixtures only) -->
        {bestOdds.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Best <b>odds</b> across bookmakers</h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">Outcome</th><th>Best price</th><th>Bookmaker</th><th>Implied</th></tr></thead>
                <tbody>
                  {bestOdds.map(([name, info]) => (
                    <tr>
                      <td class="o-match" style="font-weight:700">{name}</td>
                      <td class="o-cell hot"><span class="cb">{Number(info.price).toFixed(2)}</span></td>
                      <td class="o-cell"><span>{info.bookmaker}</span></td>
                      <td class="o-cell"><span class="cb">{(100 / Number(info.price)).toFixed(1)}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
          </section>
        )}

        <!-- Unique AI-written preview per match (written pre-match; kept in the archive) -->
        <section class="seo">
          <h2>{home} vs {away}: {isLive ? 'match preview' : 'pre-match preview'}</h2>
          {ai ? (
            <>
              <p>{ai.intro}</p>
              <p><b>Verdict:</b> {ai.verdict}</p>
            </>
          ) : (
            <p>
              Our model {isLive ? 'makes' : 'made'} <b>{rec.text}</b> the value play in this {league} fixture, priced at
              <b> {Number(rec.price ?? 0).toFixed(2)}</b> with {rec.bookmaker ?? 'the market leader'}
              {isLive ? ` — an edge of ${rec.edge_pct ?? 0}% over the margin-free fair price, and a confidence rating of ${conf}%.` : '.'}
            </p>
          )}
          {!isLive && settled && (
            <p><b>How it settled:</b> the tip {latest.status === 'won' ? 'landed' : latest.status === 'lost' ? 'did not land' : 'was voided'}
              {resultScore ? ` — the match finished ${resultScore}` : ''}, for a flat-stake return of {profit > 0 ? '+' : ''}{profit.toFixed(2)} units.
              Every tip we publish is archived before kick-off and graded against the final score; nothing is edited or deleted afterwards.</p>
          )}
        </section>

        <!-- Our settled record on this fixture -->
        {record.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Our <b>record</b> on this fixture</h2></div>
            <div class="res-list">
              {record.map((h) => (
                <div class="res-row">
                  <span class={`res-mark ${h.status === 'won' ? 'w' : h.status === 'lost' ? 'l' : 'v'}`}>{h.status === 'won' ? 'W' : h.status === 'lost' ? 'L' : 'V'}</span>
                  <span class="res-date">{h.kickoff ? new Date(h.kickoff).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: '2-digit' }) : ''}</span>
                  <div class="res-match"><b>{h.market}</b><span>{h.score && h.score !== 'simulated' ? `final score ${h.score}` : h.league}</span></div>
                  <span class="res-odds">{Number(h.odds ?? 0).toFixed(2)}</span>
                  <span class={`res-profit ${(h.profit ?? 0) > 0 ? 'pos' : (h.profit ?? 0) < 0 ? 'neg' : 'zero'}`}>{(h.profit ?? 0) > 0 ? '+' : ''}{Number(h.profit ?? 0).toFixed(2)}u</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Other fixtures in this league from the live feed -->
        {upcoming.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Upcoming <b>{league} fixtures</b></h2>
              <a href={leagueHref} class="more-link">All {league} tips →</a>
            </div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th style="text-align:left">Kick-off (UTC)</th><th style="text-align:left">Match</th><th>1</th><th>X</th><th>2</th></tr></thead>
                <tbody>
                  {upcoming.map((t2) => (
                    <tr>
                      <td class="o-cell" style="white-space:nowrap"><span>{upLabel(t2.kickoff)}</span></td>
                      <td class="o-match" style="font-weight:700"><a href={`/predictions/${matchSlug(t2)}`} style="color:inherit;text-decoration:none">{t2.home} v {t2.away}</a></td>
                      <td class="o-cell"><span class="cb">{px(t2, t2.home)}</span></td>
                      <td class="o-cell"><span class="cb">{px(t2, 'Draw')}</span></td>
                      <td class="o-cell"><span class="cb">{px(t2, t2.away)}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">Best available 1X2 price per outcome across the bookmakers we track. Click a fixture for its full prediction.</p>
          </section>
        )}

        <!-- League table (once the season has rounds played) -->
        {table && (
          <section>
            <div class="sec-head"><h2 class="sec-title">{table.name} <b>standings</b></h2></div>
            <div class="odds-table"><div class="scr-scroll">
              <table class="otbl">
                <thead><tr><th>#</th><th style="text-align:left">Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>Pts</th></tr></thead>
                <tbody>
                  {table.rows.map((r) => (
                    <tr class={hlNames.has(r.team) ? 'hl' : ''}>
                      <td class="o-cell"><span>{r.pos}</span></td>
                      <td class="o-match" style="font-weight:700">{r.team}</td>
                      <td class="o-cell"><span>{r.p}</span></td>
                      <td class="o-cell"><span>{r.w}</span></td>
                      <td class="o-cell"><span>{r.d}</span></td>
                      <td class="o-cell"><span>{r.l}</span></td>
                      <td class="o-cell"><span>{r.gd > 0 ? `+${r.gd}` : r.gd}</span></td>
                      <td class="o-cell hot"><span class="cb">{r.pts}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <p class="res-note">Standings &amp; historical results via <a href="https://www.football-data.org" rel="nofollow noopener" target="_blank" style="color:inherit">football-data.org</a>, refreshed daily. Before a new season's opening round this shows the previous season's final table.</p>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">Match <b>FAQ</b></h2></div>
          <div class="faq">
            <div class="faq-item open">
              <div class="faq-q">{isLive ? `What is the prediction for ${home} vs ${away}?` : `What was our prediction for ${home} vs ${away}?`}<span class="pm">+</span></div>
              <div class="faq-a"><p>Our tip {isLive ? 'is' : 'was'} <b>{rec.text}</b> at odds of {Number(rec.price ?? 0).toFixed(2)}{isLive ? `, with a ${conf}% confidence rating.` : '.'}</p></div>
            </div>
            {(ai?.faq ?? []).map((f) => (
              <div class="faq-item">
                <div class="faq-q">{f.q}<span class="pm">+</span></div>
                <div class="faq-a"><p>{f.a}</p></div>
              </div>
            ))}
            {isLive ? (
              <div class="faq-item">
                <div class="faq-q">When does the match kick off?<span class="pm">+</span></div>
                <div class="faq-a"><p>{home} vs {away} takes place {kickoff} in the {league}.</p></div>
              </div>
            ) : (
              <div class="faq-item">
                <div class="faq-q">Did the tip win?<span class="pm">+</span></div>
                <div class="faq-a"><p>{settled
                  ? `The tip ${latest.status === 'won' ? 'won' : latest.status === 'lost' ? 'lost' : 'was voided'}${resultScore ? ` — final score ${resultScore}` : ''} (${profit > 0 ? '+' : ''}${profit.toFixed(2)}u at flat stakes).`
                  : 'The match has not been settled yet — the result is graded automatically once the final score is available.'}</p></div>
              </div>
            )}
          </div>
        </section>

      </main>

      <aside class="sidebar">
        {isLive ? (
          <div class="promo">
            <h4>🎯 Best price</h4>
            <p>{rec.text} @ {Number(rec.price ?? 0).toFixed(2)} at {rec.bookmaker ?? '—'}.</p>
            <a href="#" class="btn btn-mint btn-block">Bet now</a>
          </div>
        ) : (
          <div class="promo">
            <h4>🔍 Live value picks</h4>
            <p>This match is settled — see where our model finds value today.</p>
            <a href="/screener" class="btn btn-mint btn-block">Open the AI screener</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> More {league}</div>
          <a class="tm" href={leagueHref}><span class="dot"></span>All {league} tips</a>
          <a class="tm" href="/predictions"><span class="dot"></span>Today's predictions</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
