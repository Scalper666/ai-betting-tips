---
import ResultsView from '../../views/ResultsView.astro';
import { resultsPaths } from '../../lib/dataPages.js';

export function getStaticPaths() {
  return resultsPaths().map(({ slug, sk }) => ({ params: { slug }, props: { sk } }));
}
const { sk } = Astro.props;
---
<ResultsView sk={sk} lang="en" />
