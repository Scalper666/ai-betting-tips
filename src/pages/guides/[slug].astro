---
import Base from '../../layouts/Base.astro';
import guidesData from '../../data/guides.json';
import glossary from '../../data/glossary.json';
import { faqSchema } from '../../lib/utils.js';

// ── Betting guides: editor-written long-form articles (no API cost).
//    Informational-intent layer above the glossary: each guide interlinks
//    live tools, glossary terms and the prediction hubs.
export function getStaticPaths() {
  const list = guidesData.guides ?? [];
  return list.map((g, i) => ({
    params: { slug: g.slug },
    props: { g, prev: list[i - 1] ?? null, next: list[i + 1] ?? null },
  }));
}

const { g, prev, next } = Astro.props;
const bySlug = Object.fromEntries((guidesData.guides ?? []).map((x) => [x.slug, x]));
const related = (g.related ?? []).map((s) => bySlug[s]).filter(Boolean);
const glossaryBySlug = Object.fromEntries((glossary.terms ?? []).map((t) => [t.slug, t]));
const glossaryChips = (g.glossary ?? []).map((s) => glossaryBySlug[s]).filter(Boolean);

const title = `${g.title} — Free Guide`;
const description = g.desc;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: g.title,
      description: g.desc,
      articleSection: g.cat,
      author: { '@type': 'Organization', name: 'AI Betting Tips', url: 'https://ai-betting-tips.com/about/' },
      publisher: { '@type': 'Organization', name: 'AI Betting Tips' },
      mainEntityOfPage: `https://ai-betting-tips.com/guides/${g.slug}/`,
    },
    ...(g.faq?.length ? [faqSchema(g.faq)] : []),
  ],
};
---
<Base title={title} description={description} schema={schema} active="">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span>
        <a href="/guides">Guides</a><span>/</span>
        {g.nav}
      </div>
      <h1>{g.title}</h1>
      <p class="lead">{g.desc}</p>
      <div class="chips" style="margin:12px 0 0">
        <span class="chip" style="cursor:default">📖 {g.cat}</span>
        <span class="chip" style="cursor:default">⏱ {g.minutes} min read</span>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <section class="prose" style="padding:0;max-width:none">
          {g.sections.map((s) => (
            <>
              <h2>{s.h}</h2>
              {s.ps.map((p) => <p>{p}</p>)}
            </>
          ))}

          {g.example && (
            <div class="gl-example">
              <div class="gl-ex-label">Worked example</div>
              <p style="margin:0">{g.example}</p>
            </div>
          )}

          <div class="note">
            <strong>Key takeaways</strong>
            <ul style="margin:10px 0 0">
              {g.takeaways.map((t) => <li>{t}</li>)}
            </ul>
          </div>

          {g.faq?.length > 0 && (
            <>
              <h2>Frequently asked questions</h2>
              {g.faq.map((f) => (
                <>
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </>
              ))}
            </>
          )}
        </section>

        {(related.length > 0 || glossaryChips.length > 0) && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Keep <b>reading</b></h2></div>
            <div class="chips" style="margin-bottom:0">
              {related.map((r) => <a class="chip" href={`/guides/${r.slug}`}>📗 {r.nav}</a>)}
              {glossaryChips.map((t) => <a class="chip" href={`/glossary/${t.slug}`}>📖 {t.term}</a>)}
            </div>
          </section>
        )}

        <section>
          <div class="res-sum">
            {prev && <a class="res-chip" href={`/guides/${prev.slug}`} style="text-decoration:none"><b>←</b><span>{prev.nav}</span></a>}
            <a class="res-chip" href="/guides" style="text-decoration:none"><b>📚</b><span>all guides</span></a>
            {next && <a class="res-chip" href={`/guides/${next.slug}`} style="text-decoration:none"><b>→</b><span>{next.nav}</span></a>}
          </div>
        </section>
      </main>

      <aside class="sidebar">
        {(g.tools ?? []).length > 0 && (
          <div class="promo">
            <h4>🔗 See it in action</h4>
            <p>{g.tools[0].label}</p>
            <a href={g.tools[0].href} class="btn btn-mint btn-block">Open</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">📚</span> All guides</div>
          {(guidesData.guides ?? []).map((x) => (
            <a class="tm" href={`/guides/${x.slug}`} aria-current={x.slug === g.slug ? 'page' : undefined}>
              <span class="dot"></span>{x.nav}
            </a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> Put it to work</div>
          <a class="tm" href="/predictions"><span class="dot"></span>Today's predictions</a>
          <a class="tm" href="/screener"><span class="dot"></span>AI value screener</a>
          <a class="tm" href="/tools"><span class="dot"></span>Betting calculators</a>
          <a class="tm" href="/glossary"><span class="dot"></span>Glossary A–Z</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
