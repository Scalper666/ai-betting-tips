---
import Base from '../layouts/Base.astro';
import PredCard from '../components/PredCard.astro';
import BookmakerRow from '../components/BookmakerRow.astro';
import TipsterCards from '../components/TipsterCards.astro';
import predictions from '../data/predictions.json';
import screener from '../data/screener.json';
import stats from '../data/stats.json';
import bookmakers from '../data/bookmakers.json';
import historyData from '../data/history.json';
import countriesData from '../data/countries.json';
import { slugify, avgScore, kickoffLabel, matchSlug, AVATAR_STYLES, signed } from '../lib/utils.js';

const tips = predictions.tips ?? [];
const football = tips.filter((t) => String(t.sport_key ?? '').startsWith('soccer'));
const featured = (football.length ? football : tips).slice(0, 6);
const chipLeagues = [...new Set(featured.map((t) => t.league))];

// screener preview: top 6 by AI score
const scrTop = [...(screener.rows ?? [])].sort((a, b) => b.score - a.score).slice(0, 6);
// score >= 45 means the pick has a positive edge (see pipeline ai_score) — green zone
const scoreCls = (s) => (s >= 45 ? 's-hi' : s >= 30 ? 's-md' : 's-lo');

// bookmakers ranked by computed score
const bkList = [...(bookmakers.bookmakers ?? [])].sort((a, b) => avgScore(b.scores) - avgScore(a.scores));
const topBk = bkList[0];

// news feed: previews derived from the pipeline (top-confidence football first)
const newsTips = [...football].sort((a, b) => (b.recommendation?.confidence ?? 0) - (a.recommendation?.confidence ?? 0));
const featureTip = newsTips[0];
const newsCards = newsTips.slice(1, 5);
const NEWS_THUMBS = [
  'linear-gradient(135deg,#1d2a4d,#0c1429)',
  'linear-gradient(135deg,#2a4d1d,#14290c)',
  'linear-gradient(135deg,#4d1d2a,#290c14)',
  'linear-gradient(135deg,#3a2a1d,#22160c)',
];

// sidebar: league counts
const leagueCounts = {};
for (const t of tips) leagueCounts[t.league] = (leagueCounts[t.league] ?? 0) + 1;
const topLeagues = Object.entries(leagueCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);

// sidebar: interactive match calendar (client script below).
// Each fixture carries date + kickoff time + teams + link so a day click lists its matches.
const SPORT_META = {
  soccer: { label: 'Football', icon: '⚽' },
  basketball: { label: 'Basketball', icon: '🏀' },
  americanfootball: { label: 'Am. Football', icon: '🏈' },
  baseball: { label: 'Baseball', icon: '⚾' },
  icehockey: { label: 'Ice Hockey', icon: '🏒' },
  tennis: { label: 'Tennis', icon: '🎾' },
};
const sportMeta = (key) => {
  const k = String(key ?? '');
  for (const pre in SPORT_META) if (k.startsWith(pre)) return SPORT_META[pre];
  return { label: 'Other', icon: '🎯' };
};
const calMatches = tips.map((t) => {
  const d = new Date(t.kickoff);
  if (isNaN(d)) return null;
  const pad = (n) => String(n).padStart(2, '0');
  return {
    d: `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`,
    t: `${pad(d.getHours())}:${pad(d.getMinutes())}`,
    home: t.home,
    away: t.away,
    lg: t.league_short || t.league,
    sport: sportMeta(t.sport_key).label,
    href: `/predictions/${matchSlug(t)}`,
  };
}).filter(Boolean).sort((a, b) => a.d.localeCompare(b.d) || a.t.localeCompare(b.t));
const calSports = [...new Set(calMatches.map((m) => m.sport))].sort();
const calSportOpts = calSports.map((label) => {
  const icon = Object.values(SPORT_META).find((s) => s.label === label)?.icon ?? '🎯';
  return { label, icon };
});

const miniTipsters = (stats.tipsters ?? []).slice(0, 3);

// Tipster cards are hidden until enough REAL settled history accumulates —
// early numbers mixed mock-era settlements, which clashed with the honesty pitch.
const SHOW_TIPSTERS = false;

// settlement transparency: latest graded bets from the pipeline archive.
// Every published tip lands in history.json; results.py grades it once the
// match finishes — this block simply surfaces that log, wins and losses alike.
const settled = Object.values(historyData.tips ?? {})
  .filter((t) => ['won', 'lost', 'void'].includes(t.status))
  .sort((a, b) => String(b.settled_at ?? '').localeCompare(String(a.settled_at ?? '')));
const resRows = settled.slice(0, 8);
const resSum = {
  won: settled.filter((t) => t.status === 'won').length,
  lost: settled.filter((t) => t.status === 'lost').length,
  voids: settled.filter((t) => t.status === 'void').length,
  profit: Math.round(settled.reduce((s, t) => s + (t.profit ?? 0), 0) * 100) / 100,
};
// mock-phase settlements are labelled honestly until real ones replace them
const resDemo = resRows.length > 0 && resRows.every((t) => t.score === 'simulated');
const resDate = (t) => {
  const d = new Date(t.kickoff ?? t.settled_at);
  return isNaN(d) ? '' : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
};

// geo block: country list for the client-side detector
const geoCountries = (countriesData.countries ?? []).map((c) => ({ slug: c.slug, name: c.name, flag: c.flag }));

// Acca of the day: the three most probable picks from different matches.
// Confidence-first keeps the combined price in sane acca territory (~3–6x)
// instead of multiplying longshot value picks into a 50x+ lottery ticket.
const accaLegs = [];
const accaSeen = new Set();
for (const r of [...(screener.rows ?? [])].sort((a, b) => b.confidence - a.confidence)) {
  const k = `${r.home}|${r.away}`;
  if (accaSeen.has(k) || Number(r.odds) < 1.3) continue;
  accaSeen.add(k);
  accaLegs.push(r);
  if (accaLegs.length === 3) break;
}
const accaOdds = accaLegs.reduce((p, r) => p * (Number(r.odds) || 1), 1);
const accaValue = accaLegs.length > 0 && accaLegs.every((r) => r.edge > 0);
---
<Base
  title="AI Betting Tips — Expert Sports Betting Tips, Predictions & Bookmaker Reviews"
  description="Free daily football predictions with real value edges, verified tipster stats, an AI screener and honest bookmaker reviews.">

  <!-- HERO (compact) -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Win more with <span class="g">expert betting tips</span> you can actually trust</h1>
          <div class="hero-cta">
            <a href="/predictions" class="btn btn-mint">⚽ Today's Free Tips</a>
            <a href="/tipsters" class="btn btn-outline">Meet our tipsters</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="layout">
      <main class="content">

        <!-- TOP BOOKMAKERS (geo-aware: client script swaps country when detected) -->
        <section id="geoBk" data-geo={JSON.stringify(geoCountries)} data-current="uk">
          <div class="sec-head">
            <h2 class="sec-title">Top bookmakers in <b data-geo-name>🇬🇧 United Kingdom</b></h2>
            <a href="/countries/uk" class="more-link" data-geo-link>Change country →</a>
          </div>
          <div class="geo-note"><span class="fl">🇬🇧</span> <span data-geo-lead>Ranked for players in</span> <b>United Kingdom</b><span data-geo-tail></span> · <a href="/countries/uk" data-geo-link style="color:var(--mint);font-weight:700">change country</a></div>
          <div class="bk-list">
            {bkList.map((bk, i) => (
              <div class="bk-geo" data-cn={(bk.countries ?? []).join(' ')}>
                <BookmakerRow bk={bk} rank={i + 1} />
              </div>
            ))}
          </div>
        </section>
        <script is:inline>
          (function () {
            var sec = document.getElementById('geoBk'); if (!sec) return;
            var LIST = []; try { LIST = JSON.parse(sec.getAttribute('data-geo') || '[]'); } catch (e) {}
            var ISO = { GB: 'uk', DE: 'de', IN: 'in', NG: 'ng' };
            // timezone -> ISO country (offline first guess; trace refines on the live site)
            var TZ_CC = { 'Europe/London': 'GB', 'Europe/Berlin': 'DE', 'Europe/Busingen': 'DE',
                          'Asia/Kolkata': 'IN', 'Asia/Calcutta': 'IN', 'Africa/Lagos': 'NG',
                          'Europe/Moscow': 'RU', 'Europe/Kyiv': 'UA', 'Europe/Kiev': 'UA',
                          'Europe/Minsk': 'BY', 'Asia/Almaty': 'KZ', 'Europe/Warsaw': 'PL',
                          'Europe/Madrid': 'ES', 'Europe/Rome': 'IT', 'Europe/Paris': 'FR',
                          'America/Sao_Paulo': 'BR', 'Asia/Dubai': 'AE', 'Europe/Istanbul': 'TR' };
            // honest fallback when we detect a country we have no dedicated list for
            function applyForeign(cc) {
              if (!cc || cc === 'GB' || ISO[cc]) return;
              var name = cc, flag = '🌍';
              try { name = new Intl.DisplayNames(['en'], { type: 'region' }).of(cc) || cc; } catch (e) {}
              try { flag = cc.replace(/./g, function (c) { return String.fromCodePoint(127397 + c.charCodeAt(0)); }); } catch (e) {}
              var nameEl = sec.querySelector('[data-geo-name]');
              if (nameEl) nameEl.textContent = '🌍 our international ranking';
              var note = sec.querySelector('.geo-note');
              if (note) {
                var fl = note.querySelector('.fl'); if (fl) fl.textContent = flag;
                var lead = note.querySelector('[data-geo-lead]'); if (lead) lead.textContent = 'Browsing from';
                var b = note.querySelector('b'); if (b) b.textContent = name;
                var tail = note.querySelector('[data-geo-tail]');
                if (tail) tail.textContent = ' — no dedicated ' + name + ' edition yet, so this is our international list';
              }
              sec.setAttribute('data-current', 'intl:' + cc);
            }
            function route(cc) {
              if (!cc) return;
              if (ISO[cc]) apply(ISO[cc]);
              else applyForeign(cc);
            }
            function apply(slug) {
              if (!slug || slug === sec.getAttribute('data-current')) return;
              var c = null;
              for (var i = 0; i < LIST.length; i++) if (LIST[i].slug === slug) c = LIST[i];
              if (!c) return;                       // no data for this country — keep default
              var rows = [].slice.call(sec.querySelectorAll('[data-cn]'));
              var match = rows.filter(function (r) { return (' ' + r.getAttribute('data-cn') + ' ').indexOf(' ' + slug + ' ') >= 0; });
              if (!match.length) return;            // never leave the block empty
              rows.forEach(function (r) { r.hidden = match.indexOf(r) < 0; });
              match.forEach(function (r, i) { var rk = r.querySelector('.bk-rank'); if (rk) rk.textContent = i + 1; });
              var name = sec.querySelector('[data-geo-name]'); if (name) name.textContent = c.flag + ' ' + c.name;
              var note = sec.querySelector('.geo-note');
              if (note) {
                var fl = note.querySelector('.fl'); if (fl) fl.textContent = c.flag;
                var b = note.querySelector('b'); if (b) b.textContent = c.name;
              }
              [].forEach.call(sec.querySelectorAll('[data-geo-link]'), function (a) { a.setAttribute('href', '/countries/' + slug); });
              sec.setAttribute('data-current', slug);
            }
            // 1) instant offline guess from the browser timezone
            try { var tz = Intl.DateTimeFormat().resolvedOptions().timeZone; route(TZ_CC[tz]); } catch (e) {}
            // 2) refine via Cloudflare edge geo (authoritative on the live site)
            try {
              fetch('/cdn-cgi/trace').then(function (r) { return r.ok ? r.text() : ''; }).then(function (t) {
                var m = /loc=([A-Z]{2})/.exec(t || ''); if (m) route(m[1]);
              }).catch(function () {});
            } catch (e) {}
          })();
        </script>

        <!-- FREE FOOTBALL PREDICTIONS -->
        <section data-filter-scope="preds">
          <div class="sec-head">
            <h2 class="sec-title">Free football <b>predictions</b></h2>
            <a href="/predictions" class="more-link">All predictions →</a>
          </div>
          <div class="filter-bar">
            <div class="chips day-tabs" data-day-tabs>
              <span class="chip active" data-day="all">🗓 All days</span>
              <span class="chip" data-day="today">Today <b class="n"></b></span>
              <span class="chip" data-day="tomorrow">Tomorrow <b class="n"></b></span>
            </div>
            <span class="chip-sep" aria-hidden="true"></span>
            <div class="chips" data-chip-group="preds">
              <span class="chip active" data-filter="all"><span class="ic">⚡</span> All</span>
              {chipLeagues.map((lg) => (
                <span class="chip" data-filter={slugify(lg)}><span class="ic">🏆</span> {lg}</span>
              ))}
            </div>
          </div>
          <div class="pred-grid">
            {featured.map((tip) => <PredCard tip={tip} />)}
          </div>
        </section>
        <script is:inline>
          (function () {
            var tabs = document.querySelector('[data-day-tabs]'); if (!tabs) return;
            var cards = [].slice.call(document.querySelectorAll('[data-filter-scope="preds"] [data-kickoff]'));
            function key(d) { return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
            var now = new Date(), today = key(now), tomorrow = key(new Date(now.getTime() + 864e5));
            cards.forEach(function (c) {
              var d = new Date(c.getAttribute('data-kickoff'));
              var k = isNaN(d) ? '' : key(d);
              c.setAttribute('data-day', k === today ? 'today' : k === tomorrow ? 'tomorrow' : 'later');
            });
            ['today', 'tomorrow'].forEach(function (v) {
              var n = tabs.querySelector('[data-day="' + v + '"] .n');
              if (n) n.textContent = cards.filter(function (c) { return c.getAttribute('data-day') === v; }).length;
            });
            tabs.addEventListener('click', function (e) {
              var b = e.target.closest('[data-day]'); if (!b) return;
              [].forEach.call(tabs.querySelectorAll('.chip'), function (c) { c.classList.remove('active'); });
              b.classList.add('active');
              var v = b.getAttribute('data-day');
              cards.forEach(function (c) {
                if (v === 'all' || c.getAttribute('data-day') === v) c.removeAttribute('data-day-off');
                else c.setAttribute('data-day-off', '');
              });
            });
          })();
        </script>

        <!-- ACCA OF THE DAY (auto-built from the top screener picks) -->
        {accaLegs.length >= 2 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Acca of the <b>day</b></h2>
              <span class="acca-total">Combined odds <b>{accaOdds.toFixed(2)}</b></span>
            </div>
            <div class="acca">
              {accaLegs.map((r) => (
                <div class="acca-leg">
                  <span class="acca-ic">{r.icon}</span>
                  <div class="acca-m">
                    <b>{r.home} — {r.away}</b>
                    <span>{r.league} · {kickoffLabel(r.kickoff)}</span>
                  </div>
                  <span class="acca-pick">{r.market}</span>
                  <span class="acca-odds">{Number(r.odds).toFixed(2)}</span>
                </div>
              ))}
              <div class="acca-foot">
                <span>{accaValue
                  ? 'All legs carry a positive value edge from the AI screener.'
                  : 'Built automatically from the highest-probability picks on today’s board.'}</span>
                <a href="/screener" class="btn btn-mint btn-sm">Open screener · ×{accaOdds.toFixed(2)}</a>
              </div>
            </div>
            <p class="res-note">18+ · Combined bets multiply the risk as well as the odds — stake responsibly.</p>
          </section>
        )}

        <!-- AI SCREENER PREVIEW -->
        <section>
          <div class="sec-head">
            <h2 class="sec-title">AI value <b>screener</b></h2>
            <a href="/screener" class="more-link">Open full screener →</a>
          </div>
          <div class="scr-table-wrap">
            <div class="scr-scroll">
              <table class="scr-table scr-mini">
                <thead><tr><th class="num">Score</th><th>Match</th><th>Our tip</th><th class="num">Odds</th><th class="num">Edge</th></tr></thead>
                <tbody>
                  {scrTop.map((r) => (
                    <tr>
                      <td class="num"><span class={`score-badge ${scoreCls(r.score)}`}>{r.score}</span></td>
                      <td><div class="scr-match"><span class="ic">{r.icon}</span><div class="mt"><b>{r.home} v {r.away}</b><span class="lg">{r.league}</span></div></div></td>
                      <td class="scr-tip">{r.market}</td>
                      <td class="num scr-odds">{Number(r.odds).toFixed(2)}</td>
                      <td class={`num edge ${r.edge > 0 ? 'pos' : 'neg'}`}>{r.edge > 0 ? '+' : ''}{r.edge}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <a href="/screener" class="btn btn-outline btn-block" style="margin-top:12px">🔍 See all value bets in the AI screener →</a>
        </section>

        <!-- RECENT RESULTS (settlement transparency from history.json) -->
        {resRows.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Recent <b>results</b></h2>
              <a href="/tipsters" class="more-link">Tipster stats →</a>
            </div>
            <div class="res-sum">
              <div class="res-chip"><b>{settled.length}</b><span>Settled</span></div>
              <div class="res-chip win"><b>{resSum.won}</b><span>Won</span></div>
              <div class="res-chip lose"><b>{resSum.lost}</b><span>Lost</span></div>
              <div class="res-chip"><b>{resSum.voids}</b><span>Void</span></div>
              <div class={`res-chip ${resSum.profit >= 0 ? 'win' : 'lose'}`}><b>{signed(resSum.profit)}u</b><span>Profit</span></div>
            </div>
            <div class="res-list">
              {resRows.map((t) => (
                <div class="res-row">
                  <span class={`res-mark ${t.status === 'won' ? 'w' : t.status === 'lost' ? 'l' : 'v'}`}>{t.status === 'won' ? 'W' : t.status === 'lost' ? 'L' : 'V'}</span>
                  <span class="res-date">{resDate(t)}</span>
                  <div class="res-match"><b>{t.home} v {t.away}</b><span>{t.market} · {t.league}</span></div>
                  <span class="res-odds">{Number(t.odds ?? 0).toFixed(2)}</span>
                  <span class={`res-profit ${(t.profit ?? 0) > 0 ? 'pos' : (t.profit ?? 0) < 0 ? 'neg' : 'zero'}`}>{signed(Math.round((t.profit ?? 0) * 100) / 100)}u</span>
                </div>
              ))}
            </div>
            <p class="res-note">
              Every published tip is archived and graded against final scores — wins and losses alike, nothing is deleted.
              {resDemo && <span class="res-demo"> These entries are simulated from a test run; real settlements replace them automatically.</span>}
            </p>
          </section>
        )}

        <!-- BET TYPES -->
        <section>
          <div class="sec-head">
            <h2 class="sec-title">Popular <b>bet types</b></h2>
            <a href="/predictions" class="more-link">Explore all →</a>
          </div>
          <div class="bt-grid">
            <a href="/tips/accumulator" class="bt-tile"><div class="ic">🎯</div><div><h4>Accumulators</h4><p>Daily acca tips, 5–20 odds</p></div><span class="arr">→</span></a>
            <a href="/tips/btts" class="bt-tile"><div class="ic">⚽</div><div><h4>Both Teams To Score</h4><p>BTTS predictions</p></div><span class="arr">→</span></a>
            <a href="/tips/over-under" class="bt-tile"><div class="ic">📊</div><div><h4>Over / Under Goals</h4><p>Totals 1.5 / 2.5 / 3.5</p></div><span class="arr">→</span></a>
            <a href="/tips/correct-score" class="bt-tile"><div class="ic">🔢</div><div><h4>Correct Score</h4><p>High-odds exact scores</p></div><span class="arr">→</span></a>
            <a href="/tips/double-chance" class="bt-tile"><div class="ic">🛡️</div><div><h4>Double Chance</h4><p>Safer low-risk picks</p></div><span class="arr">→</span></a>
            <a href="/tips/draw" class="bt-tile"><div class="ic">🤝</div><div><h4>Draw Tips</h4><p>Value on tight games</p></div><span class="arr">→</span></a>
          </div>
        </section>

        <!-- TOP TIPSTERS — hidden until enough real settled history accumulates
             (early numbers mixed mock-era settlements; flip SHOW_TIPSTERS to bring back) -->
        {SHOW_TIPSTERS && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">This month's top <b>tipsters</b></h2>
              <a href="/tipsters" class="more-link">Full leaderboard →</a>
            </div>
            <TipsterCards limit={3} />
          </section>
        )}

        <!-- BONUSES (from bookmakers.json) -->
        <section>
          <div class="sec-head">
            <h2 class="sec-title">Best betting <b>bonuses</b></h2>
            <a href="/bonuses" class="more-link">All bonuses →</a>
          </div>
          <div class="bonus-grid">
            {bkList.slice(0, 4).map((bk) => (
              <div class="bonus-card">
                <div class="bonus-thumb" style={`background:linear-gradient(135deg,${bk.logo.bg},#06101f)`}>
                  {bk.bonus.type === 'free-bet' ? '💸' : '🎁'}
                  <div class="bonus-logo" style={`background:${bk.logo.bg};color:${bk.logo.fg}`}>{bk.logo.line1.slice(0, 2)}</div>
                </div>
                <div class="bonus-body">
                  <div class="bt">{bk.name} · {bk.bonus.type === 'free-bet' ? 'Free bet' : 'Welcome'}</div>
                  <div class="bn">{bk.bonus.headline}</div>
                  <div class="bonus-foot">
                    <a href={`/bookmakers/${bk.slug}`} class="btn btn-ghost btn-sm">Details</a>
                    <a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">Claim</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- WHY US -->
        <section>
          <div class="sec-head"><h2 class="sec-title">Why <b>AI Betting Tips</b></h2></div>
          <div class="feat-grid">
            <div class="feat"><div class="fi">✅</div><h4>Verified tipster stats</h4><p>Every tip is archived and settled against real results. No cherry-picking — win rate and ROI come from graded bets only.</p></div>
            <div class="feat v"><div class="fi">🔍</div><h4>Honest bookmaker reviews</h4><p>Operators are scored on six criteria and ranked by the score — nobody buys a higher position.</p></div>
            <div class="feat"><div class="fi">🆓</div><h4>Always free</h4><p>All daily predictions, the screener and analysis are completely free. No paywalls, no premium upsells.</p></div>
          </div>
        </section>

        <!-- NEWS / MATCH PREVIEWS -->
        {featureTip && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Latest <b>news &amp; analysis</b></h2>
              <a href="/news" class="more-link">All news →</a>
            </div>
            <div class="feature-article" style="margin-bottom:16px">
              <div class="fa-img" style="background:linear-gradient(135deg,#0b1f3a,#102a52)">🏆</div>
              <div class="fa-body">
                <span class="tag">{featureTip.league}</span>
                <h2>{featureTip.home} vs {featureTip.away}: preview, prediction &amp; best bets</h2>
                <p>Our model makes {featureTip.recommendation?.text} the value play at {Number(featureTip.recommendation?.price ?? 0).toFixed(2)} — full reasoning, odds comparison and confidence inside.</p>
                <a href={`/predictions/${matchSlug(featureTip)}`} class="btn btn-mint">Read full preview</a>
              </div>
            </div>
            <div class="news-grid">
              {newsCards.map((t, i) => (
                <div class="news-card">
                  <div class="news-thumb" style={`background:${NEWS_THUMBS[i % NEWS_THUMBS.length]}`}>⚽<span class="tag">{t.league}</span><span class="when">{kickoffLabel(t.kickoff)}</span></div>
                  <div class="news-body">
                    <h4><a href={`/predictions/${matchSlug(t)}`}>{t.home} vs {t.away}: prediction &amp; best odds</a></h4>
                    <div class="nf"><span>AI Betting Tips model</span><span class="read">Read →</span></div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- SEO TEXT -->
        <section class="seo">
          <h2>AI Betting Tips — your home for free sports betting tips &amp; predictions</h2>
          <div class="clamp" id="seoClamp">
            <p>AI Betting Tips is an independent sports betting tips and predictions portal built for bettors who want an edge backed by data, not hype. Every pick is generated from live bookmaker odds: we strip the margin to get a fair probability, then flag the selections where the best available price beats that fair line.</p>
            <h3>Predictions you can verify</h3>
            <p>Unlike most tipster sites, every tip we publish is archived the moment it goes live and settled automatically against the final score. The win rate, ROI and profit figures you see on tipster profiles are computed from those graded bets — nothing is hand-written, and losing runs are never quietly deleted.</p>
            <h3>Independent bookmaker reviews</h3>
            <p>Our reviews score each operator on odds quality, market depth, payout speed, mobile app, bonus value and support. Rankings follow the score. Reviews are organised by market so you can quickly find the best legal option for your country.</p>
            <h3>Bet responsibly</h3>
            <p>Sports betting should always be entertainment, never a way to make money or chase losses. Our predictions are statistical opinions, not guarantees. Only ever stake what you can comfortably afford to lose, set limits, and if betting stops being enjoyable, seek help from a support organisation in your country. You must be 18+ to bet.</p>
          </div>
          <span class="read-more" data-clamp-toggle="seoClamp">Read more ▾</span>
        </section>

      </main>

      <!-- SIDEBAR -->
      <aside class="sidebar">

        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> Live &amp; Upcoming</div>
          {topLeagues.map(([lg, n]) => (
            <a class="tm" href={`/league/${slugify(lg)}`}><span class="dot"></span>{lg} <span class="cnt">{n}</span></a>
          ))}
        </div>

        <div class="box">
          <div class="box-h"><span class="hi">🏆</span> Top Bookmakers</div>
          {bkList.slice(0, 3).map((bk, i) => (
            <div class={`bk-mini${i === 0 ? ' top' : ''}`}>
              <a class="mini-tip" href={`/bookmakers/${bk.slug}`}>
                <div class="ava" style={`background:${bk.logo.bg};color:${bk.logo.fg}`}>
                  {bk.logo.line1.slice(0, 2)}
                  {i === 0 && <span class="rank1">1</span>}
                </div>
                <div><h5>{bk.name}</h5><div class="mt-sp">★ {bk.rating}{i === 0 ? ' · Top pick' : ''}</div></div>
                <div class="mt-roi"><b>{avgScore(bk.scores)}</b><span>Score</span></div>
              </a>
              <div class="mt-tc">18+ · T&amp;C apply · <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank">GambleAware.org</a></div>
            </div>
          ))}
        </div>

        {topBk && (
          <div class="promo">
            <h4>🎁 {topBk.bonus.headline.split(' + ')[0]}</h4>
            <p>Top-rated {topBk.name} gives new players {topBk.bonus.headline.toLowerCase()}.</p>
            <a href={`/bookmakers/${topBk.slug}`} class="btn btn-mint btn-block">Claim bonus</a>
          </div>
        )}

        <div class="box" id="matchCal" data-matches={JSON.stringify(calMatches)}>
          <div class="box-h"><span class="hi">📅</span> Match Calendar</div>
          <div class="cal-top">
            {calSportOpts.length > 0 ? (
              <select class="cal-sel" data-cal-sport aria-label="Filter calendar by sport">
                {calSportOpts.length > 1 && <option value="">🗓 All sports</option>}
                {calSportOpts.map((s) => <option value={s.label}>{s.icon} {s.label}</option>)}
              </select>
            ) : (
              <div class="cal-sel cal-sel-static">🗓 All sports</div>
            )}
          </div>
          <div class="cal-nav">
            <button type="button" data-cal-prev aria-label="Previous month">‹</button>
            <span data-cal-label>—</span>
            <button type="button" data-cal-next aria-label="Next month">›</button>
          </div>
          <div class="cal-grid" data-cal-grid></div>
          <div class="cal-list" data-cal-list hidden></div>
        </div>
        <script is:inline>
          (function () {
            var el = document.getElementById('matchCal');
            if (!el) return;
            var matches = [];
            try { matches = JSON.parse(el.getAttribute('data-matches') || '[]'); } catch (e) {}
            var grid = el.querySelector('[data-cal-grid]');
            var label = el.querySelector('[data-cal-label]');
            var list = el.querySelector('[data-cal-list]');
            var sportSel = el.querySelector('[data-cal-sport]');
            var now = new Date();
            var y = now.getFullYear(), m = now.getMonth();
            var sel = null;
            var DOW = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
            var MON = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            function pad(n) { return (n < 10 ? '0' : '') + n; }
            function key(yy, mm, dd) { return yy + '-' + pad(mm + 1) + '-' + pad(dd); }
            function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
            function activeSport() { return sportSel ? sportSel.value : ''; }
            function byDay() {
              var s = activeSport(), o = {};
              matches.forEach(function (mm) { if (s && mm.sport !== s) return; (o[mm.d] = o[mm.d] || []).push(mm); });
              return o;
            }
            var listExpanded = false;   // long days (20+ fixtures) start collapsed to 6 rows
            function renderList(day) {
              if (!day) { list.hidden = true; list.innerHTML = ''; return; }
              var arr = byDay()[day] || [];
              var dt = new Date(day + 'T00:00:00');
              var head = '<div class="cl-head"><span>' + DOW[(dt.getDay() + 6) % 7] + ' ' + dt.getDate() + ' ' + MON[dt.getMonth()].slice(0, 3) +
                '</span><span class="cl-count">' + arr.length + (arr.length === 1 ? ' match' : ' matches') + '</span></div>';
              if (!arr.length) { list.hidden = false; list.innerHTML = head + '<div class="cl-empty">No matches scheduled on this day.</div>'; return; }
              var show = listExpanded ? arr : arr.slice(0, 6);
              var rows = show.map(function (mm) {
                return '<a class="cl-row" href="' + esc(mm.href) + '">' +
                  '<span class="cl-t">' + esc(mm.t) + '</span>' +
                  '<span class="cl-m">' + esc(mm.home) + ' <i>v</i> ' + esc(mm.away) + '<span class="cl-lg">' + esc(mm.lg) + '</span></span>' +
                  '<span class="cl-go">→</span></a>';
              }).join('');
              var more = (!listExpanded && arr.length > show.length)
                ? '<button type="button" class="cl-more" data-cal-more>Show all ' + arr.length + ' matches ▾</button>' : '';
              list.hidden = false;
              list.innerHTML = head + rows + more;
            }
            list.addEventListener('click', function (e) {
              if (e.target.closest('[data-cal-more]')) { listExpanded = true; renderList(sel); }
            });
            function render() {
              label.textContent = MON[m] + ' ' + y;
              var days = byDay();
              var startDow = (new Date(y, m, 1).getDay() + 6) % 7;
              var daysIn = new Date(y, m + 1, 0).getDate();
              var daysPrev = new Date(y, m, 0).getDate();
              var tY = now.getFullYear(), tM = now.getMonth(), tD = now.getDate();
              var html = '';
              DOW.forEach(function (d) { html += '<div class="dow">' + d + '</div>'; });
              for (var i = 0; i < 42; i++) {
                var n = i - startDow + 1;
                if (n < 1) { html += '<div class="day mute">' + (daysPrev + n) + '</div>'; continue; }
                if (n > daysIn) { html += '<div class="day mute">' + (n - daysIn) + '</div>'; continue; }
                var k = key(y, m, n), cls = 'day';
                if (y === tY && m === tM && n === tD) cls += ' active';
                if (days[k]) cls += ' has';
                if (sel === k) cls += ' sel';
                html += '<div class="' + cls + '" data-d="' + k + '" role="button" tabindex="0">' + n + '</div>';
              }
              grid.innerHTML = html;
            }
            function selectDay(k) {
              sel = k; listExpanded = false;
              var p = k.split('-'); y = +p[0]; m = +p[1] - 1;
              render(); renderList(k);
              if (list && list.scrollIntoView) list.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
            grid.addEventListener('click', function (e) {
              var c = e.target.closest('[data-d]'); if (c) selectDay(c.getAttribute('data-d'));
            });
            grid.addEventListener('keydown', function (e) {
              if (e.key !== 'Enter' && e.key !== ' ') return;
              var c = e.target.closest('[data-d]'); if (c) { e.preventDefault(); selectDay(c.getAttribute('data-d')); }
            });
            el.querySelector('[data-cal-prev]').addEventListener('click', function () { if (--m < 0) { m = 11; y--; } render(); });
            el.querySelector('[data-cal-next]').addEventListener('click', function () { if (++m > 11) { m = 0; y++; } render(); });
            if (sportSel) sportSel.addEventListener('change', function () {
              if (sel && !(byDay()[sel])) sel = null;
              render(); renderList(sel);
            });
            (function init() {
              var days = byDay();
              var today = key(now.getFullYear(), now.getMonth(), now.getDate());
              var keys = Object.keys(days).sort();
              var pick = days[today] ? today : (keys.filter(function (k) { return k >= today; })[0] || keys[keys.length - 1] || null);
              if (pick) { var p = pick.split('-'); y = +p[0]; m = +p[1] - 1; sel = pick; }
              render(); renderList(sel);
            })();
          })();
        </script>

        <div class="box">
          <div class="box-h"><span class="hi">📬</span> Free tips by email</div>
          <div class="box-pad newsletter">
            <p class="dim" style="font-size:12.5px;margin:0 0 12px">Get the day's best bets in your inbox every morning.</p>
            <input type="email" placeholder="your@email.com" />
            <button class="btn btn-mint btn-block">Subscribe</button>
          </div>
        </div>

      </aside>
    </div>
  </div>
</Base>
