---
import H2hLeagueView from '../../../../views/H2hLeagueView.astro';
import { buildH2hPairs, H2H_LEAGUES } from '../../../../lib/h2h.js';
import { slugify } from '../../../../lib/utils.js';

export function getStaticPaths() {
  const byLeague = {};
  for (const p of buildH2hPairs()) (byLeague[p.league] ??= []).push(p);
  return Object.entries(H2H_LEAGUES).flatMap(([lang, leagues]) =>
    leagues.filter((lg) => byLeague[lg]).map((lg) => ({
      params: { lang, slug: slugify(lg) },
      props: {
        league: lg,
        list: byLeague[lg].sort((a, b) => a.teamA.localeCompare(b.teamA) || a.teamB.localeCompare(b.teamB)),
      },
    }))
  );
}
const { league, list } = Astro.props;
const { lang } = Astro.params;
---
<H2hLeagueView league={league} list={list} lang={lang} />
