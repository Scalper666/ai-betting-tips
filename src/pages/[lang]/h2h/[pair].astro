---
import H2hPairView from '../../../views/H2hPairView.astro';
import { buildH2hPairs, H2H_LEAGUES } from '../../../lib/h2h.js';

// Localized per league, not per language — see H2H_LEAGUES for why.
export function getStaticPaths() {
  const pairs = buildH2hPairs();
  return Object.entries(H2H_LEAGUES).flatMap(([lang, leagues]) =>
    pairs.filter((p) => leagues.includes(p.league))
      .map((p) => ({ params: { lang, pair: p.slug }, props: { p } }))
  );
}
const { p } = Astro.props;
const { lang } = Astro.params;
---
<H2hPairView p={p} lang={lang} />
