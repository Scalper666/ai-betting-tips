---
import LeagueView from '../../../views/LeagueView.astro';
import predictions from '../../../data/predictions.json';
import { buildLeagueNames } from '../../../lib/leaguePages.js';
import { ALT_LANGS } from '../../../i18n/index.js';

export function getStaticPaths() {
  const tips = predictions.tips ?? [];
  const names = buildLeagueNames();
  return ALT_LANGS.flatMap((lang) =>
    [...names.entries()].map(([slug, league]) => ({
      params: { lang, slug },
      props: { league, tips: tips.filter((t) => t.league === league) },
    })));
}
const { league, tips } = Astro.props;
---
<LeagueView lang={Astro.params.lang} league={league} tips={tips} />
