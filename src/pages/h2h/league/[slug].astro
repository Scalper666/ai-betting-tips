---
import H2hLeagueView from '../../../views/H2hLeagueView.astro';
import { buildH2hPairs } from '../../../lib/h2h.js';
import { slugify } from '../../../lib/utils.js';

export function getStaticPaths() {
  const byLeague = {};
  for (const p of buildH2hPairs()) (byLeague[p.league] ??= []).push(p);
  return Object.entries(byLeague).map(([league, list]) => ({
    params: { slug: slugify(league) },
    props: { league, list: list.sort((a, b) => a.teamA.localeCompare(b.teamA) || a.teamB.localeCompare(b.teamB)) },
  }));
}
const { league, list } = Astro.props;
---
<H2hLeagueView league={league} list={list} lang="en" />
