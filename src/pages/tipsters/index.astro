---
import Base from '../../layouts/Base.astro';
import content from '../../data/content.json';
import historyData from '../../data/history.json';
import AiFaq from '../../components/AiFaq.astro';
import ModelTracks from '../../components/ModelTracks.astro';
import { slugify, faqSchema, signed } from '../../lib/utils.js';

// ── Honest performance page: tracks of OUR OWN model by market, plus the full
//    settled log. Real entries only — mock-era settlements are excluded, and
//    there are no fictional tipster personas anymore.
const settledStates = ['won', 'lost', 'void'];
const real = Object.values(historyData.tips ?? {}).filter(
  (h) => h.score !== 'simulated' && !String(h.event_id ?? '').startsWith('mock')
);
const settled = real
  .filter((h) => settledStates.includes(h.status))
  .sort((a, b) => String(b.settled_at ?? '').localeCompare(String(a.settled_at ?? '')));
const graded = settled.filter((h) => h.status !== 'void');
const won = graded.filter((h) => h.status === 'won').length;
const profit = Math.round(settled.reduce((s, h) => s + (h.profit ?? 0), 0) * 100) / 100;
const winRate = graded.length ? Math.round((won / graded.length) * 1000) / 10 : null;
const roi = graded.length ? Math.round((profit / graded.length) * 1000) / 10 : null;
const shown = settled.slice(0, 40);

// closing-line value: the standard early edge indicator. clv_pct compares the
// price we took with the last price we tracked before kick-off.
const clvOf = (list) => {
  const w = list.filter((h) => h.clv_pct != null);
  if (!w.length) return null;
  return {
    avg: Math.round((w.reduce((s, h) => s + h.clv_pct, 0) / w.length) * 100) / 100,
    n: w.length,
    beat: w.filter((h) => h.clv_pct > 0).length,
  };
};
const clv = clvOf(settled);

// Eras of the same model, reported separately so a rule change never rewrites
// the old numbers. v2 (29 Jul – 17 Sep 2026): selective picks from the blended
// Poisson+market model — closed at ROI -6.1% over 933 graded picks. v3 (from
// 18 Sep 2026): the same model behind stricter gates — blended probability of
// at least 55%, no Over-goals picks, nothing in the opening weeks of a season.
// Earlier (v1) bets stay in the all-time record; nothing is deleted.
const era = (tag) => {
  const list = real.filter((h) => h.model === tag);
  const st = list.filter((h) => settledStates.includes(h.status));
  const gr = st.filter((h) => h.status !== 'void');
  const w = gr.filter((h) => h.status === 'won').length;
  const pr = Math.round(st.reduce((s, h) => s + (h.profit ?? 0), 0) * 100) / 100;
  return {
    published: list.length, settled: st.length, graded: gr.length, won: w, profit: pr,
    winRate: gr.length ? Math.round((w / gr.length) * 1000) / 10 : null,
    roi: gr.length ? Math.round((pr / gr.length) * 1000) / 10 : null,
    clv: clvOf(st),
  };
};
const v3 = era('v3');
const v2 = era('v2');
const v3Live = v3.graded >= 10;   // below that the chips would be noise

const aiPage = (content.entries ?? {})['page:tipsters'];
const pageSchema = aiPage?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(aiPage.faq) } : null;
---
<Base schema={pageSchema}
  title="Model Performance & Track Record — Every Tip Settled Openly"
  description={`Our model's real track record: ${real.length} tips published, ${settled.length} settled${winRate != null ? `, ${winRate}% win rate, ${signed(roi)}% ROI` : ''} — archived before kick-off, graded on final scores, never edited.`}
  active="tipsters">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Performance</div>
      <h1>Model <em>performance</em> &amp; track record</h1>
      <p class="lead">No fictional experts here — one model, split into market tracks. {real.length} tips published so far,
        {settled.length} settled against real final scores. Every number below is reproducible from the public archive.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <section>
          <div class="sec-head"><h2 class="sec-title">Overall <b>record</b></h2></div>
          <div class="res-sum">
            <div class="res-chip"><b>{real.length}</b><span>Published</span></div>
            <div class="res-chip"><b>{settled.length}</b><span>Settled</span></div>
            <div class="res-chip win"><b>{won}</b><span>Won</span></div>
            <div class="res-chip"><b>{winRate != null ? `${winRate}%` : '—'}</b><span>Win rate</span></div>
            <div class={`res-chip ${profit > 0 ? 'win' : profit < 0 ? 'lose' : ''}`}>
              <b>{profit > 0 ? '+' : ''}{profit.toFixed(2)}u</b><span>Profit</span>
            </div>
            <div class={`res-chip ${roi != null && roi > 0 ? 'win' : roi != null && roi < 0 ? 'lose' : ''}`}>
              <b>{roi != null ? `${signed(roi)}%` : '—'}</b><span>ROI</span>
            </div>
            {clv && (
              <div class={`res-chip ${clv.avg > 0 ? 'win' : clv.avg < 0 ? 'lose' : ''}`}>
                <b>{signed(clv.avg)}%</b><span>Avg CLV</span>
              </div>
            )}
          </div>
          {settled.length < 30 && (
            <p class="res-note">⏳ Early days: the archive started recently, so samples are small. That is exactly why the
              full log is public — judge the record as it grows, not from a screenshot.</p>
          )}
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">Model <b>v3</b> — current rules, since 18 Sep 2026</h2></div>
          {v3Live ? (
            <div class="res-sum">
              <div class="res-chip"><b>{v3.published}</b><span>Published</span></div>
              <div class="res-chip"><b>{v3.settled}</b><span>Settled</span></div>
              <div class="res-chip"><b>{v3.winRate != null ? `${v3.winRate}%` : '—'}</b><span>Win rate</span></div>
              <div class={`res-chip ${v3.profit > 0 ? 'win' : v3.profit < 0 ? 'lose' : ''}`}>
                <b>{v3.profit > 0 ? '+' : ''}{v3.profit.toFixed(2)}u</b><span>Profit</span>
              </div>
              <div class={`res-chip ${v3.roi != null && v3.roi > 0 ? 'win' : v3.roi != null && v3.roi < 0 ? 'lose' : ''}`}>
                <b>{v3.roi != null ? `${signed(v3.roi)}%` : '—'}</b><span>ROI</span>
              </div>
              {v3.clv && (
                <div class={`res-chip ${v3.clv.avg > 0 ? 'win' : v3.clv.avg < 0 ? 'lose' : ''}`}>
                  <b>{signed(v3.clv.avg)}%</b><span>Avg CLV</span>
                </div>
              )}
            </div>
          ) : (
            <div class="res-sum">
              <div class="res-chip"><b>{v3.published}</b><span>Published</span></div>
              <div class="res-chip"><b>{v3.settled}</b><span>Settled</span></div>
              <div class="res-chip"><b>⏳</b><span>Grading</span></div>
            </div>
          )}
          <p class="res-note">
            The v2 record settled at −6.1% ROI over 933 graded picks — market-average results minus the
            bookmaker margin, which the published closing-line value (−0.6%) confirmed. Its own breakdown showed
            where the money went: Over-goals picks (−18% ROI), picks the model rated at 50–59% (they hit 44%), and
            the opening weeks of a season, when ratings still reflect last year. From 18 Sep 2026 the same model
            publishes only picks it rates at 55% or more, never an Over, and nothing until both teams have four
            recent matches. Roughly a quarter of the old volume.
            {!v3Live && ' The first picks under the new rules are being graded now; chips appear once ten have settled.'}
          </p>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">Model <b>v2</b> — 29 Jul to 17 Sep 2026, closed</h2></div>
          <div class="res-sum">
            <div class="res-chip"><b>{v2.published}</b><span>Published</span></div>
            <div class="res-chip"><b>{v2.settled}</b><span>Settled</span></div>
            <div class="res-chip"><b>{v2.winRate != null ? `${v2.winRate}%` : '—'}</b><span>Win rate</span></div>
            <div class={`res-chip ${v2.profit > 0 ? 'win' : v2.profit < 0 ? 'lose' : ''}`}>
              <b>{v2.profit > 0 ? '+' : ''}{v2.profit.toFixed(2)}u</b><span>Profit</span>
            </div>
            <div class={`res-chip ${v2.roi != null && v2.roi > 0 ? 'win' : v2.roi != null && v2.roi < 0 ? 'lose' : ''}`}>
              <b>{v2.roi != null ? `${signed(v2.roi)}%` : '—'}</b><span>ROI</span>
            </div>
            {v2.clv && (
              <div class={`res-chip ${v2.clv.avg > 0 ? 'win' : v2.clv.avg < 0 ? 'lose' : ''}`}>
                <b>{signed(v2.clv.avg)}%</b><span>Avg CLV</span>
              </div>
            )}
          </div>
          <p class="res-note">
            Selective picks from our Poisson goal model blended with the market, published whenever the best price
            cleared a value threshold. It lost, and the numbers stay here as published — a record that only keeps its
            winning periods is not a record.
            {v2.clv && ` CLV: ${signed(v2.clv.avg)}% average, beating the close on ${v2.clv.beat} of ${v2.clv.n} bets.`}
          </p>
        </section>

        {v3Live && (
          <section>
            <div class="sec-head"><h2 class="sec-title">v3 tracks by <b>market</b></h2></div>
            <ModelTracks limit={3} track="v3" />
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">v2 tracks by <b>market</b></h2></div>
          <ModelTracks limit={3} track="v2" />
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">All-time tracks <b>(incl. v1)</b></h2></div>
          <ModelTracks limit={3} />
        </section>

        {shown.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Settled <b>log</b></h2>
              <a href="/predictions/daily" class="more-link">By date →</a>
            </div>
            <div class="res-list">
              {shown.map((h) => (
                <a class="res-row" href={`/predictions/${slugify(`${h.home}-vs-${h.away}`)}`} style="text-decoration:none;color:inherit">
                  <span class={`res-mark ${h.status === 'won' ? 'w' : h.status === 'lost' ? 'l' : 'v'}`}>{h.status === 'won' ? 'W' : h.status === 'lost' ? 'L' : 'V'}</span>
                  <span class="res-date">{h.kickoff ? new Date(h.kickoff).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : ''}</span>
                  <div class="res-match"><b>{h.home} v {h.away}</b><span>{h.market}{h.score && h.score !== 'simulated' ? ` · ${h.score}` : ''}</span></div>
                  <span class="res-odds">{Number(h.odds ?? 0).toFixed(2)}</span>
                  <span class={`res-profit ${(h.profit ?? 0) > 0 ? 'pos' : (h.profit ?? 0) < 0 ? 'neg' : 'zero'}`}>{(h.profit ?? 0) > 0 ? '+' : ''}{Number(h.profit ?? 0).toFixed(2)}u</span>
                </a>
              ))}
            </div>
            {settled.length > shown.length && (
              <p class="res-note">Showing the latest {shown.length} of {settled.length} settled tips — the rest live on the
                <a href="/predictions/daily" style="color:var(--mint)"> daily archive pages</a>.</p>
            )}
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">How to <b>read this</b></h2></div>
          <div class="faq">
            <div class="faq-item open">
              <div class="faq-q">Where do these numbers come from?<span class="pm">+</span></div>
              <div class="faq-a"><p>Every tip is archived with its odds the moment it is published, then settled automatically against the official final score. Win rate, ROI and profit are computed from those graded bets only — nothing is edited or deleted afterwards.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">What is a "track"?<span class="pm">+</span></div>
              <div class="faq-a"><p>A slice of the same model by market type: match-result picks, totals picks, draw value. Tracks are strategies, not people — we don't invent tipster personas.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">What is CLV and why show it?<span class="pm">+</span></div>
              <div class="faq-a"><p>Closing-line value compares the price we took with the last price we tracked before
                kick-off. Beating the close consistently is the standard early sign of a real edge — it converges much
                faster than ROI. Our snapshots are taken at each daily refresh, so this is the last tracked price
                rather than the true market close; we label it honestly.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">Can the record be negative?<span class="pm">+</span></div>
              <div class="faq-a"><p>Yes, and when it is, the page shows it. Betting outcomes swing hard on small samples — that's variance, and it's exactly why the full log stays public while the sample grows.</p></div>
            </div>
          </div>
        </section>

        {aiPage?.intro && (
          <section class="seo">
            <h2>About this page</h2>
            <p>{aiPage.intro}</p>
          </section>
        )}
        <AiFaq faqs={aiPage?.faq ?? []} title="Performance FAQ" />
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🔍 Where the picks come from</h4>
          <p>Every tip starts in the value screener — implied probability vs the best available price.</p>
          <a href="/screener" class="btn btn-mint btn-block">Open the screener</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">📊</span> Explore</div>
          <a class="tm" href="/predictions/daily"><span class="dot"></span>Results by date</a>
          <a class="tm" href="/teams"><span class="dot"></span>Records by team</a>
          <a class="tm" href="/glossary/roi-and-yield"><span class="dot"></span>What ROI means</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
