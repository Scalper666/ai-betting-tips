---
import GlossaryTermView from '../../views/GlossaryTermView.astro';
import glossary from '../../data/glossary.json';

export function getStaticPaths() {
  return (glossary.terms ?? []).map((x) => ({ params: { slug: x.slug } }));
}
const { slug } = Astro.params;
---
<GlossaryTermView slug={slug} lang="en" />
