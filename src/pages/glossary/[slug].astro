---
import Base from '../../layouts/Base.astro';
import glossary from '../../data/glossary.json';

// ── Betting glossary: ~30 editor-written definitions (no API cost), one page
//    per term. Topical-authority layer: heavily interlinked with the live tools.
export function getStaticPaths() {
  const terms = [...(glossary.terms ?? [])].sort((a, b) => a.term.localeCompare(b.term));
  return terms.map((t, i) => ({
    params: { slug: t.slug },
    props: { t, prev: terms[i - 1] ?? null, next: terms[i + 1] ?? null },
  }));
}

const { t, prev, next } = Astro.props;
const bySlug = Object.fromEntries((glossary.terms ?? []).map((x) => [x.slug, x]));
const related = (t.related ?? []).map((s) => bySlug[s]).filter(Boolean);

const title = `${t.term} — Meaning in Betting, Explained with an Example`;
const description = t.short;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: t.term,
  description: t.short,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: glossary.set, url: 'https://ai-betting-tips.com/glossary/' },
};
---
<Base title={title} description={description} schema={schema} active="">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span>
        <a href="/glossary">Glossary</a><span>/</span>
        {t.term}
      </div>
      <h1>{t.term}<em>{t.term.endsWith('?') ? '' : ' explained'}</em></h1>
      <p class="lead">{t.short}</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <section class="seo" style="margin-top:6px">
          {t.definition.map((p) => <p>{p}</p>)}
          {t.example && (
            <div class="gl-example">
              <div class="gl-ex-label">Worked example</div>
              <p>{t.example}</p>
            </div>
          )}
        </section>

        {related.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Related <b>terms</b></h2></div>
            <div class="chips" style="margin-bottom:0">
              {related.map((r) => <a class="chip" href={`/glossary/${r.slug}`}>📖 {r.term}</a>)}
            </div>
          </section>
        )}

        <section>
          <div class="res-sum">
            {prev && <a class="res-chip" href={`/glossary/${prev.slug}`} style="text-decoration:none"><b>←</b><span>{prev.term}</span></a>}
            <a class="res-chip" href="/glossary" style="text-decoration:none"><b>A–Z</b><span>all terms</span></a>
            {next && <a class="res-chip" href={`/glossary/${next.slug}`} style="text-decoration:none"><b>→</b><span>{next.term}</span></a>}
          </div>
        </section>
      </main>

      <aside class="sidebar">
        {(t.see ?? []).length > 0 && (
          <div class="promo">
            <h4>🔗 See it in action</h4>
            <p>{t.see[0].label}</p>
            <a href={t.see[0].href} class="btn btn-mint btn-block">Open</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">📖</span> Glossary</div>
          <a class="tm" href="/glossary"><span class="dot"></span>All terms A–Z</a>
          <a class="tm" href="/screener"><span class="dot"></span>AI value screener</a>
          <a class="tm" href="/predictions"><span class="dot"></span>Today's predictions</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
