---
import Base from '../../layouts/Base.astro';
import data from '../../data/bookmakers.json';
import content from '../../data/content.json';
import countryData from '../../data/countries.json';
import { avgScore, SCORE_LABELS } from '../../lib/utils.js';

export function getStaticPaths() {
  return (data.bookmakers ?? []).map((bk) => ({ params: { slug: bk.slug }, props: { bk } }));
}

const { bk } = Astro.props;
const ai = (content.entries ?? {})[`bookmaker:${bk.slug}`];
const avg = avgScore(bk.scores);
const markets = (countryData.countries ?? []).filter((c) => (bk.countries ?? []).includes(c.slug));
const updated = new Date().toISOString().slice(0, 10);

const title = `${bk.name} Review ${new Date().getFullYear()} — Bonus, Odds & Payout Speed`;
const description = `${bk.name} review: rated ${avg}/10. ${bk.bonus.headline} with ${bk.bonus.wagering} wagering. Licences, payout times, app and full pros & cons.`;

const faq = [
  { q: `Is ${bk.name} safe to bet with?`, a: `${bk.name} holds ${bk.licences.join(' and ')} licensing. We check licence status, payout reliability and complaint history before recommending any operator.` },
  { q: `What is the ${bk.name} welcome offer?`, a: `${bk.bonus.headline}. It carries ${bk.bonus.wagering} wagering at minimum odds of ${bk.bonus.min_odds}, with a minimum deposit of €${bk.bonus.min_deposit}.` },
  { q: `How long do ${bk.name} withdrawals take?`, a: `In our testing, withdrawals were processed in ${bk.payout_time}.` },
];
if (ai?.faq?.length) faq.push(...ai.faq);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Review',
      name: title,
      datePublished: updated,
      itemReviewed: {
        '@type': 'Organization',
        name: bk.name,
        foundingDate: String(bk.founded),
      },
      reviewRating: { '@type': 'Rating', ratingValue: avg, bestRating: 10, worstRating: 0 },
      author: { '@type': 'Organization', name: 'AI Betting Tips' },
      reviewBody: bk.verdict,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base title={title} description={description} schema={schema} active="bookmakers">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span><a href="/bookmakers">Betting Sites</a><span>/</span>{bk.name}
      </div>
      <h1>{bk.name} <em>review</em></h1>
      <p class="lead">{description}</p>
      <p class="tc" style="margin-top:6px">Last updated {updated} · Rated by the AI Betting Tips team · <a href="#how-we-rate" style="color:var(--mint)">how we rate</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        {bk.placeholder && (
          <div class="box"><div class="box-pad" style="color:var(--danger);font-weight:700">
            ⚠ Demo entry. Replace with a real partner and a real affiliate link before publishing.
          </div></div>
        )}

        <!-- Snapshot -->
        <section>
          <div class="bk-list">
            <article class="bk featured">
              <div class="bk-rank">★</div>
              <div class="bk-brand">
                <div class="bk-logo" style={`background:${bk.logo.bg};color:${bk.logo.fg}`}>{bk.logo.line1}<br />{bk.logo.line2}</div>
                <div>
                  <h4>{bk.name}</h4>
                  <div class="bk-meta">
                    <span class="rate">★ <b>{bk.rating}</b></span>
                    <span class="tc">Founded {bk.founded} · {bk.licences.join(', ')}</span>
                  </div>
                </div>
              </div>
              <div class="bk-bonus">
                <div class="blbl">Welcome offer</div>
                <div class="amt">{bk.bonus.headline}</div>
                <div class="tc" style="margin-top:4px">{bk.bonus.wagering} wagering · min odds {bk.bonus.min_odds} · min dep €{bk.bonus.min_deposit}</div>
              </div>
              <div class="bk-score">
                <div class="ring" data-val={Math.round(avg * 10)}><b>{avg}</b></div>
                <div class="sl">Our score</div>
              </div>
              <div class="bk-actions">
                <a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">Get bonus</a>
                <span class="review" style="text-decoration:none">18+ · T&amp;C apply · <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline">GambleAware.org</a></span>
              </div>
            </article>
          </div>
        </section>

        <!-- Score breakdown -->
        <section id="how-we-rate">
          <div class="sec-head"><h2 class="sec-title">How {bk.name} <b>scores</b></h2></div>
          <div class="box"><div class="box-pad">
            <div class="rate-rows">
              {Object.entries(bk.scores).map(([k, v]) => (
                <div class="rate-row">
                  <span class="rl">{SCORE_LABELS[k] ?? k}</span>
                  <div class="bar" data-val={Math.round(v * 10)}><i></i></div>
                  <span class="rv">{v}</span>
                </div>
              ))}
            </div>
          </div></div>
        </section>

        <!-- Pros / cons -->
        <section>
          <div class="sec-head"><h2 class="sec-title">Pros &amp; <b>cons</b></h2></div>
          <div class="feat-grid" style="grid-template-columns:1fr 1fr">
            <div class="feat">
              <div class="fi">✅</div><h4>What we liked</h4>
              <ul style="margin:0;padding-left:18px;color:var(--text-dim);font-size:13.5px">
                {bk.pros.map((p) => <li style="margin-bottom:6px">{p}</li>)}
              </ul>
            </div>
            <div class="feat v">
              <div class="fi">⚠️</div><h4>What to watch</h4>
              <ul style="margin:0;padding-left:18px;color:var(--text-dim);font-size:13.5px">
                {bk.cons.map((c) => <li style="margin-bottom:6px">{c}</li>)}
              </ul>
            </div>
          </div>
        </section>

        {ai && (
          <section class="seo">
            <h2>Our verdict on {bk.name}</h2>
            <p>{ai.verdict}</p>
            <h3 style="margin:18px 0 8px">Who is {bk.name} for?</h3>
            <p>{ai.who_for}</p>
          </section>
        )}

        <!-- Facts table -->
        <section>
          <div class="sec-head"><h2 class="sec-title">Key <b>facts</b></h2></div>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <tbody>
                <tr><td class="o-match" style="font-weight:700">Licences</td><td class="o-cell"><span class="cb">{bk.licences.join(', ')}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">Payout speed</td><td class="o-cell hot"><span class="cb">{bk.payout_time}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">Payments</td><td class="o-cell"><span class="cb">{bk.payments.join(', ')}</span></td></tr>
                <tr><td class="o-match" style="font-weight:700">Mobile app</td><td class="o-cell"><span class="cb">
                  {[bk.app.android && 'Android', bk.app.ios && 'iOS'].filter(Boolean).join(' · ') || 'Mobile web only'}
                  {bk.app.size_mb ? ` · ${bk.app.size_mb} MB` : ''}
                </span></td></tr>
                <tr><td class="o-match" style="font-weight:700">Live streaming</td><td class="o-cell"><span class="cb">{bk.app.streaming ? 'Yes' : 'No'}</span></td></tr>
              </tbody>
            </table>
          </div></div>
        </section>

        <!-- Verdict -->
        <section class="seo">
          <h2>{bk.name} verdict</h2>
          <p>{bk.verdict}</p>
          <p class="dim" style="font-size:13px">ⓘ The AI layer expands this into a full 600–900 word review from the facts above.</p>
        </section>

        <!-- FAQ -->
        <section>
          <div class="sec-head"><h2 class="sec-title">{bk.name} <b>FAQ</b></h2></div>
          <div class="faq">
            {faq.map((f, i) => (
              <div class={`faq-item${i === 0 ? ' open' : ''}`}>
                <div class="faq-q">{f.q}<span class="pm">+</span></div>
                <div class="faq-a"><p>{f.a}</p></div>
              </div>
            ))}
          </div>
        </section>

      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🎁 {bk.name}</h4>
          <p>{bk.bonus.headline}</p>
          <a href={bk.affiliate_url} class="btn btn-mint btn-block" rel="nofollow sponsored" target="_blank">Claim offer</a>
          <span class="tc-line">18+ · T&amp;C apply · <a href="https://www.gambleaware.org" rel="nofollow noopener" target="_blank">GambleAware.org</a></span>
        </div>
        {markets.length > 0 && (
          <div class="box">
            <div class="box-h"><span class="hi">🌍</span> Available in</div>
            {markets.map((c) => (
              <a class="tm" href={`/countries/${c.slug}`}><span class="dot"></span>{c.flag} {c.name}</a>
            ))}
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">🏆</span> Compare</div>
          <a class="tm" href="/bookmakers"><span class="dot"></span>All bookmakers</a>
          <a class="tm" href="/bonuses"><span class="dot"></span>All bonuses</a>
          <a class="tm" href="/betting-apps"><span class="dot"></span>Betting apps</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
