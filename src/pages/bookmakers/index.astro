---
import Base from '../../layouts/Base.astro';
import BookmakerRow from '../../components/BookmakerRow.astro';
import data from '../../data/bookmakers.json';
import { avgScore, SCORE_LABELS } from '../../lib/utils.js';

const list = [...(data.bookmakers ?? [])].sort((a, b) => avgScore(b.scores) - avgScore(a.scores));
const year = new Date().getFullYear();
---
<Base
  title={`Best Betting Sites ${year} — Bookmaker Reviews & Ratings`}
  description={`We rate ${list.length} bookmakers on odds, markets, payout speed, app and bonus value. Independent reviews — operators cannot buy a higher ranking.`}
  active="bookmakers">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Betting Sites</div>
      <h1>Best <em>betting sites</em> {year}</h1>
      <p class="lead">Every operator is scored on six criteria. Ranking follows the score — no operator buys a higher position.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="bk-list">
            {list.map((bk, i) => <BookmakerRow bk={bk} rank={i + 1} />)}
          </div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">How we <b>rate</b></h2></div>
          <div class="bt-grid">
            {Object.entries(SCORE_LABELS).map(([k, label]) => (
              <div class="bt-tile">
                <div class="ic">📊</div>
                <div><h4>{label}</h4><p>Scored 0–10 on real accounts</p></div>
              </div>
            ))}
          </div>
        </section>
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🏆 Top rated</h4>
          <p>{list[0]?.name} — {list[0]?.bonus.headline}</p>
          <a href={`/bookmakers/${list[0]?.slug}`} class="btn btn-mint btn-block">Read review</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🔗</span> Also see</div>
          <a class="tm" href="/bonuses"><span class="dot"></span>All bonuses</a>
          <a class="tm" href="/betting-apps"><span class="dot"></span>Betting apps</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
