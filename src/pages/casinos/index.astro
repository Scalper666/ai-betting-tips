---
import Base from '../../layouts/Base.astro';
import CasinoRow from '../../components/CasinoRow.astro';
import data from '../../data/casinos.json';
import { avgScore, CASINO_SCORE_LABELS } from '../../lib/utils.js';

const list = [...(data.casinos ?? [])].sort((a, b) => avgScore(b.scores) - avgScore(a.scores));
const top = list[0];
const year = new Date().getFullYear();
---
<Base
  title={`Best Online Casinos ${year} — Reviews & Ratings — AI Betting Tips`}
  description={`We rate ${list.length} online casinos on game selection, live casino, payout speed, bonus value and safety. Independent reviews — no operator buys a higher ranking.`}
  active="casinos">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Casinos</div>
      <h1>Best <em>online casinos</em> &amp; reviews</h1>
      <p class="lead">Independent reviews of the top online casinos for {year}, scored on game selection, live casino, payout speed, safety and bonus value. No operator can buy a higher ranking.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <section>
          <div class="bk-list">
            {list.map((c, i) => <CasinoRow casino={c} rank={i + 1} />)}
          </div>
        </section>

        {top && (
          <section>
            <div class="sec-head"><h2 class="sec-title">How we <b>rate casinos</b></h2></div>
            <div class="box"><div class="box-pad">
              <p class="dim" style="margin:0 0 18px;font-size:13.5px">Every casino is scored out of 10 across six criteria. Here's how our #1, {top.name}, breaks down:</p>
              <div class="rate-rows">
                {Object.entries(top.scores).map(([k, v]) => (
                  <div class="rate-row">
                    <span class="rl">{CASINO_SCORE_LABELS[k] ?? k}</span>
                    <div class="bar" data-val={Math.round(v * 10)}><i></i></div>
                    <span class="rv">{v}</span>
                  </div>
                ))}
              </div>
            </div></div>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">What we <b>check</b></h2></div>
          <div class="feat-grid">
            <div class="feat"><div class="fi">🎰</div><h4>Games &amp; providers</h4><p>Thousands of slots and tables from trusted studios like NetEnt, Pragmatic and Evolution.</p></div>
            <div class="feat v"><div class="fi">⚡</div><h4>Fast withdrawals</h4><p>We test real payouts and only recommend casinos that pay quickly across cards, e-wallets and crypto.</p></div>
            <div class="feat"><div class="fi">🔒</div><h4>Licensed &amp; fair</h4><p>Every casino holds a valid licence and uses audited RNGs for fair play.</p></div>
          </div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">Casino <b>FAQ</b></h2></div>
          <div class="faq">
            <div class="faq-item open">
              <div class="faq-q">Are these online casinos safe?<span class="pm">+</span></div>
              <div class="faq-a"><p>We only list casinos that hold a valid licence from a recognised regulator and use audited random number generators. Each review lists the operator's licences in full.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">What is a wagering requirement on a casino bonus?<span class="pm">+</span></div>
              <div class="faq-a"><p>It's how many times you must play through a bonus before withdrawing winnings. "35x" on a €100 bonus means €3,500 in bets. Lower is better — we always list it next to the headline.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">Can I play live casino games?<span class="pm">+</span></div>
              <div class="faq-a"><p>Yes — most of our top-rated casinos offer live blackjack, roulette and game shows streamed with real dealers. The Live casino score in each review reflects that lobby.</p></div>
            </div>
          </div>
        </section>

        <section class="seo">
          <h2>How to choose a safe online casino</h2>
          <div class="clamp" id="seoClamp">
            <p>The best online casino for you depends on what you like to play and what matters most — a huge slots library, a strong live casino, fast crypto payouts or a generous welcome package. Our reviews score each casino objectively so you can compare them like for like.</p>
            <p>Look for a valid licence from a respected regulator, fair bonus terms with reasonable wagering, fast withdrawals in your preferred method, and games from audited providers. Gambling should be entertainment, never a way to make money: set deposit and time limits, never chase losses, and only play with money you can afford to lose. You must be 18+.</p>
          </div>
          <span class="read-more" data-clamp-toggle="seoClamp">Read more ▾</span>
        </section>

      </main>

      <aside class="sidebar">
        {top && (
          <div class="promo">
            <h4>🎰 #1 {top.name}</h4>
            <p>Our top casino for {year} — {top.bonus.headline.toLowerCase()} for new players.</p>
            <a href={`/casinos/${top.slug}`} class="btn btn-mint btn-block">Read review</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">🎁</span> Top casino bonuses</div>
          {list.slice(0, 3).map((c) => (
            <div class="mini-tip">
              <div class="ava" style={`background:${c.logo.bg};color:${c.logo.fg}`}>{c.logo.line1.slice(0, 2)}</div>
              <div><h5>{c.name}</h5><div class="mt-sp">{c.bonus.headline}</div></div>
              <div class="mt-roi"><b>{avgScore(c.scores)}</b><span>Score</span></div>
            </div>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🔗</span> Also see</div>
          <a class="tm" href="/bookmakers"><span class="dot"></span>Betting sites</a>
          <a class="tm" href="/bonuses"><span class="dot"></span>Betting bonuses</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
