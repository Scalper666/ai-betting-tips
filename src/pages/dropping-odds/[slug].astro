---
import Base from '../../layouts/Base.astro';
import ToolsBox from '../../components/ToolsBox.astro';
import { buildDroppingPaths, droppingByLeague } from '../../lib/droppingOdds.js';
import { matchSlug, kickoffLabel, slugify, BUILD_ISO, fmtDate } from '../../lib/utils.js';
import { hasLeaguePage } from '../../lib/links.js';

// ── Per-league dropping odds: same snapshots as the hub, one competition per
//    page. Pages exist only where 3+ tracked prices actually moved (see
//    lib/droppingOdds.js), so a league without live movement has no page
//    rather than an empty one.
export function getStaticPaths() {
  return buildDroppingPaths();
}

const { league, rows } = Astro.props;
const others = Object.entries(droppingByLeague())
  .filter(([l]) => l !== league)
  .map(([l, r]) => ({ name: l, n: r.length }))
  .sort((a, b) => b.n - a.n);

const droppers = rows.filter((r) => r.move < 0).length;
const biggest = rows[0];

const title = `${league} Dropping Odds — Biggest Line Moves`;
const description = `${rows.length} tracked ${league} prices have moved since opening, ${droppers} shortening. The biggest: ${biggest.t.home} v ${biggest.t.away} (${biggest.move > 0 ? '+' : ''}${biggest.move}%). From our own snapshots, refreshed twice a day.`;
---
<Base title={title} description={description} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span><a href="/dropping-odds">Dropping odds</a><span>/</span>{league}
      </div>
      <h1>{league} <em>dropping odds</em></h1>
      <p class="lead">{rows.length} tracked prices in {league} have moved since we first quoted them — {droppers} shortening, {rows.length - droppers} drifting. Shortening odds usually mean money arriving on that outcome.</p>
      <p class="upd-line">Snapshots refreshed {fmtDate(BUILD_ISO)} · <a href="/editorial-policy">how we work</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">Line moves in <b>{league}</b></h2>
            {hasLeaguePage(league) && <a href={`/league/${slugify(league)}`} class="more-link">League tips →</a>}
          </div>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <thead><tr>
                <th style="text-align:left">Match</th><th style="text-align:left">Market</th>
                <th>Opened</th><th>Now</th><th>Move</th><th>Kick-off</th>
              </tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td class="o-match" style="font-weight:700">
                      <a href={`/predictions/${matchSlug(r.t)}`} style="color:inherit;text-decoration:none">{r.t.home} v {r.t.away}</a>
                    </td>
                    <td class="o-cell" style="text-align:left"><span>{r.market}</span></td>
                    <td class="o-cell"><span class="cb">{r.first.toFixed(2)}</span></td>
                    <td class="o-cell hot"><span class="cb">{r.last.toFixed(2)}</span></td>
                    <td class="o-cell"><span class="cb" style={`color:${r.move < 0 ? 'var(--win)' : 'var(--lose)'}`}>{r.move > 0 ? '+' : ''}{r.move}%</span></td>
                    <td class="o-cell" style="white-space:nowrap"><span>{kickoffLabel(r.t.kickoff)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div></div>
          <p class="res-note">"Opened" is the first price we tracked for our tip's market, not the bookmaker's true opening line. Snapshots run at pipeline frequency, so moves between refreshes are invisible — treat these as a floor on the real movement.</p>
        </section>

        <section class="seo">
          <h2>Reading {league} line moves</h2>
          <p>A shortening price is later money agreeing with the pick; a drifting one is the market moving away. Neither is a command — a price that shortened has, by definition, already paid out part of its value to whoever took it early. The practical use is timing: competitions whose lines move a lot between our refreshes reward taking a good price early rather than waiting for kick-off.</p>
          <p>Each match links to its full page, where the model's own probability sits next to the odds comparison — the two numbers that decide whether the current price, moved or not, is still worth taking. The aggregate movement patterns across all leagues live in our <a href="/research/line-movement">line-movement study</a>.</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📉</span> Dropping odds by league</div>
          <a class="tm" href="/dropping-odds"><span class="dot"></span>All leagues</a>
          {others.map((l) => (
            <a class="tm" href={`/dropping-odds/${slugify(l.name)}`}>
              <span class="dot"></span>{l.name}<span class="cnt">{l.n}</span>
            </a>
          ))}
        </div>
        <ToolsBox lang="en" />
      </aside>
    </div>
  </div>
</Base>
