---
import Base from '../../layouts/Base.astro';
import BookmakerRow from '../../components/BookmakerRow.astro';
import CasinoRow from '../../components/CasinoRow.astro';
import countryData from '../../data/countries.json';
import bookmakerData from '../../data/bookmakers.json';
import casinoData from '../../data/casinos.json';
import content from '../../data/content.json';
import { avgScore } from '../../lib/utils.js';

export function getStaticPaths() {
  return (countryData.countries ?? []).map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props;
const ai = (content.entries ?? {})[`country:${country.slug}`];
const list = (bookmakerData.bookmakers ?? [])
  .filter((bk) => (bk.countries ?? []).includes(country.slug))
  .sort((a, b) => avgScore(b.scores) - avgScore(a.scores));
const casinoList = (casinoData.casinos ?? [])
  .filter((c) => (c.countries ?? []).includes(country.slug))
  .sort((a, b) => avgScore(b.scores) - avgScore(a.scores));

const year = new Date().getFullYear();
const title = `Best Betting Sites in ${country.name} ${year}`;
const description = `Licensed bookmakers accepting players from ${country.name}, with local payment methods, bonus terms and how betting is regulated by ${country.regulator}.`;
---
<Base title={title} description={description} active="bookmakers">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span><a href="/bookmakers">Betting Sites</a><span>/</span>{country.name}
      </div>
      <h1>{country.flag} Best betting sites in <em>{country.name}</em></h1>
      <p class="lead">{country.legal_summary}</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        {ai && (
          <section class="seo" style="margin-top:22px">
            <h2>Betting in {country.name}</h2>
            <p>{ai.intro}</p>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">Top sites for <b>{country.name}</b></h2></div>
          {list.length ? (
            <div class="bk-list">{list.map((bk, i) => <BookmakerRow bk={bk} rank={i + 1} />)}</div>
          ) : (
            <div class="box"><div class="box-pad dim">No rated operators cover this market yet.</div></div>
          )}
        </section>

        {casinoList.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Top casinos in <b>{country.name}</b></h2>
              <a href="/casinos" class="more-link">All casinos →</a>
            </div>
            <div class="bk-list">
              {casinoList.map((c, i) => <CasinoRow casino={c} rank={i + 1} />)}
            </div>
          </section>
        )}

        <section>
          <div class="sec-head"><h2 class="sec-title">Betting in <b>{country.name}</b></h2></div>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <tbody>
                <tr><td class="o-match" style="font-weight:700">Regulator</td><td class="o-cell"><b>{country.regulator}</b></td></tr>
                <tr><td class="o-match" style="font-weight:700">Currency</td><td class="o-cell"><b>{country.currency}</b></td></tr>
                <tr><td class="o-match" style="font-weight:700">Popular payments</td><td class="o-cell"><b>{country.popular_payments.join(', ')}</b></td></tr>
              </tbody>
            </table>
          </div></div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">What to <b>know</b></h2></div>
          <div class="feat-grid">
            {country.key_facts.map((f) => (
              <div class="feat"><div class="fi">ℹ️</div><p>{f}</p></div>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>Is betting legal in {country.name}?</h2>
          <p>{country.legal_summary}</p>
          {country.verify && (
            <p class="dim" style="font-size:13px">
              ⓘ Legal details change — verify against a current source before publishing. You must be of
              legal betting age in your jurisdiction (18+ in most markets).
            </p>
          )}
        </section>

      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">🌍</span> Other markets</div>
          {(countryData.countries ?? []).filter((c) => c.slug !== country.slug).map((c) => (
            <a class="tm" href={`/countries/${c.slug}`}><span class="dot"></span>{c.flag} {c.name}</a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🔗</span> Also see</div>
          <a class="tm" href="/bookmakers"><span class="dot"></span>All bookmakers</a>
          <a class="tm" href="/bonuses"><span class="dot"></span>All bonuses</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
