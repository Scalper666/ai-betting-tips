---
import CountryView from '../../views/CountryView.astro';
import countryData from '../../data/countries.json';

export function getStaticPaths() {
  return (countryData.countries ?? []).map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}
const { country } = Astro.props;
---
<CountryView lang="en" country={country} />
