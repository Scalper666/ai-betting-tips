---
import Base from '../../layouts/Base.astro';
import { contentUpdated } from '../../lib/guides.js';
import { fmtDate } from '../../lib/utils.js';

const title = 'Free Betting Tools — Calculators & Converters';
const description = 'Free betting calculators: odds converter, accumulator, bookmaker margin and value checker, Kelly stakes, hedging and cash-out, dutching. No sign-up, instant results.';

const TOOLS = [
  { href: '/tools/acca-builder', icon: '🤖', name: 'AI acca builder', p: "Build an accumulator from the model's own rated picks, with the hit rate and margin shown as you add legs." },
  { href: '/tools/odds-converter', icon: '🔁', name: 'Odds converter', p: 'Decimal ↔ fractional ↔ American ↔ implied probability.' },
  { href: '/tools/accumulator-calculator', icon: '🎯', name: 'Accumulator calculator', p: 'Combined odds, returns and profit for any number of legs.' },
  { href: '/tools/margin-calculator', icon: '📊', name: 'Margin & value calculator', p: "Expose the bookmaker's margin and test any price for value." },
  { href: '/tools/kelly-calculator', icon: '📐', name: 'Kelly criterion calculator', p: 'Optimal stake from your edge — with the fractional versions that survive real estimate error.' },
  { href: '/tools/hedging-calculator', icon: '🛡️', name: 'Hedging & cash-out', p: 'Lock in a profit, and check whether the cash-out button is charging margin twice.' },
  { href: '/tools/dutching-calculator', icon: '🪢', name: 'Dutching calculator', p: 'Split one stake across selections for an equal return, with the combined margin exposed.' },
  { href: '/dropping-odds', icon: '📉', name: 'Dropping odds', p: 'The biggest line moves across the fixtures we track.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free betting calculators',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://ai-betting-tips.com${t.href}/`,
  })),
};
---
<Base title={title} description={description} schema={schema} updated={`${contentUpdated}T00:00:00Z`} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Tools</div>
      <h1>Betting <em>tools</em></h1>
      <p class="lead">Free calculators used across our own pipeline — no sign-up, everything runs in your browser, nothing is stored.</p>
      <p class="upd-line">Updated {fmtDate(contentUpdated)} · <a href="/editorial-policy">how we work</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head"><h2 class="sec-title">All <b>calculators</b></h2></div>
          <div class="bt-grid">
            {TOOLS.map((t) => (
              <a href={t.href} class="bt-tile"><div class="ic">{t.icon}</div><div><h4>{t.name}</h4><p>{t.p}</p></div><span class="arr">→</span></a>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>Why these, and not a hundred</h2>
          <p>The acca builder is the one that starts from our own data rather than yours: it pulls the model's rated selections and shows what combining them actually costs. The rest solve a problem that costs bettors real money when they guess instead of calculating. The converter and margin calculator expose what a price actually implies and what the bookmaker is charging for it. Kelly and the acca calculator size and structure a position. Hedging shows what a cash-out button is really offering, and dutching shows what covering extra outcomes costs in margin.</p>
          <p>None of them predict anything — that is the model's job, and its methodology and full settled record are published separately. Tools that promise to find winners belong to a different kind of website. If you want the reasoning behind each calculation, the <a href="/guides">guides</a> work through the same maths with examples, and the <a href="/glossary">glossary</a> defines every term used here.</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🔍 Prices worth calculating</h4>
          <p>Our screener compares model fair odds with the best available price on every fixture we track.</p>
          <a href="/screener" class="btn btn-mint btn-block">Open screener</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">📗</span> Learn the maths</div>
          <a class="tm" href="/guides/how-to-read-betting-odds"><span class="dot"></span>How to read odds</a>
          <a class="tm" href="/guides/bookmaker-margin-explained"><span class="dot"></span>Bookmaker margin</a>
          <a class="tm" href="/guides/value-betting-explained"><span class="dot"></span>Value betting</a>
          <a class="tm" href="/guides/bankroll-management-guide"><span class="dot"></span>Bankroll management</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
