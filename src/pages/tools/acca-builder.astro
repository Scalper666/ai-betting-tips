---
import Base from '../../layouts/Base.astro';
import ToolsBox from '../../components/ToolsBox.astro';
import screener from '../../data/screener.json';
import { slugify, matchSlug, faqSchema, BUILD_ISO, fmtDate } from '../../lib/utils.js';

// ── AI acca builder: picks a slip out of the model's own rated selections.
//    Search Console shows real clicks arriving on "ai acca builder" and "ai
//    accumulator tips", so this exists as a product page rather than a
//    calculator: it starts from OUR ratings, one leg per match, and shows the
//    combined price and honest hit-rate maths as legs are toggled.
const rows = (screener.rows ?? [])
  .filter((r) => Number(r.odds) >= 1.2 && Number(r.odds) <= 3.0 && r.confidence > 0)
  .sort((a, b) => b.score - a.score);

// one leg per fixture — an acca cannot hold two selections from the same match
const seen = new Set();
const legs = [];
for (const r of rows) {
  const key = `${r.home}|${r.away}`;
  if (seen.has(key)) continue;
  seen.add(key);
  legs.push({
    id: r.id,
    home: r.home,
    away: r.away,
    league: r.league,
    market: r.market,
    odds: Number(r.odds),
    score: r.score,
    confidence: r.confidence,
    edge: r.edge,
    kickoff: r.kickoff,
    href: `/predictions/${matchSlug(r)}`,
  });
  if (legs.length >= 18) break;
}

const kickLabel = (iso) => {
  const d = new Date(iso);
  return isNaN(d) ? '' : d.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';
};

const title = 'AI Acca Builder — Build an Accumulator from Model-Rated Picks';
const description = "Build an accumulator from our model's own rated selections: toggle legs, see the combined odds, the model's implied hit rate and what the bookmaker margin costs you per added leg.";

const faq = [
  { q: 'How does the AI acca builder choose legs?', a: "Every selection comes from our model's screener: it prices each fixture from time-decayed team scoring rates, blends that with market prices, and scores the gap against the best available odds. This page shows the highest-scoring selections in accumulator-friendly odds ranges, one per match, so you can assemble a slip from rated picks rather than hunches." },
  { q: 'Does combining AI picks improve my chances?', a: 'No — and any tool claiming otherwise is selling something. Combining legs multiplies both the odds and the bookmaker margin while multiplying win probability downwards. Four legs at a genuine 60% each win together about 13% of the time. The builder shows that number as you add legs precisely so the trade-off stays visible.' },
  { q: 'Why are long-odds selections excluded?', a: 'Because betting markets systematically overprice longshots and our own first model version lost eight straight on double-digit odds before we capped it. The builder sticks to 1.20–3.00 selections, where the model has measurable edge and the maths behind an acca is at least defensible.' },
  { q: 'Should I bet the acca you build?', a: 'Treat it as entertainment with a known cost, staked small. Our full settled record — including losing runs — is published on the results pages, and accumulators are structurally the most expensive product on any betting menu. Singles preserve more of whatever edge exists.' },
];
const schema = { '@context': 'https://schema.org', ...faqSchema(faq) };
---
<Base title={title} description={description} schema={schema} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span><a href="/tools">Tools</a><span>/</span>AI acca builder</div>
      <h1>AI acca <em>builder</em></h1>
      <p class="lead">Assemble an accumulator from our model's own rated selections — one leg per match, only in odds ranges where the model has measurable edge. The combined price, the model's implied hit rate and the margin you pay update as you toggle legs.</p>
      <p class="upd-line">Selections refreshed {fmtDate(BUILD_ISO)} · rebuilt twice daily · <a href="/editorial-policy">how we work</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        {legs.length >= 2 ? (
          <>
            <section>
              <div class="sec-head">
                <h2 class="sec-title">Your <b>slip</b></h2>
                <a href="/screener" class="more-link">Full screener →</a>
              </div>
              <div class="box"><div class="box-pad">
                <div class="tool-res">
                  <div class="tool-big"><b id="abLegs">—</b><span>Legs selected</span></div>
                  <div class="tool-big"><b id="abOdds">—</b><span>Combined odds</span></div>
                </div>
                <div class="tool-res" style="margin-top:10px">
                  <div class="tool-big"><b id="abReturn">—</b><span>Returns on a 10 stake</span></div>
                  <div class="tool-big"><b id="abHit">—</b><span>Model's implied hit rate</span></div>
                </div>
                <div class="tool-row" style="margin-top:14px">
                  <div class="tool-f"><label>Your stake</label><input id="abStake" type="number" step="1" min="0.5" value="10" inputmode="decimal" /></div>
                  <div class="tool-f"><label>Quick fill</label>
                    <select id="abFill" class="cal-sel">
                      <option value="0">Choose legs manually</option>
                      <option value="2">Top 2 rated</option>
                      <option value="3" selected>Top 3 rated</option>
                      <option value="4">Top 4 rated</option>
                      <option value="5">Top 5 rated</option>
                    </select>
                  </div>
                </div>
                <p class="res-note" id="abNote" style="margin-top:12px">—</p>
              </div></div>
            </section>

            <section>
              <div class="sec-head"><h2 class="sec-title">Model-rated <b>selections</b></h2></div>
              <div class="odds-table"><div class="scr-scroll">
                <table class="otbl" id="abTable">
                  <thead><tr><th>Pick</th><th style="text-align:left">Match</th><th style="text-align:left">Selection</th><th>Odds</th><th>Score</th></tr></thead>
                  <tbody>
                    {legs.map((l, i) => (
                      <tr data-leg={l.odds} data-score={l.score} data-conf={l.confidence}>
                        <td class="o-cell">
                          <input type="checkbox" class="ab-cb" data-i={i} checked={i < 3} aria-label={`Include ${l.home} v ${l.away}`} />
                        </td>
                        <td class="o-match">
                          <a href={l.href} style="color:inherit"><b>{l.home} v {l.away}</b></a>
                          <span class="lg" style="display:block;font-size:11px;color:var(--text-mute)">{l.league} · {kickLabel(l.kickoff)}</span>
                        </td>
                        <td class="o-match">{l.market}</td>
                        <td class="o-cell hot"><span class="cb">{l.odds.toFixed(2)}</span></td>
                        <td class="o-cell"><span>{l.score}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div></div>
              <p class="res-note">Score is our screener's rating of the gap between the model's fair odds and the best available price. Selections update twice a day; matches that have kicked off drop out on the next rebuild.</p>
            </section>
          </>
        ) : (
          <section>
            <div class="box"><div class="box-pad dim">No accumulator-friendly selections are priced right now — the feed refills when bookmakers open the next round of fixtures. The <a href="/screener" style="color:var(--mint)">screener</a> shows everything currently rated.</div></div>
          </section>
        )}

        <section class="seo">
          <h2>What this tool is honest about</h2>
          <p>An accumulator multiplies odds, and it multiplies the bookmaker's margin with them. Four legs at a typical 5% margin each bake in roughly 19% of combined margin — before a ball is kicked. That is why accas pay so well when they land and why most of them do not, and no amount of model rating changes the arithmetic. The hit-rate figure above is the model's own estimate of how often your specific slip should win: it falls fast as you add legs, which is the point of showing it.</p>
          <p>What the model genuinely contributes is leg quality. Each selection here scored well on the gap between our fair odds and the best available price, and the range is capped at 3.00 because our own v1 model went 0-for-8 on double-digit prices before we learned that lesson publicly. Restricting the pool to measurable edges is the only defensible way to build one of these.</p>
          <p>If you want the underlying maths, the <a href="/guides/what-is-an-accumulator" style="color:var(--mint)">accumulator guide</a> works through it with examples, and the <a href="/tools/accumulator-calculator" style="color:var(--mint)">acca calculator</a> handles any slip you build elsewhere. Our complete settled record, losing streaks included, is on the <a href="/tipsters" style="color:var(--mint)">track record page</a>. Stake small; 18+.</p>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">Acca builder <b>FAQ</b></h2></div>
          <div class="prose" style="padding:0;max-width:none">
            {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
          </div>
        </section>
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🔍 Every rated pick</h4>
          <p>The full screener: model fair odds against best available prices on every fixture we track.</p>
          <a href="/screener" class="btn btn-mint btn-block">Open screener</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🎯</span> Acca pages</div>
          <a class="tm" href="/tips/accumulator"><span class="dot"></span>Today's acca tips</a>
          <a class="tm" href="/tools/accumulator-calculator"><span class="dot"></span>Acca calculator</a>
          <a class="tm" href="/guides/what-is-an-accumulator"><span class="dot"></span>How accas work</a>
          <a class="tm" href="/guides/common-betting-mistakes"><span class="dot"></span>Common mistakes</a>
        </div>
        <ToolsBox lang="en" />
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var table = document.getElementById('abTable');
      if (!table) return;
      var g = function (id) { return document.getElementById(id); };
      var rows = [].slice.call(table.querySelectorAll('tbody tr'));
      var boxes = rows.map(function (r) { return r.querySelector('.ab-cb'); });

      function recalc() {
        var odds = 1, n = 0, hit = 1;
        rows.forEach(function (r, i) {
          if (!boxes[i].checked) return;
          n++;
          odds *= parseFloat(r.getAttribute('data-leg'));
          // model confidence is a percentage per leg; multiply for the slip
          hit *= Math.min(0.99, Math.max(0.01, parseFloat(r.getAttribute('data-conf')) / 100));
        });
        var stake = parseFloat(g('abStake').value);
        if (!(stake > 0)) stake = 10;
        g('abLegs').textContent = String(n);
        if (n < 2) {
          g('abOdds').textContent = '—';
          g('abReturn').textContent = '—';
          g('abHit').textContent = '—';
          g('abNote').textContent = 'Select at least two legs. One selection is a single, not an accumulator — and singles keep more of whatever edge exists.';
          return;
        }
        g('abOdds').textContent = '×' + odds.toFixed(2);
        g('abReturn').textContent = (stake * odds).toFixed(2) + ' (profit ' + (stake * odds - stake).toFixed(2) + ')';
        g('abHit').textContent = (hit * 100).toFixed(1) + '%';
        g('abHit').parentElement.classList.toggle('warn', hit < 0.15);
        var implied = 1 / odds * 100;
        g('abNote').textContent = n + ' legs at ×' + odds.toFixed(2) + '. The price implies ' + implied.toFixed(1) +
          '% while our model puts the slip at ' + (hit * 100).toFixed(1) + '% — the gap between those two numbers is the margin you are paying for combining. Expect roughly ' +
          (hit > 0 ? Math.round(1 / hit) : '—') + ' attempts per winning slip.';
      }

      boxes.forEach(function (b) { b.addEventListener('change', recalc); });
      g('abStake').addEventListener('input', recalc);
      g('abFill').addEventListener('change', function () {
        var k = parseInt(this.value, 10);
        if (k > 0) boxes.forEach(function (b, i) { b.checked = i < k; });
        recalc();
      });
      recalc();
    })();
  </script>
</Base>
