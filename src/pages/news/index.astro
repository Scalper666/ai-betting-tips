---
import Base from '../../layouts/Base.astro';
import predictions from '../../data/predictions.json';
import { matchSlug, kickoffLabel, slugify } from '../../lib/utils.js';
import { getRecapWeeks } from '../../lib/recap.js';
import TeamMark from '../../components/TeamMark.astro';
import { badgeColor } from '../../lib/utils.js';

const recaps = getRecapWeeks().slice(-4).reverse(); // latest weeks first
const fmtU = (n) => `${n > 0 ? '+' : ''}${Number(n ?? 0).toFixed(2)}u`;

// The news feed is generated from the pipeline: every fixture becomes a preview
// article that links to its full match page. No hand-written posts to maintain.
const tips = [...(predictions.tips ?? [])].sort(
  (a, b) => (b.recommendation?.confidence ?? 0) - (a.recommendation?.confidence ?? 0));
const featureTip = tips[0];
const cards = tips.slice(1);
---
<Base
  title="Betting News, Match Previews & Analysis — AI Betting Tips"
  description="Automated match previews for every fixture in our pipeline: prediction, best odds and confidence — updated with every data refresh."
  active="news">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>News</div>
      <h1>Betting <em>news</em> &amp; analysis</h1>
      <p class="lead">Match previews generated from the live pipeline — every fixture gets a prediction, an odds comparison and a confidence rating. Refreshed with every data update.</p>
    </div>
  </div>

  <div class="container" style="padding-bottom:60px">

    {recaps.length > 0 && (
      <section style="margin-bottom:26px">
        <div class="sec-head">
          <h2 class="sec-title">Weekly <b>model recaps</b></h2>
          <a href="/news/recap" class="more-link">All weeks →</a>
        </div>
        <div class="res-sum">
          {recaps.map((w) => (
            <a class="res-chip" href={`/news/recap/${w.slug}`} style="text-decoration:none">
              <b>Week {w.week}</b>
              <span>{w.stats.settled ? `${w.stats.won}W–${w.stats.lost}L · ${fmtU(w.stats.profit)}` : `${w.stats.tips} tips${w.inProgress ? ' · live' : ''}`}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {featureTip && (
      <div class="feature-article" style="margin-bottom:18px">
        <div class="fa-img" style={`--ca:${badgeColor(featureTip.home)};--cb:${badgeColor(featureTip.away)}`}>
          <div class="cover-vs">
            <TeamMark team={featureTip.home} sportKey={featureTip.sport_key} />
            <span class="cv-x">VS</span>
            <TeamMark team={featureTip.away} sportKey={featureTip.sport_key} />
          </div>
        </div>
        <div class="fa-body">
          <span class="tag">{featureTip.league}</span>
          <h2>{featureTip.home} vs {featureTip.away}: preview, prediction &amp; best bets</h2>
          <p>Our model's strongest pick right now: {featureTip.recommendation?.text} at {Number(featureTip.recommendation?.price ?? 0).toFixed(2)}, confidence {featureTip.recommendation?.confidence}%.</p>
          <div style="display:flex;align-items:center;gap:12px">
            <a href={`/predictions/${matchSlug(featureTip)}`} class="btn btn-mint">Read preview</a>
            <span class="dim" style="font-size:12.5px">AI Betting Tips model · {kickoffLabel(featureTip.kickoff)}</span>
          </div>
        </div>
      </div>
    )}

    <div class="news-grid" style="grid-template-columns:repeat(4,1fr)">
      {cards.map((t, i) => (
        <div class="news-card">
          <div class="news-thumb" style={`--ca:${badgeColor(t.home)};--cb:${badgeColor(t.away)}`}>
            <div class="cover-vs sm">
              <TeamMark team={t.home} sportKey={t.sport_key} />
              <span class="cv-x">v</span>
              <TeamMark team={t.away} sportKey={t.sport_key} />
            </div>
            <span class="tag">{t.league}</span><span class="when">{kickoffLabel(t.kickoff)}</span>
          </div>
          <div class="news-body">
            <h4><a href={`/predictions/${matchSlug(t)}`}>{t.home} vs {t.away}: prediction &amp; best odds</a></h4>
            <div class="nf"><span>{t.recommendation?.text}</span><span class="read">Read →</span></div>
          </div>
        </div>
      ))}
    </div>

  </div>
</Base>
