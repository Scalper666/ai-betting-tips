---
import Base from '../../../layouts/Base.astro';
import PredCard from '../../../components/PredCard.astro';
import predictions from '../../../data/predictions.json';
import historyData from '../../../data/history.json';
import content from '../../../data/content.json';
import AiFaq from '../../../components/AiFaq.astro';
import { slugify, faqSchema } from '../../../lib/utils.js';
import { MATRIX, matrixFilters } from '../../../lib/betTypes.js';

// ── pSEO matrix: bet-type × league combo pages ("Over/Under tips Premier League").
//    Only DATA-BACKED types are emitted, and only combos that actually have
//    current picks or settled history — no thin doorway pages.
//    MATRIX/matrixFilters live in lib/betTypes.js: getStaticPaths is isolated
//    and only sees imports.
export function getStaticPaths() {
  const tips = predictions.tips ?? [];
  const hist = Object.values(historyData.tips ?? {}).filter(
    (h) => h.score !== 'simulated' && !String(h.event_id ?? '').startsWith('mock')
  );
  const leagues = [...new Set([...tips.map((t) => t.league), ...hist.map((h) => h.league)].filter(Boolean))];

  const paths = [];
  for (const m of MATRIX) {
    const f = matrixFilters(m.type);
    for (const league of leagues) {
      const live = tips.filter((t) => t.league === league && f.live(t));
      const past = hist.filter((h) => h.league === league && f.hist(h));
      if (live.length + past.length < 2) continue;   // skip thin combos
      paths.push({
        params: { type: m.type, league: slugify(league) },
        props: { m, league, live, past },
      });
    }
  }
  return paths;
}

const { m, league, live, past } = Astro.props;
const ai = (content.entries ?? {})[`combo:${m.type}:${slugify(league)}`];

const settledStates = ['won', 'lost', 'void'];
const settled = past
  .filter((h) => settledStates.includes(h.status))
  .sort((a, b) => String(b.kickoff ?? '').localeCompare(String(a.kickoff ?? '')));
const stats = {
  tips: live.length + past.length,
  settled: settled.length,
  won: settled.filter((h) => h.status === 'won').length,
  profit: Math.round(settled.reduce((s, h) => s + (h.profit ?? 0), 0) * 100) / 100,
};

// sibling combos that actually exist (same >=2 threshold as getStaticPaths)
const comboExists = (kindKey) => {
  const f = matrixFilters(kindKey);
  const liveN = (predictions.tips ?? []).filter((t) => t.league === league && f.live(t)).length;
  const histN = Object.values(historyData.tips ?? {}).filter(
    (h) => h.score !== 'simulated' && !String(h.event_id ?? '').startsWith('mock') && h.league === league && f.hist(h)
  ).length;
  return liveN + histN >= 2;
};

const liveLeagues = new Set((predictions.tips ?? []).map((t) => slugify(t.league)));
const leagueHref = liveLeagues.has(slugify(league)) ? `/league/${slugify(league)}` : '/predictions';
const typeHub = ['over-under', 'draw'].includes(m.type) ? `/tips/${m.type}` : '/predictions';

const title = `${league} ${m.name} — Free Predictions & Our Record`;
const description = `Free ${m.name.toLowerCase()} for the ${league}: ${m.short} with odds, plus our fully settled record on this market — every tip archived before kick-off.`;

const schema = ai?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(ai.faq) } : null;
---
<Base title={title} description={description} schema={schema} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span>
        <a href={typeHub}>{m.name}</a><span>/</span>
        {league}
      </div>
      <h1>{league} <em>{m.name.toLowerCase()}</em></h1>
      <p class="lead">{m.short} for the {league} — with the same open settlement as everything we publish: archived before kick-off, graded on the final score.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">

        <!-- honest record on this exact market × league -->
        <section>
          <div class="sec-head"><h2 class="sec-title">Our <b>record</b> on this market</h2></div>
          <div class="res-sum">
            <div class="res-chip"><b>{stats.tips}</b><span>Tips</span></div>
            <div class="res-chip"><b>{stats.settled}</b><span>Settled</span></div>
            <div class="res-chip win"><b>{stats.won}</b><span>Won</span></div>
            <div class={`res-chip ${stats.profit > 0 ? 'win' : stats.profit < 0 ? 'lose' : ''}`}>
              <b>{stats.profit > 0 ? '+' : ''}{stats.profit.toFixed(2)}u</b><span>Profit</span>
            </div>
          </div>
          {stats.settled === 0 && (
            <p class="res-note">Nothing on this market has settled yet — results appear here automatically after full time.</p>
          )}
        </section>

        {live.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Current <b>picks</b></h2></div>
            <div class="pred-grid">
              {live.map((tip) => <PredCard tip={tip} />)}
            </div>
          </section>
        )}

        {settled.length > 0 && (
          <section>
            <div class="sec-head"><h2 class="sec-title">Settled <b>tips</b></h2></div>
            <div class="res-list">
              {settled.slice(0, 12).map((h) => (
                <a class="res-row" href={`/predictions/${slugify(`${h.home}-vs-${h.away}`)}`} style="text-decoration:none;color:inherit">
                  <span class={`res-mark ${h.status === 'won' ? 'w' : h.status === 'lost' ? 'l' : 'v'}`}>{h.status === 'won' ? 'W' : h.status === 'lost' ? 'L' : 'V'}</span>
                  <span class="res-date">{h.kickoff ? new Date(h.kickoff).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : ''}</span>
                  <div class="res-match"><b>{h.home} v {h.away}</b><span>{h.market}{h.score && h.score !== 'simulated' ? ` · ${h.score}` : ''}</span></div>
                  <span class="res-odds">{Number(h.odds ?? 0).toFixed(2)}</span>
                  <span class={`res-profit ${(h.profit ?? 0) > 0 ? 'pos' : (h.profit ?? 0) < 0 ? 'neg' : 'zero'}`}>{(h.profit ?? 0) > 0 ? '+' : ''}{Number(h.profit ?? 0).toFixed(2)}u</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {ai?.intro && (
          <section class="seo">
            <h2>Betting on {m.name.toLowerCase().replace(' tips', '')} in the {league}</h2>
            <p>{ai.intro}</p>
          </section>
        )}

        <AiFaq faqs={ai?.faq ?? []} title={`${league} ${m.name} FAQ`} />
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🔍 AI Screener</h4>
          <p>All value picks across every market, ranked by AI score.</p>
          <a href="/screener" class="btn btn-mint btn-block">Open screener</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">🏆</span> This league</div>
          <a class="tm" href={leagueHref}><span class="dot"></span>All {league} tips</a>
          {MATRIX.filter((x) => x.type !== m.type && comboExists(x.type)).map((x) => (
            <a class="tm" href={`/tips/${x.type}/${slugify(league)}`}><span class="dot"></span>{league} {x.name.toLowerCase()}</a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>
