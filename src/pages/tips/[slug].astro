---
import TipsTypeView from '../../views/TipsTypeView.astro';
import { BET_TYPES } from '../../lib/betTypes.js';

export function getStaticPaths() {
  return BET_TYPES.map((t) => ({ params: { slug: t.slug }, props: { type: t } }));
}
const { type } = Astro.props;
---
<TipsTypeView lang="en" type={type} />
