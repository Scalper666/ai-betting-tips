---
import Base from '../../layouts/Base.astro';
import PredCard from '../../components/PredCard.astro';
import predictions from '../../data/predictions.json';
import { slugify } from '../../lib/utils.js';

// One SEO page per bet type — same pattern as leagues and matches.
import { BET_TYPES } from '../../lib/betTypes.js';

export function getStaticPaths() {
  return BET_TYPES.map((t) => ({ params: { slug: t.slug }, props: { type: t } }));
}

const { type } = Astro.props;
const tips = (predictions.tips ?? []).filter((t) => String(t.sport_key ?? '').startsWith('soccer')).slice(0, 6);
const leagues = [...new Set(tips.map((t) => t.league))];
---
<Base
  title={`${type.name} — Free Football Betting Tips — AI Betting Tips`}
  description={`Free ${type.name.toLowerCase()} for football: expert ${type.short} predictions with odds, analysis and a confidence rating.`}
  active="predictions">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span><a href="/predictions">Predictions</a><span>/</span>{type.name}</div>
      <h1>{type.emoji} {type.name}</h1>
      <p class="lead">Free expert {type.name.toLowerCase()} for football — {type.long}, each with the best available odds and a confidence rating.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="chips">
            <span class="chip active">⚡ All leagues</span>
            {leagues.map((lg) => <a class="chip" href={`/league/${slugify(lg)}`}>🏆 {lg}</a>)}
          </div>
          <div class="pred-grid">
            {tips.map((tip) => <PredCard tip={tip} />)}
          </div>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">{type.name} <b>FAQ</b></h2></div>
          <div class="faq">
            <div class="faq-item open">
              <div class="faq-q">What are {type.name.toLowerCase()}?<span class="pm">+</span></div>
              <div class="faq-a"><p>These are {type.long}. We publish them daily across the major leagues with full reasoning.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">Are these tips free?<span class="pm">+</span></div>
              <div class="faq-a"><p>Yes — every tip and prediction on AI Betting Tips is completely free, with the reasoning and a confidence rating included.</p></div>
            </div>
            <div class="faq-item">
              <div class="faq-q">When are tips published?<span class="pm">+</span></div>
              <div class="faq-a"><p>Daily tips go live each morning and all selections are posted before kick-off.</p></div>
            </div>
          </div>
        </section>

        <section class="seo">
          <h2>{type.name} explained</h2>
          <div class="clamp" id="seoClamp">
            <p>Our {type.name.toLowerCase()} focus on {type.short} markets where we believe the odds offer genuine value, rather than simply backing the obvious favourite.</p>
            <p>Every tip is archived and settled automatically for full transparency. Treat our tips as statistical opinions, stake sensibly and never chase losses. You must be 18+.</p>
          </div>
          <span class="read-more" data-clamp-toggle="seoClamp">Read more ▾</span>
        </section>
      </main>

      <aside class="sidebar">
        <div class="promo">
          <h4>🔍 AI Screener</h4>
          <p>All value picks across every market, ranked by AI score.</p>
          <a href="/screener" class="btn btn-mint btn-block">Open screener</a>
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> More bet types</div>
          {BET_TYPES.filter((t) => t.slug !== type.slug).map((t) => (
            <a class="tm" href={`/tips/${t.slug}`}><span class="dot"></span>{t.emoji} {t.name}</a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>
