---
import Base from '../../layouts/Base.astro';
import PredCard from '../../components/PredCard.astro';
import ToolsBox from '../../components/ToolsBox.astro';
import fdData from '../../data/football-data.json';
import predictions from '../../data/predictions.json';
import seasonsData from '../../data/seasons.json';
import { slugify, faqSchema, BUILD_ISO, fmtDate } from '../../lib/utils.js';
import { leagueName } from '../../lib/leagues.js';
import { hasTeamPage, hasH2hHub, hasTeamsHub, hasLeaguePage } from '../../lib/links.js';

// ── League tables: standings straight from the football-data snapshot the
//    pipeline refreshes twice a day. One page per covered league, named with
//    the same slug as /league/{slug} so the two interlink cleanly.
//    Between seasons the snapshot holds the completed season's final table —
//    the page says so rather than passing it off as live.
export function getStaticPaths() {
  return Object.entries(fdData.leagues ?? {})
    // a table where nobody has played yet is noise, not content — those
    // leagues get a page once the first round is in the snapshot
    .filter(([, lg]) => (lg.standings ?? []).some((r) => (r.p ?? 0) > 0))
    .map(([sk, lg]) => {
      const name = leagueName(sk, lg.name);
      return { params: { slug: slugify(name) }, props: { sk, lg, name } };
    });
}

const { sk, lg, name } = Astro.props;
const rows = lg.standings ?? [];

// Is this a live table or last season's final one? Two signals, because the
// round-robin test alone misreads formats like the 36-club UEFA league phase:
//   1) every club on the full round-robin fixture count, or
//   2) no result in the snapshot for three weeks (off-season / winter break).
const maxPlayed = (rows.length - 1) * 2;
const lastResult = (lg.results ?? []).reduce((a, r) => (r.d > a ? r.d : a), '');
const daysSince = lastResult
  ? Math.floor((Date.now() - new Date(`${lastResult}T00:00:00Z`).getTime()) / 864e5)
  : 999;
const completed = rows.length > 0 &&
  (rows.every((r) => (r.p ?? 0) >= maxPlayed) || daysSince > 21);
const played = rows.reduce((a, r) => a + (r.p ?? 0), 0);
const scorers = lg.scorers ?? [];

const upcoming = (predictions.tips ?? [])
  .filter((t) => t.sport_key === sk)
  .sort((a, b) => String(a.kickoff).localeCompare(String(b.kickoff)))
  .slice(0, 4);

const season = (seasonsData.seasons ?? []).find((s) => s.sport_key === sk) ?? null;
const others = Object.entries(fdData.leagues ?? {})
  .filter(([k, l]) => k !== sk && (l.standings ?? []).some((r) => (r.p ?? 0) > 0));

const title = completed
  ? `${name} Table — Final Standings and What They Mean for Betting`
  : `${name} Table — Live Standings, Form and Betting Context`;
const description = completed
  ? `${name} final league table: position, played, won, drawn, lost, goal difference and points for all ${rows.length} clubs — plus how table position actually feeds into match prices.`
  : `Live ${name} table with all ${rows.length} clubs, refreshed twice daily, alongside our model's upcoming fixtures and predictions for the league.`;

const faq = [
  {
    q: `How often is this ${name} table updated?`,
    a: 'The standings snapshot is refreshed twice a day by the same automated pipeline that prices fixtures, so the table reflects results as soon as the data source publishes them.',
  },
  {
    q: 'Does league position predict match results?',
    a: 'Only loosely. Position summarises what already happened, including luck; our model instead uses each club\'s scoring and conceding rates with recent matches weighted more heavily. Two clubs level on points can carry very different underlying rates — and very different fair odds.',
  },
  {
    q: 'Why do the numbers differ from other sites?',
    a: 'Different sources update at different moments, and some apply points deductions on a delay. This table comes from a football-data snapshot taken at the last rebuild; the timestamp on this page tells you exactly when.',
  },
];
const schema = { '@context': 'https://schema.org', ...faqSchema(faq) };
---
<Base title={title} description={description} schema={schema} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs">
        <a href="/">Home</a><span>/</span><a href="/predictions">Predictions</a><span>/</span>{name} table
      </div>
      <h1>{name} <em>table</em></h1>
      <p class="lead">
        {completed
          ? `Final standings from the last completed ${name} season — ${rows.length} clubs, ${played} club-matches played. The new season's table starts filling with the first round of results.`
          : `Current ${name} standings across ${rows.length} clubs, refreshed twice a day alongside our odds data.`}
      </p>
      <p class="upd-line">Snapshot taken {fmtDate(BUILD_ISO)} · <a href="/editorial-policy">how we work</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">{completed ? 'Final' : 'Current'} <b>{name} standings</b></h2>
            {hasLeaguePage(name) && <a href={`/league/${slugify(name)}`} class="more-link">League tips →</a>}
          </div>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <thead><tr><th>#</th><th style="text-align:left">Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>Pts</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td class="o-cell"><span>{r.pos}</span></td>
                    <td class="o-match" style="font-weight:700">
                      {hasTeamPage(r.team)
                        ? <a href={`/team/${slugify(r.team)}`} style="color:inherit">{r.team}</a>
                        : r.team}
                    </td>
                    <td class="o-cell"><span>{r.p}</span></td>
                    <td class="o-cell"><span>{r.w}</span></td>
                    <td class="o-cell"><span>{r.d}</span></td>
                    <td class="o-cell"><span>{r.l}</span></td>
                    <td class="o-cell"><span>{r.gd > 0 ? `+${r.gd}` : r.gd}</span></td>
                    <td class="o-cell hot"><span class="cb">{r.pts}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div></div>
        </section>

        {scorers.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">{name} <b>top scorers</b></h2>
              <a href={`/top-scorers/${slugify(name)}`} class="more-link">Full list →</a>
            </div>
            <div class="res-list">
              {scorers.slice(0, 5).map((p, i) => (
                <div class="res-row">
                  <span class="res-mark v">{i + 1}</span>
                  <div class="res-match"><b>{p.name}</b><span>{p.team}</span></div>
                  <span class="res-odds">{p.played ?? '—'} apps</span>
                  <span class="res-profit pos">{p.goals} goals</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {upcoming.length > 0 && (
          <section>
            <div class="sec-head">
              <h2 class="sec-title">Next <b>{name} fixtures</b></h2>
              <a href={`/league/${slugify(name)}`} class="more-link">All fixtures →</a>
            </div>
            <div class="pred-grid">
              {upcoming.map((tip) => <PredCard tip={tip} lang="en" />)}
            </div>
          </section>
        )}

        <section class="seo">
          <h2>Reading the {name} table like a bettor</h2>
          <p>A league table is a record of what happened, not a forecast. It bundles together deserved wins, lucky deflections and refereeing calls into one number, which is why two clubs level on points can be priced very differently — and correctly so. The market looks past the table at squad quality, underlying chance creation and schedule; so does our model, which rates each club on time-decayed scoring and conceding rates rather than league position.</p>
          <p>Where the table genuinely helps is context the model cannot see: what a club is playing <em>for</em>. A side safe in mid-table in May behaves differently from one three points above the relegation line, and that motivation gap shows up in effort, rotation and game state long before it shows up in ratings. Use the standings for that, use prices for probability, and treat any narrative built purely on position with suspicion.</p>
          <p>Goal difference deserves a second look too. A club sitting eighth with a strongly positive difference has usually been better than its points suggest — it lost the tight games. Over a longer sample those results tend to regress toward the underlying performance, which is exactly the sort of gap value betting is built to find.</p>
        </section>

        <section>
          <div class="sec-head"><h2 class="sec-title">{name} table <b>FAQ</b></h2></div>
          <div class="prose" style="padding:0;max-width:none">
            {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
          </div>
        </section>
      </main>

      <aside class="sidebar">
        {season && (
          <div class="promo">
            <h4>📅 {name} {season.season}</h4>
            <p>{season.window}</p>
            <a href={`/seasons/${season.slug}`} class="btn btn-mint btn-block">Season hub</a>
          </div>
        )}
        <div class="box">
          <div class="box-h"><span class="hi">⚽</span> {name} pages</div>
          {hasLeaguePage(name) && <a class="tm" href={`/league/${slugify(name)}`}><span class="dot"></span>Predictions &amp; tips</a>}
          <a class="tm" href="/predictions/today"><span class="dot"></span>Today's fixtures</a>
          <a class="tm" href="/screener"><span class="dot"></span>AI value screener</a>
          {hasH2hHub(name) && <a class="tm" href={`/h2h/league/${slugify(name)}`}><span class="dot"></span>{name} H2H records</a>}
          {hasTeamsHub(name) && <a class="tm" href={`/teams/${slugify(name)}`}><span class="dot"></span>{name} clubs</a>}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">📊</span> Other tables</div>
          {others.map(([k, l]) => (
            <a class="tm" href={`/table/${slugify(leagueName(k, l.name))}`}>
              <span class="dot"></span>{leagueName(k, l.name)}
            </a>
          ))}
        </div>
        <ToolsBox lang="en" />
      </aside>
    </div>
  </div>
</Base>
