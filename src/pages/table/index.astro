---
import Base from '../../layouts/Base.astro';
import fdData from '../../data/football-data.json';
import predictions from '../../data/predictions.json';
import { slugify, BUILD_ISO, fmtDate } from '../../lib/utils.js';
import { leagueName } from '../../lib/leagues.js';

const tables = Object.entries(fdData.leagues ?? {})
  .filter(([, lg]) => (lg.standings ?? []).some((r) => (r.p ?? 0) > 0))
  .map(([sk, lg]) => ({
    sk,
    name: leagueName(sk, lg.name),
    rows: lg.standings,
    leader: lg.standings[0],
    clubs: lg.standings.length,
  }));

const title = 'Football League Tables — Standings for Every League We Cover';
const description = 'League tables for the Premier League, La Liga, Serie A, Bundesliga, Ligue 1, Championship, Eredivisie, Primeira Liga and Brasileirão — refreshed twice daily next to our model predictions.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Football league tables',
  itemListElement: tables.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${t.name} table`,
    url: `https://ai-betting-tips.com/table/${slugify(t.name)}/`,
  })),
};
---
<Base title={title} description={description} schema={schema} updated={BUILD_ISO} active="predictions">
  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span>Tables</div>
      <h1>League <em>tables</em></h1>
      <p class="lead">Standings for every league our model rates, taken from the same data snapshot that feeds the predictions and refreshed twice a day. Each table sits next to that league's fixtures, so you can go from position to price in one click.</p>
      <p class="upd-line">Snapshot taken {fmtDate(BUILD_ISO)} · <a href="/editorial-policy">how we work</a></p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="sec-head">
            <h2 class="sec-title">Tables <b>we track</b></h2>
            <a href="/predictions" class="more-link">All predictions →</a>
          </div>
          <div class="bt-grid">
            {tables.map((t) => (
              <a href={`/table/${slugify(t.name)}`} class="bt-tile">
                <div class="ic">📊</div>
                <div>
                  <h4>{t.name} table</h4>
                  <p>{t.clubs} clubs · top: {t.leader.team} ({t.leader.pts} pts)</p>
                </div>
                <span class="arr">→</span>
              </a>
            ))}
          </div>
        </section>

        <section class="seo">
          <h2>Tables tell you what happened — prices tell you what's next</h2>
          <p>Standings are the most-read page in football and the most over-read in betting. Position aggregates months of results, luck included, and says nothing directly about the next ninety minutes. Our model deliberately ignores it, rating clubs on time-decayed scoring and conceding rates instead, then comparing the resulting fair odds against the best price available.</p>
          <p>Where tables earn their keep is context: promotion pushes, relegation fear, dead rubbers in May. That is information about motivation, which no rate-based model can see — and one of the honest limits we publish on our <a href="/model">model page</a>. Read the table for the story, read the price for the probability.</p>
        </section>
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📊</span> All tables</div>
          {tables.map((t) => (
            <a class="tm" href={`/table/${slugify(t.name)}`}><span class="dot"></span>{t.name}</a>
          ))}
        </div>
        <div class="box">
          <div class="box-h"><span class="hi">⚡</span> Live pages</div>
          <a class="tm" href="/seasons"><span class="dot"></span>Season hubs</a>
          <a class="tm" href="/predictions/today"><span class="dot"></span>Today's predictions</a>
          <a class="tm" href="/screener"><span class="dot"></span>AI value screener</a>
          <a class="tm" href="/guides"><span class="dot"></span>Betting guides</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
