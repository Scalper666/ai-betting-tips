---
// Also generated from bookmakers.json — the `app` field on each operator.
import Base from '../../layouts/Base.astro';
import content from '../../data/content.json';
import AiFaq from '../../components/AiFaq.astro';
import data from '../../data/bookmakers.json';
import { avgScore, faqSchema } from '../../lib/utils.js';

const apps = (data.bookmakers ?? [])
  .filter((bk) => bk.app && (bk.app.android || bk.app.ios))
  .sort((a, b) => (b.app.rating ?? 0) - (a.app.rating ?? 0));
const year = new Date().getFullYear();

const aiPage = (content.entries ?? {})['page:betting-apps'];
const pageSchema = aiPage?.faq?.length ? { '@context': 'https://schema.org', ...faqSchema(aiPage.faq) } : null;
---
<Base schema={pageSchema}
  title={`Best Betting Apps ${year} — Android & iOS Compared`}
  description="Mobile betting apps compared on platforms, size, live streaming and in-app offers — pulled from our full bookmaker reviews."
  active="bookmakers">

  <div class="container">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a><span>/</span><a href="/bookmakers">Betting Sites</a><span>/</span>Apps</div>
      <h1>Best <em>betting apps</em></h1>
      <p class="lead">Platform support, download size and streaming for every operator we rate. Scores come from the same testing as the full reviews.</p>
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <main class="content">
        <section>
          <div class="odds-table"><div class="scr-scroll">
            <table class="otbl">
              <thead><tr>
                <th style="text-align:left">App</th><th>Platforms</th><th>Size</th>
                <th>Streaming</th><th>App score</th><th>Get</th>
              </tr></thead>
              <tbody>
                {apps.map((bk) => (
                  <tr>
                    <td class="o-match" style="font-weight:700">
                      <a href={`/bookmakers/${bk.slug}`} style="color:inherit">{bk.name}</a>
                      {bk.placeholder && <span class="tc" style="display:block;color:var(--danger)">demo entry</span>}
                    </td>
                    <td class="o-cell"><b>{[bk.app.android && '🤖 Android', bk.app.ios && '🍏 iOS'].filter(Boolean).join(' · ')}</b></td>
                    <td class="o-cell"><b>{bk.app.size_mb} MB</b></td>
                    <td class="o-cell"><b>{bk.app.streaming ? 'Yes' : '—'}</b></td>
                    <td class="o-cell hot"><b>{bk.app.rating}</b></td>
                    <td><a href={bk.affiliate_url} class="btn btn-mint btn-sm" rel="nofollow sponsored" target="_blank">Download</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div></div>
        </section>

        <section class="seo">
          <h2>App vs mobile site</h2>
          <p>A native app is usually faster and adds push notifications and streaming; the mobile site needs no install and saves storage. Our reviews flag which operators genuinely have a better app and which are fine in the browser.</p>
        </section>
        {aiPage?.intro && (
          <section class="seo">
            <h2>About betting apps</h2>
            <p>{aiPage.intro}</p>
          </section>
        )}
        <AiFaq faqs={aiPage?.faq ?? []} title="Betting apps FAQ" />
      </main>

      <aside class="sidebar">
        <div class="box">
          <div class="box-h"><span class="hi">📱</span> Reviews</div>
          {apps.map((bk) => (
            <a class="tm" href={`/bookmakers/${bk.slug}`}><span class="dot"></span>{bk.name} review</a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>
